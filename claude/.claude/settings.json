{
  "cleanupPeriodDays": 365,
  "syncClaudeAiSkills": false,
  "skillListingBudgetFraction": 0.025,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "deny": [
      "ReportFindings"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "artifact-capabilities": "name-only",
    "artifact-design": "name-only",
    "artifact-diagramming": "name-only",
    "claude-in-chrome": "name-only",
    "dataviz": "name-only",
    "fewer-permission-prompts": "name-only",
    "init": "name-only",
    "keybindings-help": "name-only",
    "loop": "name-only",
    "plugin-authoring": "name-only",
    "run": "name-only",
    "schedule": "name-only",
    "security-review": "name-only",
    "simplify": "name-only",
    "workflow-authoring": "name-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/session-start-git-safe-dirs.sh"
          },
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/session-start-worktree-sweep.sh"
          },
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/session-start-memory.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/stop-bell"
          },
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-notify"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-question"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/session-end-claude-sync.sh"
          },
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-notify"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-question"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // empty'); case \"$file\" in */.claude/projects/*/memory/*) echo 'BLOCKED: auto-memory path. For curated session memory use /workspace/.claude/scripts/memory log \"<text>\" (or park/recall). See the session-memory skill.' >&2; exit 2;; esac; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/.claude/hooks/block-jira-direct-api.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-question"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/post-edit-autocomplete-check.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-notify",
            "async": true
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-question"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-notify"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-notify"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-question"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-notify"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-question"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-notify",
            "async": true
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/claude-question"
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "~/dotfiles/bin/claude-statusline /opt/ccline/ccline"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "finance@synced": false,
    "code-review@claude-plugins-official": true,
    "leonardo@leonardo-skills": true,
    "aiup-core@ai-unified-process-marketplace": false,
    "aiup-vaadin-jooq@ai-unified-process-marketplace": false,
    "jdtls-lsp@claude-plugins-official": true,
    "vaadin-skills@vaadin-marketplace": false,
    "kicad-happy@skills-dir": true,
    "pat@skills-dir": true,
    "pstack@skills-dir": true
  },
  "extraKnownMarketplaces": {
    "leonardo-skills": {
      "source": {
        "source": "git",
        "url": "git@gitlab.leonardo.local:leonardo-developers/leonardo-ai.git"
      },
      "autoUpdate": true
    },
    "ai-unified-process-marketplace": {
      "source": {
        "source": "git",
        "url": "git@github.com:AI-Unified-Process/marketplace.git"
      }
    },
    "vaadin-marketplace": {
      "source": {
        "source": "github",
        "repo": "vaadin/agent-marketplace"
      },
      "autoUpdate": true
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-2": {
      "effortLevel": "xhigh"
    }
  },
  "autoCompactWindow": 300000,
  "advisorModel": "fable",
  "tui": "default",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "claudeMdExcludes": [
    "/home/opencode/.claude/CLAUDE.md"
  ],
  "theme": "dark",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": false
}

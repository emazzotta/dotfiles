{
  "cleanupPeriodDays": 365,
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/session-start-git-safe-dirs.sh"
          },
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/session-start-worktree-sweep.sh"
          },
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/session-start-memory.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/dotfiles/bin/stop-bell"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/session-end-claude-sync.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/user-prompt-session-topic.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // empty'); case \"$file\" in */.claude/projects/*/memory/*) echo 'BLOCKED: auto-memory path. For curated session memory use /workspace/.claude/scripts/memory log \"<text>\" (or park/recall). See Session Memory in CLAUDE.md.' >&2; exit 2;; esac; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/home/opencode/.claude/hooks/block-jira-direct-api.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/post-edit-sync-guidelines-check.sh"
          },
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/post-edit-autocomplete-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/post-tool-commit-observer.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/opt/ccline/ccline"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "leonardo@leonardo-skills": true,
    "aiup-core@ai-unified-process-marketplace": true,
    "aiup-vaadin-jooq@ai-unified-process-marketplace": true,
    "jdtls-lsp@claude-plugins-official": true,
    "vaadin-skills@vaadin-marketplace": true
  },
  "extraKnownMarketplaces": {
    "leonardo-skills": {
      "source": {
        "source": "git",
        "url": "git@gitlab.leonardo.local:leonardo-developers/leonardo-ai.git"
      },
      "autoUpdate": true
    },
    "ai-unified-process-marketplace": {
      "source": {
        "source": "git",
        "url": "git@github.com:AI-Unified-Process/marketplace.git"
      }
    },
    "vaadin-marketplace": {
      "source": {
        "source": "github",
        "repo": "vaadin/agent-marketplace"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}

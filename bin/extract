#!/bin/bash

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/shelllog.sh"

ARCHIVE_EXTENSIONS=(tar.bz2 tar.gz tar.xz bz2 rar gz tar tbz2 tgz zip Z 7z xz exe msi pkg deb rpm dmg iso cab)

show_usage() {
    log "usage: $(basename "${0}") [file]"
    log "no file: the single archive in the current directory, or a picker among several"
}

if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
    show_usage
    exit 0
fi

archive="${1:-}"
if [ -z "${archive}" ]; then
    archive="$(pickfile --header "Select archive:" "${ARCHIVE_EXTENSIONS[@]}")" || exit 1
fi

if [ ! -f "${archive}" ]; then
    error "'${archive}' is not a valid file/option!"
    show_usage
    exit 1
fi

log "archive to decompress: ${archive}"
case "${archive}" in
    *.tar.bz2) tar xvjf "${archive}" ;;
    *.tar.gz) tar xvzf "${archive}" ;;
    *.tar.xz) tar xvJf "${archive}" ;;
    *.bz2) bunzip2 "${archive}" ;;
    *.rar) rar x "${archive}" ;;
    *.gz) gunzip "${archive}" ;;
    *.tar) tar xvf "${archive}" ;;
    *.tbz2) tar xvjf "${archive}" ;;
    *.tgz) tar xvzf "${archive}" ;;
    *.zip) unzip "${archive}" ;;
    *.Z) uncompress "${archive}" ;;
    *.7z) 7z x "${archive}" ;;
    *.xz) unxz "${archive}" ;;
    *.exe) 7z x "${archive}" ;;
    *.msi) 7z x "${archive}" ;;
    *.pkg) 7z x "${archive}" ;;
    *.deb) w x "${archive}" ;;
    *.rpm) rpm2cpio "${archive}" | cpio -idmv ;;
    *.dmg) 7z x "${archive}" ;;
    *.iso) 7z x "${archive}" ;;
    *.cab) cabextract "${archive}" ;;
    *) error "don't know '${archive}'..." ;;
esac

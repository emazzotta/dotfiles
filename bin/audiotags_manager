#!/usr/bin/env python3
from __future__ import annotations


import argparse
import base64
import logging
import os
import re
import subprocess
import unicodedata
from collections.abc import Callable
from dataclasses import dataclass
from datetime import datetime, timedelta
from difflib import SequenceMatcher
from enum import Enum
from itertools import chain
from pathlib import Path
from typing import Final

import music_tag
import requests
from PIL import UnidentifiedImageError

logger = logging.getLogger(__name__)
logging.basicConfig(level=logging.WARNING)

TRACKS_PATH = os.environ.get('DJ_TRACKS')
SPOTIFY_ENV_VARS: Final[tuple[str, ...]] = ('SPOTIFY_CLIENT_ID', 'SPOTIFY_CLIENT_SECRET')
WHERE_FROM_ATTRIBUTE: Final = 'com.apple.metadata:kMDItemWhereFroms'

HTTP_TIMEOUT: Final = 20
SEARCH_LIMIT: Final = 8
SPOTIFY_TOKEN_URL: Final = 'https://accounts.spotify.com/api/token'
SPOTIFY_SEARCH_URL: Final = 'https://api.spotify.com/v1/search'
SOUNDCLOUD_HOME_URL: Final = 'https://soundcloud.com/'
SOUNDCLOUD_SEARCH_URL: Final = 'https://api-v2.soundcloud.com/search/tracks'
SOUNDCLOUD_ARTWORK_SIZE: Final = 't500x500'
BROWSER_USER_AGENT: Final = 'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)'
SOUNDCLOUD_HEADERS: Final[dict[str, str]] = {'User-Agent': BROWSER_USER_AGENT}
CLIENT_ID_CACHE_PATH: Final = Path(
    os.environ.get('XDG_CACHE_HOME') or Path.home() / '.cache'
) / 'audiotags_manager' / 'soundcloud_client_id'
CLIENT_ID_CACHE_TTL: Final = timedelta(hours=12)

TITLE_WEIGHT: Final = 0.65
ARTIST_WEIGHT: Final = 0.35
MIN_MATCH_SCORE: Final = 0.55

TITLE_SEPARATORS: Final[tuple[str, ...]] = (' - ', ' – ', ' — ')
TRACK_NUMBER_PREFIX_PATTERN: Final[re.Pattern[str]] = re.compile(r'^\d{1,3}\s*[-._)\]]\s*')
SOUNDCLOUD_ASSET_PATTERN: Final[re.Pattern[str]] = re.compile(
    r'https://a-v2\.sndcdn\.com/assets/[\w.-]+\.js'
)
SOUNDCLOUD_CLIENT_ID_PATTERN: Final[re.Pattern[str]] = re.compile(r'client_id[:=]"(\w{32})"')
SOUNDCLOUD_ARTWORK_SIZE_PATTERN: Final[re.Pattern[str]] = re.compile(r'-large\.')
MATCH_NOISE_PATTERN: Final[re.Pattern[str]] = re.compile(
    r'\b(?:free\s+(?:download|dl)|download|out\s+now|premiere|exclusive|'
    r'original\s+(?:mix|version)|extended\s+(?:mix|version)|radio\s+edit|'
    r'remastered|remaster|teaser|snippet|preview)\b'
)
FEATURING_TOKEN_PATTERN: Final[re.Pattern[str]] = re.compile(r'\b(?:feat|ft|featuring)\b\.?')
NON_ALPHANUMERIC_PATTERN: Final[re.Pattern[str]] = re.compile(r'[^a-z0-9]+')


def load_env_via_envify(vars: tuple[str, ...]) -> None:
    vars_str = ' '.join(vars)
    echo_cmds = ' && '.join(f'echo "{v}=${{{v}}}"' for v in vars)
    result = subprocess.run(
        ['bash', '-c', f'source envify {vars_str} && {echo_cmds}'],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or 'envify failed with no output')
    for line in result.stdout.splitlines():
        if '=' in line:
            key, _, value = line.partition('=')
            if key in vars:
                os.environ[key] = value


def ensure_spotify_creds() -> None:
    if any(not os.getenv(v) for v in SPOTIFY_ENV_VARS):
        load_env_via_envify(SPOTIFY_ENV_VARS)
    still_missing = [v for v in SPOTIFY_ENV_VARS if not os.getenv(v)]
    if still_missing:
        raise RuntimeError(f"Spotify credentials missing after envify: {', '.join(still_missing)}")


class Tags(Enum):
    ALBUM = 'album'
    ALBUMARTIST = 'albumartist'
    ARTIST = 'artist'
    ARTWORK = 'artwork'
    COMMENT = 'comment'
    COMPILATION = 'compilation'
    COMPOSER = 'composer'
    DISCNUMBER = 'discnumber'
    GENRE = 'genre'
    ISRC = 'isrc'
    LYRICS = 'lyrics'
    TOTALDISCS = 'totaldiscs'
    TOTALTRACKS = 'totaltracks'
    TRACKNUMBER = 'tracknumber'
    TRACKTITLE = 'tracktitle'
    YEAR = 'year'


STRING_TAGS: Final[frozenset[str]] = frozenset({
    Tags.ALBUM.value, Tags.ALBUMARTIST.value, Tags.ARTIST.value,
    Tags.COMMENT.value, Tags.COMPOSER.value, Tags.GENRE.value,
    Tags.ISRC.value, Tags.LYRICS.value, Tags.TRACKTITLE.value,
})


class CoverSource(Enum):
    SPOTIFY = 'spotify'
    SOUNDCLOUD = 'soundcloud'


SOURCE_PREFERENCE: Final[dict[CoverSource, int]] = {
    CoverSource.SPOTIFY: 0,
    CoverSource.SOUNDCLOUD: 1,
}


class CoverLookupError(RuntimeError):
    pass


@dataclass(frozen=True)
class CoverCandidate:
    source: CoverSource
    artist: str
    title: str
    image_url: str


@dataclass(frozen=True)
class ScoredCover:
    candidate: CoverCandidate
    score: float


def main():
    parser = argparse.ArgumentParser(description='Perform audio tags operations')
    parser.add_argument('--autofix', action='store_true', help='Autofix needs no additional parameters')
    parser.add_argument(
        '--copy-tag',
        nargs=2,
        metavar=('SRC', 'DEST'),
        help='Copy tag needs a source and destination file'
    )
    parser.add_argument(
        '--rename-by-tag',
        help='Rename by tag just needs a source file',
        nargs=1,
        metavar='SRC'
    )
    parser.add_argument(
        '--full-tag-optimizer',
        help='Full tag optimizer option needs a source file',
        nargs=1,
        metavar='SRC'
    )

    args = parser.parse_args()

    if args.autofix:
        autofix()
    elif args.copy_tag:
        src, dest = args.copy_tag
        copy_tag(src, dest)
    elif args.rename_by_tag:
        src, = args.rename_by_tag
        rename_by_tag(src)
    elif args.full_tag_optimizer:
        src, = args.full_tag_optimizer
        full_tag_optimizer(src)
    else:
        print("Please provide valid parameters.")


def autofix():
    for src in chain(
            Path(TRACKS_PATH).glob('**/*.mp3'),
            Path(TRACKS_PATH).glob('**/*.flac'),
            Path(TRACKS_PATH).glob('**/*.wav')):
        if src.name.startswith("._"):
            continue
        logger.info(f"[AUTOFIX] Processing {src}")
        track_metadata = music_tag.load_file(src)
        set_missing_metadata_from_filename(src, track_metadata)
        clean_all_tags(track_metadata)
        track_metadata.save()
        rename_by_tag(src)


def copy_tag(src, dest):
    if not os.path.exists(src):
        print(f"Source file {src} does not exist.")
        return
    if not os.path.exists(dest):
        print(f"Destination file {dest} does not exist.")
        return

    logger.info(f"[COPY_TAG] Processing {src} / {dest}")
    source_track_metadata = music_tag.load_file(src)
    destination_track_metadata = music_tag.load_file(dest)
    copy_metadata(source_track_metadata, destination_track_metadata)
    destination_track_metadata.save()
    print(f"Copied metadata from {src} to {dest}")


def rename_by_tag(src):
    if not os.path.exists(src):
        print(f"Source file {src} does not exist.")
        return

    logger.info(f"[RENAME_BY_TAG] Processing {src}")
    source_track_metadata = music_tag.load_file(src)
    source_path = to_path(src)
    if not has_renameable_tags(source_track_metadata):
        print(f"Keeping filename [{source_path.name}], artist or title tag is empty")
        return

    filename = compose_filename(source_track_metadata)
    if source_path.stem == filename:
        return
    destination = Path(source_path.parent, f'{filename}{source_path.suffix}')
    if would_overwrite_another_file(source_path, destination):
        print(f"Keeping filename [{source_path.name}], [{destination.name}] already exists")
        return
    source_path.rename(destination)
    print(f"Renamed via metadata from [{src}] to [{filename}]")


def would_overwrite_another_file(source_path: Path, destination: Path) -> bool:
    if not destination.exists():
        return False
    return not destination.samefile(source_path)


def has_renameable_tags(track_metadata) -> bool:
    return bool(
        read_tag(track_metadata, Tags.ARTIST) and read_tag(track_metadata, Tags.TRACKTITLE)
    )


def full_tag_optimizer(src):
    if not os.path.exists(src):
        print(f"Source file {src} does not exist.")
        return

    logger.info(f"[FULL_TAG_OPTIMIZER] Processing {src}")
    track_metadata = music_tag.load_file(src)
    set_missing_metadata_from_filename(src, track_metadata)
    clean_all_tags(track_metadata)
    if not track_metadata[Tags.ARTWORK.value].first:
        download_and_set_cover_photo(track_metadata)
    track_metadata.save()
    remove_where_from(src)
    rename_by_tag(src)


def compose_filename(metadata):
    return normalize_special_characters(f"{metadata[Tags.ARTIST.value]} - {metadata[Tags.TRACKTITLE.value]}")


def normalize_special_characters(new_track_name):
    normalized = new_track_name.replace("€", "E")
    normalized = unicodedata.normalize('NFD', normalized).encode('ASCII', 'ignore').decode()
    normalized = normalized.replace("/", "_")
    normalized = normalized.replace("?", "...")
    if new_track_name != normalized:
        logger.warning(f'Normalized track name: {new_track_name} => {normalized}')
    return normalized


def copy_metadata(destination, source):
    for tag in [tag.value for tag in Tags]:
        try:
            destination[tag] = source[tag]
        except ValueError:
            pass


def clean_all_tags(track_metadata):
    for tag in STRING_TAGS:
        try:
            value = track_metadata[tag].first
            if value:
                cleaned = clean_string(tag_value=value, tag_name=tag)
                if cleaned:
                    track_metadata[tag] = cleaned
        except (ValueError, UnidentifiedImageError) as e:
            logger.warning(f"Error processing tag {tag}: {str(e)}")


def clean_string(tag_value, tag_name=None):
    line = tag_value

    if tag_name == "artist":
        while re.search(r'(\w+)/(\w+)', line):
            line = re.sub(r'(\w+)/(\w+)', r'\1, \2', line)

    line = re.sub(r'https?://[^\s]+|www\.[^\s]+', '', line)
    line = re.sub(r'Converted by', '', line)
    line = re.sub(r'Purchased at Beatport', '', line)
    line = re.sub(r'\s+', ' ', line)

    patterns = [
        r'\(copy\)',
        r'\(Extended Mix\)',
        r'\(Extended Version\)',
        r'\(Extended\)',
        r'\(Original Mix\)',
        r'\(Original Version\)',
        r'\(Original\)',
        r'Original Mix',
        r'Original',
    ]

    for pattern in patterns:
        line = re.sub(pattern, '', line, flags=re.IGNORECASE)

    line = re.sub(r'-\s*-', '-', line)

    line = re.sub(r'\(\s*(\w+\s+)*(mix|version|edit)\s*\)',
                  lambda match: f"({match.group(1).capitalize().strip() + ' ' + match.group(2).capitalize()})", line)

    line = re.sub(r'\(\d+\)', '', line)

    # Remove space before commas and parentheses
    line = re.sub(r'\s+,', ',', line)
    line = re.sub(r'\s+\)', ')', line)
    line = re.sub(r'\(\s+', '(', line)

    line = line.strip()
    return line


def read_tag(track_metadata, tag: Tags) -> str:
    return (track_metadata[tag.value].first or '').strip()


def artist_and_title_from_filename(stem: str) -> tuple[str, str]:
    without_track_number = TRACK_NUMBER_PREFIX_PATTERN.sub('', stem).strip()
    artist, title = split_artist_title(without_track_number)
    if title:
        return artist, title
    return '', without_track_number


def set_missing_metadata_from_filename(src, track_metadata):
    if read_tag(track_metadata, Tags.ARTIST) and read_tag(track_metadata, Tags.TRACKTITLE):
        return

    artist, title = artist_and_title_from_filename(to_path(src).stem)
    if artist and not read_tag(track_metadata, Tags.ARTIST):
        track_metadata[Tags.ARTIST.value] = artist
    if title and not read_tag(track_metadata, Tags.TRACKTITLE):
        track_metadata[Tags.TRACKTITLE.value] = title


def fetch_spotify_token(client_id: str, client_secret: str) -> str:
    encoded = base64.b64encode(f"{client_id}:{client_secret}".encode())
    headers = {"Authorization": f"Basic {encoded.decode()}"}
    data = {"grant_type": "client_credentials"}
    response = requests.post(SPOTIFY_TOKEN_URL, headers=headers, data=data, timeout=HTTP_TIMEOUT)
    if response.status_code != 200:
        raise CoverLookupError(f'Spotify token request failed: {response.status_code}')
    return response.json()["access_token"]


def search_query(artist: str, title: str) -> str:
    return ' '.join(part for part in (artist, title) if part)


def fetch_spotify_candidates(artist: str, title: str) -> list[CoverCandidate]:
    ensure_spotify_creds()
    token = fetch_spotify_token(os.environ['SPOTIFY_CLIENT_ID'], os.environ['SPOTIFY_CLIENT_SECRET'])
    response = requests.get(
        SPOTIFY_SEARCH_URL,
        headers={"Authorization": f"Bearer {token}"},
        params={"q": search_query(artist, title), "type": "track", "limit": SEARCH_LIMIT},
        timeout=HTTP_TIMEOUT,
    )
    if response.status_code != 200:
        raise CoverLookupError(f'Spotify search failed: {response.status_code}')
    items = response.json().get("tracks", {}).get("items") or ()
    return [c for c in (to_spotify_candidate(item) for item in items) if c]


def to_spotify_candidate(item: dict) -> CoverCandidate | None:
    images = (item.get('album') or {}).get('images') or ()
    names = [a['name'] for a in item.get('artists') or () if a.get('name')]
    if not images or not item.get('name'):
        return None
    return CoverCandidate(
        source=CoverSource.SPOTIFY,
        artist=', '.join(names),
        title=item['name'],
        image_url=images[0]['url'],
    )


def read_cached_client_id() -> str | None:
    try:
        modified_at = datetime.fromtimestamp(CLIENT_ID_CACHE_PATH.stat().st_mtime)
        if datetime.now() - modified_at > CLIENT_ID_CACHE_TTL:
            return None
        return CLIENT_ID_CACHE_PATH.read_text().strip() or None
    except OSError:
        return None


def write_cached_client_id(client_id: str) -> None:
    try:
        CLIENT_ID_CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
        CLIENT_ID_CACHE_PATH.write_text(client_id)
    except OSError as e:
        logger.debug(f'Could not cache the SoundCloud client_id: {e}')


def scrape_soundcloud_client_id() -> str:
    home = requests.get(SOUNDCLOUD_HOME_URL, headers=SOUNDCLOUD_HEADERS, timeout=HTTP_TIMEOUT)
    if home.status_code != 200:
        raise CoverLookupError(f'SoundCloud homepage failed: {home.status_code}')
    for asset_url in reversed(SOUNDCLOUD_ASSET_PATTERN.findall(home.text)):
        bundle = requests.get(asset_url, headers=SOUNDCLOUD_HEADERS, timeout=HTTP_TIMEOUT)
        match = SOUNDCLOUD_CLIENT_ID_PATTERN.search(bundle.text)
        if match:
            return match.group(1)
    raise CoverLookupError('Could not resolve a SoundCloud client_id')


def fetch_soundcloud_client_id() -> str:
    cached = read_cached_client_id()
    if cached:
        return cached
    client_id = scrape_soundcloud_client_id()
    write_cached_client_id(client_id)
    return client_id


def fetch_soundcloud_candidates(artist: str, title: str) -> list[CoverCandidate]:
    response = requests.get(
        SOUNDCLOUD_SEARCH_URL,
        params={
            'q': search_query(artist, title),
            'client_id': fetch_soundcloud_client_id(),
            'limit': SEARCH_LIMIT,
        },
        headers=SOUNDCLOUD_HEADERS,
        timeout=HTTP_TIMEOUT,
    )
    if response.status_code != 200:
        raise CoverLookupError(f'SoundCloud search failed: {response.status_code}')
    tracks = response.json().get('collection') or ()
    return list(chain.from_iterable(to_soundcloud_candidates(track) for track in tracks))


def to_soundcloud_candidates(track: dict) -> tuple[CoverCandidate, ...]:
    image_url = upsize_soundcloud_artwork(track.get('artwork_url'))
    if not image_url:
        return ()
    return tuple(
        CoverCandidate(CoverSource.SOUNDCLOUD, reading_artist, reading_title, image_url)
        for reading_artist, reading_title in soundcloud_readings(track)
    )


def soundcloud_readings(track: dict) -> list[tuple[str, str]]:
    title = track.get('title') or ''
    uploader = (track.get('user') or {}).get('username') or ''
    publisher = track.get('publisher_metadata') or {}
    readings = [
        (publisher.get('artist') or '', publisher.get('release_title') or title),
        (uploader, title),
        split_artist_title(title),
    ]
    return [(a, t) for a, t in readings if a and t]


def split_artist_title(title: str) -> tuple[str, str]:
    for separator in TITLE_SEPARATORS:
        if separator in title:
            artist, _, remainder = title.partition(separator)
            return artist.strip(), remainder.strip()
    return '', ''


def upsize_soundcloud_artwork(artwork_url: str | None) -> str | None:
    if not artwork_url:
        return None
    return SOUNDCLOUD_ARTWORK_SIZE_PATTERN.sub(f'-{SOUNDCLOUD_ARTWORK_SIZE}.', artwork_url)


def normalize_for_match(text: str) -> str:
    lowered = unicodedata.normalize('NFD', text.lower()).encode('ASCII', 'ignore').decode()
    without_noise = MATCH_NOISE_PATTERN.sub(' ', lowered)
    without_featuring = FEATURING_TOKEN_PATTERN.sub(' ', without_noise)
    return ' '.join(NON_ALPHANUMERIC_PATTERN.sub(' ', without_featuring).split())


def sequence_similarity(left: str, right: str) -> float:
    if not left or not right:
        return 0.0
    return SequenceMatcher(None, left, right).ratio()


def token_coverage(reference: str, candidate: str) -> float:
    reference_tokens = set(reference.split())
    if not reference_tokens:
        return 0.0
    return len(reference_tokens & set(candidate.split())) / len(reference_tokens)


def title_similarity(candidate_title: str, tag_title: str) -> float:
    return sequence_similarity(normalize_for_match(candidate_title), normalize_for_match(tag_title))


def artist_similarity(candidate_artist: str, tag_artist: str) -> float:
    candidate_normalized = normalize_for_match(candidate_artist)
    tag_normalized = normalize_for_match(tag_artist)
    return max(
        sequence_similarity(candidate_normalized, tag_normalized),
        token_coverage(tag_normalized, candidate_normalized),
    )


def score_candidate(candidate: CoverCandidate, artist: str, title: str) -> float:
    title_score = title_similarity(candidate.title, title)
    if not artist:
        return title_score
    return TITLE_WEIGHT * title_score + ARTIST_WEIGHT * artist_similarity(candidate.artist, artist)


CoverProvider = Callable[[str, str], list[CoverCandidate]]


def cover_providers() -> tuple[tuple[CoverSource, CoverProvider], ...]:
    return (
        (CoverSource.SPOTIFY, fetch_spotify_candidates),
        (CoverSource.SOUNDCLOUD, fetch_soundcloud_candidates),
    )


def collect_cover_candidates(artist: str, title: str) -> list[CoverCandidate]:
    candidates: list[CoverCandidate] = []
    for source, provider in cover_providers():
        try:
            candidates.extend(provider(artist, title))
        except (OSError, CoverLookupError, ValueError, KeyError) as e:
            logger.warning(f'{source.value} cover lookup failed: {e}')
    return candidates


def find_best_cover(artist: str, title: str) -> ScoredCover | None:
    scored = [
        ScoredCover(candidate, score_candidate(candidate, artist, title))
        for candidate in collect_cover_candidates(artist, title)
    ]
    if not scored:
        return None
    return min(scored, key=lambda s: (-s.score, SOURCE_PREFERENCE[s.candidate.source]))


def download_image(url: str) -> bytes | None:
    response = requests.get(url, timeout=HTTP_TIMEOUT)
    if response.status_code != 200:
        logger.warning(f'Cover art download failed: {response.status_code}')
        return None
    return response.content


def download_and_set_cover_photo(track_metadata):
    artist = read_tag(track_metadata, Tags.ARTIST)
    title = read_tag(track_metadata, Tags.TRACKTITLE)
    if not title:
        logger.warning('Skipping cover art lookup, no title could be determined')
        return

    best = find_best_cover(artist, title)
    if not best:
        print(f'No cover art candidates found for [{artist} - {title}]')
        return
    if best.score < MIN_MATCH_SCORE:
        print(f'Best cover art match too weak ({best.score:.2f}) for [{artist} - {title}]')
        return

    artwork = download_image(best.candidate.image_url)
    if artwork:
        track_metadata[Tags.ARTWORK.value] = artwork
        print(f'Cover art from {best.candidate.source.value} (match {best.score:.2f}) '
              f'[{best.candidate.artist} - {best.candidate.title}]')


def to_path(src):
    if isinstance(src, str):
        return Path(src)
    elif isinstance(src, Path):
        return src
    else:
        raise TypeError(f"Expected str or Path, got {type(src).__name__}")


def remove_where_from(file_path: str | Path) -> None:
    try:
        subprocess.run(
            ['xattr', '-d', WHERE_FROM_ATTRIBUTE, str(file_path)],
            stderr=subprocess.DEVNULL,
            check=False
        )
    except FileNotFoundError:
        logger.debug("xattr unavailable, skipping where-from removal")


if __name__ == '__main__':
    logger.setLevel("DEBUG")
    main()

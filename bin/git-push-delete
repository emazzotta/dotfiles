#!/bin/bash
set -uo pipefail

show_usage() {
    cat <<EOF
Usage: git push-delete <branch>...

Delete each branch on origin, or every branch on origin a glob like 'LEO-1-*' matches.
EOF
}

origin_branches() {
    git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin | grep -vx HEAD
}

branches_on_origin() {
    git ls-remote --heads origin "refs/heads/$1" | sed 's|^.*[[:space:]]refs/heads/||'
}

main() {
    local pattern matches branch failed=0
    local branches=()
    case "${1:-}" in
        -h|--help) show_usage; return 0 ;;
        --complete) origin_branches; return 0 ;;
        "") show_usage >&2; return 2 ;;
    esac
    for pattern in "$@"; do
        matches=$(branches_on_origin "$pattern") || return 1
        if [ -z "$matches" ]; then
            echo "error: no branch on origin matches '$pattern'" >&2
            failed=1
            continue
        fi
        while IFS= read -r branch; do
            branches+=("$branch")
        done <<<"$matches"
    done
    if [ "${#branches[@]}" -gt 0 ]; then
        git push origin --delete "${branches[@]}" || failed=1
    fi
    return "$failed"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

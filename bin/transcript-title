#!/usr/bin/env python3
"""Set the title of a published session replay, in place.

Re-rendering to change a title would pick up everything that happened in the
session after the first publish; this rewrites the title alone, so a URL already
in circulation keeps the snapshot its readers saw.

vibe-replay carries the title twice: in <title> and in the meta block of the
replay JSON it embeds, which is the one the page itself renders. Transcripts
published before the vibe-replay switch came from claude-code-log, which carries
it in <title> and <h1 id="title"> instead - both formats are still online, so
both are handled here.

Usage:
    transcript-title <FILE.html> <TITLE>   retitle in place
"""

from __future__ import annotations

from html import escape
from pathlib import Path
import argparse
import json
import re
import sys

DOC_TITLE_PATTERN = re.compile(r"(<title[^>]*>).*?(</title>)", re.DOTALL | re.IGNORECASE)
HEADER_PATTERN = re.compile(
    r"(<h1[^>]*\sid=[\"']title[\"'][^>]*>).*?(</h1>)", re.DOTALL | re.IGNORECASE
)
REPLAY_DATA_PATTERN = re.compile(
    r'(<script id="vibe-replay-data">window\.__VIBE_REPLAY_DATA__ = )(.*?)(;</script>)',
    re.DOTALL,
)
VIEWER_TITLE_SUFFIX = " — vibe-replay"


def set_replay_title(html: str, title: str) -> tuple[str, int]:
    """Rewrite the title in the embedded vibe-replay JSON. Returns (html, hits)."""

    def replace(match: re.Match[str]) -> str:
        replay = json.loads(match.group(2))
        replay["meta"]["title"] = title
        # The generator escapes </ so the blob cannot close its own script tag.
        data = json.dumps(replay, ensure_ascii=False, separators=(",", ":")).replace(
            "</", "<\\/"
        )
        return match.group(1) + data + match.group(3)

    return REPLAY_DATA_PATTERN.subn(replace, html, count=1)


def replace_element_text(pattern: re.Pattern[str], html: str, text: str) -> tuple[str, int]:
    safe = escape(text)
    return pattern.subn(lambda match: match.group(1) + safe + match.group(2), html, count=1)


def set_title(html: str, title: str) -> tuple[str, int]:
    """Return (html, replacements) with every carrier of the title rewritten."""
    html, replay_hits = set_replay_title(html, title)
    doc_title = title + VIEWER_TITLE_SUFFIX if replay_hits else title
    html, doc_hits = replace_element_text(DOC_TITLE_PATTERN, html, doc_title)
    if replay_hits:
        return html, replay_hits + doc_hits
    html, header_hits = replace_element_text(HEADER_PATTERN, html, title)
    return html, doc_hits + header_hits


def process_file(path: Path, title: str) -> int:
    html = path.read_text(encoding="utf-8")
    new_html, replacements = set_title(html, title)
    if replacements:
        path.write_text(new_html, encoding="utf-8")
    return replacements


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Set the title of a session replay.")
    parser.add_argument("html", type=Path, help="HTML replay to retitle in place")
    parser.add_argument("title", help="title to use for the document and header")
    args = parser.parse_args(argv)

    if not args.html.is_file():
        print(f"transcript-title: not a file: {args.html}", file=sys.stderr)
        return 1
    if not args.title.strip():
        print("transcript-title: title must not be blank", file=sys.stderr)
        return 2

    replacements = process_file(args.html, args.title)
    if not replacements:
        print(f"transcript-title: no title element found in {args.html}", file=sys.stderr)
        return 1

    print(f"titled: {args.title}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())

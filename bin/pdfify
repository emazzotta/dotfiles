#!/bin/bash

set -e

if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
    echo "usage: $(basename "${0}") [filename]"
    exit 0
fi

input_file="${1:-$(pickfile md markdown rst docx odt epub html tex)}"
[ -n "${input_file}" ] || exit 1

output_file="${input_file%.*}.pdf"
echo "Converting ${input_file} to ${output_file}..."
pandoc "${input_file}" -s -o "${output_file}"

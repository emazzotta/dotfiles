#!/bin/bash
set -uo pipefail

show_usage() {
    cat <<EOF
Usage: gup [<git pull args>]

git pull --rebase --autostash, then git wt rm --merged to delete the branches and worktrees
whose work has landed in origin/HEAD. Outside main and master the rebase keeps merge commits,
so a merge of main that is not pushed yet survives. Run inside a worktree's .git/worktrees/<id>
directory, it updates that worktree's checkout instead.
EOF
}

complete_next_word() {
    case $# in
        0) git remote ;;
        1) git for-each-ref --format='%(refname:lstrip=3)' "refs/remotes/$1" | grep -vx HEAD ;;
    esac
}

inside_worktree_git_dir() {
    [ "$(git rev-parse --is-inside-git-dir 2>/dev/null)" = true ] &&
        [ "$(git rev-parse --absolute-git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ]
}

rebase_mode() {
    case "$1" in
        main|master) echo true ;;
        *) echo merges ;;
    esac
}

update_checkout() {
    local checkout="$1" branch
    shift
    branch=$(git -C "$checkout" symbolic-ref -q --short HEAD)
    git -C "$checkout" pull --rebase="$(rebase_mode "$branch")" --autostash "$@" || return
    git -C "$checkout" wt rm --merged
}

pull_worktree_checkout() {
    local head checkout
    if ! head=$(git symbolic-ref -q HEAD); then
        echo "gup: HEAD is detached, no branch to update" >&2
        return 1
    fi
    checkout=$(git wt path "${head#refs/heads/}") || return 1
    echo "gup: updating $checkout" >&2
    update_checkout "$checkout" "$@"
}

main() {
    case "${1:-}" in
        -h|--help) show_usage; return 0 ;;
        --complete) shift; complete_next_word "$@" 2>/dev/null; return 0 ;;
    esac
    if inside_worktree_git_dir; then
        pull_worktree_checkout "$@"
    else
        update_checkout "$PWD" "$@"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

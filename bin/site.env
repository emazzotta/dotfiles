# Defaults for the Leonardo network. Override any of these per machine in
# ~/.config/dotfiles/site.env, or with an environment variable of the same name.
# Plain KEY=value only - this file is sourced by shell scripts as well as read
# by siteconf.py, so no expansions, no quoting tricks, no logic.

NETWORK_DRIVE_SERVER_IP=192.168.5.155
NETWORK_DRIVE_FOLDER=Daten
VM_DRIVE_MOUNT_POINT=smb://admin@192.168.5.7:4445/Devserver-Windows-VM
LEONARDO_STATUS_HOST=updates.leonardo.local

# short-name:fqdn[,fqdn...][;short-name:fqdn...] - see host-resolver --help
HOST_ALIASES=ci-macmini:ci-macmini.dyn.leonardo.local,Mac-mini-von-Andreas.local

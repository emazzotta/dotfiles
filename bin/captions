#!/usr/bin/env python3
"""Burn Hormozi-style karaoke captions into a short-form video, fully local.

Pipeline: extract audio -> faster-whisper word timestamps -> styled .ass
(one word highlighted at a time) -> ffmpeg burn-in. No cloud, no upload.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from dataclasses import dataclass
from enum import Enum
from pathlib import Path
from typing import Final

GOOGLE_FONTS: Final = "https://github.com/google/fonts/raw/main"
CACHE: Final = Path.home() / ".cache" / "captions"
VENV: Final = CACHE / "venv"
TRANSCRIPTS: Final = CACHE / "transcripts"
SENTENCE_END: Final = re.compile(r"[.!?]$")
BOOTSTRAP_FLAG: Final = "CAPTIONS_BOOTSTRAPPED"
LAST_WORD_TAIL: Final = 0.15
VIDEOTOOLBOX_BITRATE: Final = "12M"
HEX_COLOUR: Final = re.compile(r"^#?[0-9A-Fa-f]{6}$")
DEFAULT_STYLE: Final = "Default"
GLOW_STYLE: Final = "Glow"
BOX_STYLE: Final = "Box"
TRANSPARENT: Final = "&HFF000000"
NO_POP: Final = 100
MAX_POP: Final = 150
POP_MS: Final = 140

# Every ratio below is a fraction of the ink band - the caps-to-baseline strip
# the face actually paints - because that band, not the em box, is what a
# viewer reads as "the text size". They reproduce a reference reel measured
# pixel by pixel: 75px of ink carrying a 6px outline, a 10px-wide and
# 23px-tall gap to the highlight box, and that box 60% taller than the caps.
OUTLINE_RATIO: Final = 0.08
GLOW_OUTLINE_RATIO: Final = 1.5  # of the outline
GLOW_BLUR_RATIO: Final = 0.8  # of the outline
BOX_PAD_X_RATIO: Final = 0.141
BOX_PAD_Y_RATIO: Final = 0.308
BOX_ROUND_RATIO: Final = 0.33  # of the box height
BOX_BLEED_RATIO: Final = 0.04  # of the rounding
BOX_ROUND_LAYERS: Final = 5
DEFAULT_PALETTE: Final = (
    "#22FF00",  # green
    "#3B82FF",  # blue
    "#A24BFF",  # violet
    "#FF2E9A",  # pink
    "#FF3B30",  # red
    # "#FFC400",  # amber
)
BOX_PALETTE: Final = ("#FE2C55",)
WHISPER_MODELS: Final = (
    "tiny", "tiny.en", "base", "base.en", "small", "small.en",
    "medium", "medium.en", "large-v1", "large-v2", "large-v3", "large",
)
COMMON_LANGS: Final = ("en", "de", "fr", "it", "es", "pt", "nl", "ru", "ja", "zh")
ALIGNMENTS: Final = tuple(str(n) for n in range(1, 10))
ALIGNMENT_COLUMNS: Final = 3
TOP_ROW_START: Final = 7
TOP_ALIGNMENTS: Final = frozenset({7, 8, 9})
BOTTOM_ALIGNMENTS: Final = frozenset({1, 2, 3})
MIN_BOX_SCALE: Final = 40


class Highlight(Enum):
    FILL = "fill"
    BACKGROUND = "background"

    def __str__(self) -> str:
        return self.value


@dataclass(frozen=True)
class Font:
    """A typeface to burn in, plus how it wants to be set.

    `scale` is the font size as a fraction of video height that makes this
    face fill a line like Anton does at its own default. `ink_top` and
    `ink_bottom` are the fractions of the ascent-to-descent band that lie
    outside the ink of an ordinary word, so everything the highlight box and
    the outline are sized and placed from can be derived from the band the eye
    actually sees. All three are measured by rendering, not guessed. Bare caps
    set the band for the shouting faces: a diacritic reaches into the box's top
    padding instead of pushing the box up the way it would in a renderer that
    could measure each word. `tracking` tightens or opens the letter spacing by
    a fraction of the font size, for faces the reference sets closer than they
    are drawn.
    """

    family: str
    path: str
    scale: float
    bold: bool = False
    italic: bool = False
    uppercase: bool = False
    ink_top: float = 0.0
    ink_bottom: float = 0.0
    tracking: float = 0.0

    @property
    def url(self) -> str:
        return f"{GOOGLE_FONTS}/{urllib.parse.quote(self.path)}"

    @property
    def file_name(self) -> str:
        return self.path.rsplit("/", 1)[-1]


DEFAULT_FONT: Final = "barlow-condensed"
FONTS: Final = {
    "anton": Font(
        "Anton", "ofl/anton/Anton-Regular.ttf", 0.058,
        bold=True, uppercase=True, ink_top=0.180, ink_bottom=0.108,
    ),
    "barlow-condensed": Font(
        "Barlow Condensed ExtraBold",
        "ofl/barlowcondensed/BarlowCondensed-ExtraBold.ttf", 0.074,
        uppercase=True, ink_top=0.271, ink_bottom=0.201, tracking=-0.007,
    ),
    "caveat": Font(
        "Caveat", "ofl/caveat/Caveat[wght].ttf", 0.053,
        bold=True, ink_top=0.089, ink_bottom=0.050,
    ),
    "courgette": Font(
        "Courgette", "ofl/courgette/Courgette-Regular.ttf", 0.038, ink_top=0.014
    ),
    "dancing-script": Font(
        "Dancing Script", "ofl/dancingscript/DancingScript[wght].ttf", 0.053,
        bold=True, ink_top=0.158,

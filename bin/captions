    "grand-hotel": Font(
        "Grand Hotel", "ofl/grandhotel/GrandHotel-Regular.ttf", 0.059, ink_top=0.053
    ),
    "kaushan": Font(
        "Kaushan Script", "ofl/kaushanscript/KaushanScript-Regular.ttf", 0.051,
        ink_top=0.134,
    ),
    "lobster": Font(
        "Lobster", "ofl/lobster/Lobster-Regular.ttf", 0.051,

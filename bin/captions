    ),
    "pacifico": Font(
        "Pacifico", "ofl/pacifico/Pacifico-Regular.ttf", 0.063, ink_top=0.217
    ),
    "yellowtail": Font(
        "Yellowtail", "apache/yellowtail/Yellowtail-Regular.ttf", 0.052, ink_top=0.051
    ),
}

COMPLETIONS: Final = {
    "models": WHISPER_MODELS,
    "langs": COMMON_LANGS,
    "alignment": ALIGNMENTS,
    "modes": tuple(mode.value for mode in Highlight),
    "fonts": tuple(sorted(FONTS)),
}


@dataclass(frozen=True)
class Word:
    text: str
    start: float
    end: float

    @property
    def ends_sentence(self) -> bool:
        return SENTENCE_END.search(self.text) is not None


@dataclass(frozen=True)
class Box:
    """Where the highlight block goes and how it is drawn.

    It is anchored to the top of the frame whatever the caption's own
    alignment, because that is the one edge libass keeps put when the box
    style is squashed - which is how the block ends up hugging the ink instead
    of the font's full ascent-to-descent band.
    """

    pad_x: int
    rounding: int
    scale_y: int
    margin_v: int
    alignment: int


@dataclass(frozen=True)
class Style:
    font_size: int
    outline: int
    glow_outline: int
    glow_blur: int
    spacing: float
    highlights: tuple[str, ...]
    max_words: int
    max_gap: float
    play_w: int
    play_h: int
    margin_v: int
    alignment: int
    mode: Highlight
    pop: int
    font: Font
    box: Box


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(cmd, check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "").strip()
        raise SystemExit(f"{cmd[0]} failed (exit {exc.returncode}): {detail}")


def log(message: str) -> None:
    print(f"[{time.strftime('%H:%M:%S')}] {message}", file=sys.stderr, flush=True)


def _transcript_key(video: Path, model_name: str, language: str | None) -> Path:
    stat = video.stat()
    seed = f"{video.resolve()}|{stat.st_size}|{stat.st_mtime_ns}|{model_name}|{language or 'auto'}"
    digest = hashlib.sha256(seed.encode()).hexdigest()[:16]
    return TRANSCRIPTS / f"{digest}.json"


def _load_transcript(path: Path) -> list[Word] | None:
    if not path.exists():
        return None
    try:
        entries = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return None
    return [Word(text=e["text"], start=e["start"], end=e["end"]) for e in entries]


def _save_transcript(path: Path, words: list[Word]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    entries = [{"text": w.text, "start": w.start, "end": w.end} for w in words]
    path.write_text(json.dumps(entries), encoding="utf-8")


def provision_python() -> str:
    """Create a cached uv venv with faster-whisper and return its interpreter."""
    log("Setting up local transcription runtime (one-time)...")
    VENV.parent.mkdir(parents=True, exist_ok=True)
    create = ["uv", "venv", str(VENV)]
    if VENV.exists():
        create.insert(2, "--clear")
    run(create)
    env = {**os.environ, "UV_HTTP_TIMEOUT": "120", "VIRTUAL_ENV": str(VENV)}
    subprocess.run(
        ["uv", "pip", "install", "-q", "faster-whisper"],
        check=True, env=env, text=True,
    )
    return str(VENV / "bin" / "python")


def ensure_runtime() -> None:
    """Re-exec under a venv that has faster-whisper if the import is missing."""
    try:
        import faster_whisper  # noqa: F401
        return
    except ImportError:
        pass
    if os.environ.get(BOOTSTRAP_FLAG):
        sys.exit(
            f"faster-whisper unavailable even after bootstrap; remove {VENV} and retry"
        )
    venv_python = VENV / "bin" / "python"
    python = str(venv_python) if venv_python.exists() else provision_python()
    os.execve(
        python, [python, str(Path(__file__).resolve()), *sys.argv[1:]],
        {**os.environ, BOOTSTRAP_FLAG: "1"},
    )


def ensure_subtitles_filter() -> None:
    """Fail fast when ffmpeg was built without libass (no subtitles filter)."""
    filters = run(["ffmpeg", "-hide_banner", "-filters"]).stdout
    available = any(
        len(fields) >= 2 and fields[1] == "subtitles"
        for fields in (line.split() for line in filters.splitlines())
    )
    if not available:
        sys.exit(
            "ffmpeg has no 'subtitles' filter (built without libass). "
            "Homebrew's core ffmpeg no longer ships it; install a full build:\n"
            "  brew uninstall ffmpeg\n"
            "  brew tap homebrew-ffmpeg/ffmpeg\n"
            "  brew install homebrew-ffmpeg/ffmpeg/ffmpeg"
        )


def probe_dimensions(video: Path) -> tuple[int, int]:
    out = run([
        "ffprobe", "-v", "error", "-select_streams", "v:0",
        "-show_entries", "stream=width,height",
        "-of", "csv=s=x:p=0", str(video),
    ]).stdout.strip()
    width, height = out.split("x")
    return int(width), int(height)


def extract_audio(video: Path, work: Path) -> Path:
    wav = work / "audio.wav"
    run([
        "ffmpeg", "-y", "-loglevel", "error", "-i", str(video),
        "-ar", "16000", "-ac", "1", str(wav),
    ])
    return wav


def transcribe_words(wav: Path, language: str | None, model_name: str) -> list[Word]:
    from faster_whisper import WhisperModel

    model = WhisperModel(model_name, device="cpu", compute_type="int8")
    segments, _ = model.transcribe(
        str(wav), language=language, word_timestamps=True, vad_filter=True,
    )
    words: list[Word] = []
    for segment in segments:
        for word in segment.words or []:
            text = word.word.strip()
            if text:
                words.append(Word(text=text, start=word.start, end=word.end))
    return words


def obtain_words(video: Path, work: Path, args: argparse.Namespace) -> list[Word]:
    """Return word timestamps, reusing a cached transcript when one is valid."""
    cache_path = _transcript_key(video, args.model, args.lang)
    if not args.no_cache:
        cached = _load_transcript(cache_path)
        if cached is not None:
            log(f"Reusing cached transcript ({len(cached)} words, {cache_path})")
            return cached
    log(f"Transcribing (local whisper, model={args.model})...")
    started = time.perf_counter()
    words = transcribe_words(extract_audio(video, work), args.lang, args.model)
    log(f"Transcribed {len(words)} words in {time.perf_counter() - started:.1f}s")
    if words and not args.no_cache:
        _save_transcript(cache_path, words)
        log(f"Cached transcript to {cache_path} (rerun resumes at rendering)")
    return words


def group_words(words: list[Word], max_words: int, max_gap: float) -> list[list[Word]]:
    groups: list[list[Word]] = []
    current: list[Word] = []
    for word in words:
        if current and _should_break(current, word, max_words, max_gap):
            groups.append(current)
            current = []
        current.append(word)
    if current:
        groups.append(current)
    return groups


def _should_break(
    current: list[Word], word: Word, max_words: int, max_gap: float
) -> bool:
    return (
        len(current) >= max_words
        or word.start - current[-1].end > max_gap
        or current[-1].ends_sentence
    )


def _fmt_time(seconds: float) -> str:
    seconds = max(0.0, seconds)
    hours, rest = divmod(seconds, 3600)
    minutes, secs = divmod(rest, 60)
    return f"{int(hours)}:{int(minutes):02d}:{secs:05.2f}"


def _ass_colour(hex_colour: str, style_field: bool) -> str:
    c = hex_colour.lstrip("#")
    bgr = f"{c[4:6]}{c[2:4]}{c[0:2]}".upper()
    return f"&H00{bgr}" if style_field else f"&H{bgr}&"


def _pop_tags(pop: int, scale_y: int = 100) -> str:
    """Scale the active word up, starting from the height its style sets.

    `\\fscy` is absolute, so a squashed box style has to be restated here or
    the pop would quietly undo the squash for the one word that matters.
    """
    if pop == NO_POP:
        return ""
    popped = round(scale_y * pop / 100)
    return f"\\fscx100\\fscy{scale_y}\\t(0,{POP_MS},\\fscx{pop}\\fscy{popped})"


def _tokens(
    words: list[Word], active: int, tags: str, reset: str, style: Style
) -> str:
    """Set the line word by word, marking only the active one.

    The letter spacing rides along on every token because libass silently
    clamps a style's negative Spacing to zero and honours it only inline.
    """
    spacing = f"\\fsp{style.spacing}" if style.spacing else ""
    marker = f"{tags}{spacing}"
    plain = f"{{{reset}{spacing}}}"
    shown = [w.text.upper() if style.font.uppercase else w.text for w in words]
    return " ".join(
        f"{{{marker}}}{text}{plain}" if index == active and marker else f"{plain}{text}"
        for index, text in enumerate(shown)
    )


def _fill_line(words: list[Word], active: int, highlight: str, style: Style) -> str:
    tags = f"\\c{highlight}{_pop_tags(style.pop)}"
    return _tokens(words, active, tags, "\\r", style)


def _plain_line(words: list[Word], active: int, style: Style) -> str:
    return _tokens(words, active, _pop_tags(style.pop), "\\r", style)


def _glow_line(words: list[Word], active: int, style: Style) -> str:
    """Bed the line into the footage with a soft dark halo.

    A blurred border reads as the shadow the crisp outline cannot be: libass
    blurs an event's border but leaves its fill sharp, so the halo has to come
    from a second, thicker-bordered copy sitting under the real text.
    """
    blur = f"\\blur{style.glow_blur}"
    return _tokens(
        words, active, f"{blur}{_pop_tags(style.pop)}", f"\\r{GLOW_STYLE}{blur}", style
    )


def _box_line(words: list[Word], active: int, highlight: str, style: Style) -> str:
    """Paint a rounded rectangle behind the active word only.

    Every colour in the Box style is transparent, so the one word that
    overrides the outline is the only one BorderStyle 3 fills in. ASS has no
    border radius: `\\be` rounds the corners while keeping the edges far
    crisper than `\\blur` would, and redrawing the box on BOX_ROUND_LAYERS
    separate layers compounds back the alpha that softening costs. Same-layer
    copies would trip libass' collision avoidance instead.
    """
    tags = (
        f"\\3c{highlight}\\3a&H00&\\xbord{style.box.pad_x}"
        f"\\ybord0\\be{style.box.rounding}"
        f"{_pop_tags(style.pop, style.box.scale_y)}"
    )
    return _tokens(words, active, tags, f"\\r{BOX_STYLE}", style)


def _event(layer: int, start: float, end: float, name: str, text: str) -> str:
    return (
        f"Dialogue: {layer},{_fmt_time(start)},{_fmt_time(end)},{name},,0,0,0,,{text}"
    )


def _word_events(
    group: list[Word], active: int, colour: str, span: tuple[float, float], style: Style
) -> list[str]:
    start, end = span
    events: list[str] = []
    if style.mode is Highlight.BACKGROUND:
        box = _box_line(group, active, colour, style)
        events += [
            _event(layer, start, end, BOX_STYLE, box)
            for layer in range(BOX_ROUND_LAYERS)
        ]
    glow = _glow_line(group, active, style)
    events.append(_event(len(events), start, end, GLOW_STYLE, glow))
    text = (
        _fill_line(group, active, colour, style)
        if style.mode is Highlight.FILL
        else _plain_line(group, active, style)
    )
    events.append(_event(len(events), start, end, DEFAULT_STYLE, text))
    return events


def _group_events(
    group: list[Word], colour: str, next_start: float | None, style: Style
) -> list[str]:
    events: list[str] = []
    for index, word in enumerate(group):
        start = group[0].start if index == 0 else word.start
        end = _word_end(group, index, word, next_start)
        events.extend(_word_events(group, index, colour, (start, end), style))
    return events


def _word_end(
    group: list[Word], index: int, word: Word, next_start: float | None
) -> float:
    if index + 1 < len(group):
        return group[index + 1].start
    tail = word.end + LAST_WORD_TAIL
    return tail if next_start is None else min(tail, next_start)


def _style_definitions(style: Style) -> list[str]:
    primary = _ass_colour("#FFFFFF", style_field=True)
    outline = _ass_colour("#000000", style_field=True)
    geometry = f"{style.alignment},40,40,{style.margin_v},1"
    family = style.font.family
    weight = f"{int(style.font.bold)},{int(style.font.italic)},0,0"
    definitions = [
        f"Style: {DEFAULT_STYLE},{family},{style.font_size},{primary},{primary},"
        f"{outline},{TRANSPARENT},{weight},100,100,0,0,1,{style.outline},0,{geometry}",
        f"Style: {GLOW_STYLE},{family},{style.font_size},{TRANSPARENT},"
        f"{TRANSPARENT},{outline},{TRANSPARENT},{weight},100,100,0,0,1,"
        f"{style.glow_outline},0,{geometry}",
    ]
    if style.mode is Highlight.BACKGROUND:
        box = style.box
        box_geometry = f"{box.alignment},40,40,{box.margin_v},1"
        definitions.append(
            f"Style: {BOX_STYLE},{family},{style.font_size},{TRANSPARENT},"
            f"{TRANSPARENT},{TRANSPARENT},{TRANSPARENT},{weight},100,"
            f"{box.scale_y},0,0,3,{box.pad_x},0,{box_geometry}"
        )
    return definitions


def build_ass(groups: list[list[Word]], style: Style) -> str:
    header = [
        "[Script Info]",
        "ScriptType: v4.00+",
        "WrapStyle: 0",
        "ScaledBorderAndShadow: yes",
        f"PlayResX: {style.play_w}",
        f"PlayResY: {style.play_h}",
        "",
        "[V4+ Styles]",
        "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, "
        "OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, "
        "ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, "
        "Alignment, MarginL, MarginR, MarginV, Encoding",
        *_style_definitions(style),
        "",
        "[Events]",
        "Format: Layer, Start, End, Style, Name, MarginL, MarginR, "
        "MarginV, Effect, Text",
    ]
    palette = [_ass_colour(colour, style_field=False) for colour in style.highlights]
    events: list[str] = []
    for index, group in enumerate(groups):
        next_start = groups[index + 1][0].start if index + 1 < len(groups) else None
        colour = palette[index % len(palette)]
        events.extend(_group_events(group, colour, next_start, style))
    return "\n".join(header + events) + "\n"


def ensure_font(font: Font) -> Path:
    font_dir = CACHE / "fonts"
    font_path = font_dir / font.file_name
    if not font_path.exists():
        font_dir.mkdir(parents=True, exist_ok=True)
        log(f"Fetching {font.family}...")
        urllib.request.urlretrieve(font.url, font_path)  # noqa: S310 (fixed https url)
    return font_dir


def _quote_filter_path(path: Path) -> str:
    """Single-quote a path for an ffmpeg filtergraph option value.

    The plain positional form (subtitles=<path>:fontsdir=<path>) is rejected by
    ffmpeg 7/8's filtergraph parser even for ordinary paths; wrapping each value
    in single quotes and naming the option explicitly is the portable form.
    Backslashes are doubled; the controlled cache paths never contain quotes.
    """
    return "'" + str(path).replace("\\", "\\\\") + "'"


def _has_encoder(name: str) -> bool:
    encoders = run(["ffmpeg", "-hide_banner", "-encoders"]).stdout
    return any(
        len(fields) >= 2 and fields[1] == name
        for fields in (line.split() for line in encoders.splitlines())
    )


def video_encoder_args() -> list[str]:
    """Prefer Apple's hardware H.264 encoder; fall back to a fast libx264.

    The subtitles filter forces a full video re-encode, so the encoder choice
    dominates render time. VideoToolbox offloads it to the Mac's media engine
    (roughly an order of magnitude faster, negligible quality loss for
    short-form social video); off-Mac we use a fast software preset.
    """
    if _has_encoder("h264_videotoolbox"):
        return ["-c:v", "h264_videotoolbox", "-b:v", VIDEOTOOLBOX_BITRATE]
    return [
        "-c:v", "libx264", "-preset", "veryfast", "-crf", "20",
        "-pix_fmt", "yuv420p",
    ]


def burn(video: Path, ass_path: Path, font_dir: Path, out: Path) -> None:
    subs = _quote_filter_path(ass_path)
    fonts = _quote_filter_path(font_dir)
    cmd = [
        "ffmpeg", "-y", "-loglevel", "error", "-stats", "-i", str(video),
        "-vf", f"subtitles=filename={subs}:fontsdir={fonts}",
        *video_encoder_args(),
        "-c:a", "copy", str(out),
    ]
    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError as exc:
        raise SystemExit(f"ffmpeg failed (exit {exc.returncode})")


def _ink_top(
    font_size: int, font: Font, alignment: int, margin_v: int, play_h: int
) -> float:
    """Return the absolute y where the anchored line starts painting ink.

    MarginV pins the top edge of the ascent-to-descent band for a top-anchored
    line and its bottom edge for a bottom-anchored one; the middle row ignores
    the margin and centres the band instead.
    """
    if alignment in TOP_ALIGNMENTS:
        band_top = float(margin_v)
    elif alignment in BOTTOM_ALIGNMENTS:
        band_top = play_h - margin_v - font_size
    else:
        band_top = (play_h - font_size) / 2
    return band_top + font_size * font.ink_top


def _build_box(
    font_size: int, ink_top: float, ink_height: float, alignment: int
) -> Box:
    """Wrap the ink band in the highlight block, padded on all four sides.

    The softening that rounds the corners also bleeds the block outwards, so
    it pays for part of the padding instead of adding to it.

    libass double-applies a style's ScaleY to an opaque box, the way VSFilter
    did, so the rendered height follows its square - hence the root.
    """
    pad_y = ink_height * BOX_PAD_Y_RATIO
    rounding = max(1, round((ink_height + 2 * pad_y) * BOX_ROUND_RATIO))
    bleed = rounding * BOX_BLEED_RATIO
    height = ink_height + 2 * (pad_y - bleed)
    return Box(
        pad_x=max(0, round(ink_height * BOX_PAD_X_RATIO - bleed)),
        rounding=rounding,
        scale_y=max(MIN_BOX_SCALE, round(100 * math.sqrt(height / font_size))),
        margin_v=max(0, round(ink_top - pad_y + bleed)),
        alignment=TOP_ROW_START + (alignment - 1) % ALIGNMENT_COLUMNS,
    )


def _default_palette(mode: Highlight) -> tuple[str, ...]:
    return BOX_PALETTE if mode is Highlight.BACKGROUND else DEFAULT_PALETTE


def build_style(width: int, height: int, args: argparse.Namespace) -> Style:
    font = FONTS[args.font]
    font_size = int(height * (args.scale or font.scale))
    margin_v = int(height * args.position)
    ink_height = font_size * (1 - font.ink_top - font.ink_bottom)
    ink_top = _ink_top(font_size, font, args.alignment, margin_v, height)
    outline = max(3, round(ink_height * OUTLINE_RATIO))
    return Style(
        font_size=font_size,
        outline=outline,
        glow_outline=round(outline * GLOW_OUTLINE_RATIO),
        glow_blur=max(1, round(outline * GLOW_BLUR_RATIO)),
        spacing=round(font_size * font.tracking, 2),
        highlights=args.highlight or _default_palette(args.mode),
        max_words=args.words,
        max_gap=args.gap,
        play_w=width,
        play_h=height,
        margin_v=margin_v,
        alignment=args.alignment,
        mode=args.mode,
        pop=args.pop,
        font=font,
        box=_build_box(font_size, ink_top, ink_height, args.alignment),
    )


def _parse_palette(value: str) -> tuple[str, ...]:
    colours = tuple(part.strip() for part in value.split(",") if part.strip())
    if not colours:
        raise argparse.ArgumentTypeError("no colours given")
    for colour in colours:
        if not HEX_COLOUR.match(colour):
            raise argparse.ArgumentTypeError(f"invalid hex colour: {colour}")
    return tuple(c if c.startswith("#") else f"#{c}" for c in colours)


def _parse_pop(value: str) -> int:
    try:
        pop = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a whole percentage: {value}") from None
    if not NO_POP <= pop <= MAX_POP:
        raise argparse.ArgumentTypeError(
            f"pop must be between {NO_POP} and {MAX_POP}, got {pop}"
        )
    return pop


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Burn Hormozi-style captions into a video."
    )
    add = parser.add_argument
    add("video", type=Path, help="input video file")
    add("-o", "--output", type=Path, help="output (default <name>_captioned.mp4)")
    add(
        "--highlight",
        type=_parse_palette,
        default=None,
        help="active-word colour: one hex for a fixed colour, or a comma-separated "
        "list to cycle per line (default: one red for 'background', a rainbow "
        "palette for 'fill')",
    )
    add(
        "--mode",
        type=Highlight,
        choices=tuple(Highlight),
        default=Highlight.FILL,
        help="how the active word is marked: 'fill' recolours the letters "
        "(default), 'background' keeps them white and paints a coloured "
        "block behind them",
    )
    add(
        "--pop",
        type=_parse_pop,
        default=NO_POP,
        help=f"how far the active word scales up, in percent (default {NO_POP}, "
        f"which holds every word at its own size; up to {MAX_POP})",
    )
    add("--words", type=int, default=3, help="max words per line (default 3)")
    add("--gap", type=float, default=0.6, help="silence gap that breaks a line (s)")
    add(
        "--font",
        choices=sorted(FONTS),
        default=DEFAULT_FONT,
        help=f"typeface to burn in (default {DEFAULT_FONT}); the script faces "
        "keep the spoken casing instead of shouting in capitals",
    )
    add(
        "--scale",
        type=float,
        default=None,
        help="font size as fraction of height (default: whatever fills a line "
        "like the chosen --font is meant to)",
    )
    add(
        "--alignment",
        type=int,
        default=2,
        help="which screen zone the captions anchor to (ASS numpad layout): "
        "1-3 = bottom left/centre/right, 4-6 = middle left/centre/right, "
        "7-9 = top left/centre/right. E.g. 2 = bottom-centre (default), "
        "8 = top-centre, 5 = dead-centre",
    )
    add(
        "--position",
        type=float,
        default=0.20,
        help="fine offset from the --alignment edge, as a fraction of video "
        "height: gap below the top edge for 7-9, gap above the bottom edge "
        "for 1-3, ignored for the vertically-centred row 4-6",
    )
    add("--model", default="small", help="faster-whisper model (default small)")
    add("--lang", default=None, help="force language code (default auto-detect)")
    add(
        "--no-cache",
        action="store_true",
        help="re-transcribe even if a cached transcript exists",
    )
    return parser.parse_args(argv)


def default_output(video: Path) -> Path:
    return video.with_name(f"{video.stem}_captioned.mp4")


def emit_completions(field: str) -> int:
    """Print candidate values for a flag so shell completion can source them."""
    for value in COMPLETIONS.get(field, ()):
        print(value)
    return 0


def main(argv: list[str]) -> int:
    if argv[:1] == ["--complete"]:
        return emit_completions(argv[1] if len(argv) > 1 else "")
    args = parse_args(argv)
    if not args.video.exists():
        sys.exit(f"no such file: {args.video}")
    ensure_runtime()
    ensure_subtitles_filter()
    CACHE.mkdir(parents=True, exist_ok=True)
    work = CACHE / "work"
    work.mkdir(exist_ok=True)
    width, height = probe_dimensions(args.video)
    style = build_style(width, height, args)
    overall = time.perf_counter()
    words = obtain_words(args.video, work, args)
    if not words:
        sys.exit("no speech detected")
    groups = group_words(words, style.max_words, style.max_gap)
    ass_path = work / "captions.ass"
    ass_path.write_text(build_ass(groups, style), encoding="utf-8")
    output = args.output or default_output(args.video)
    log(f"Rendering {output.name}...")
    started = time.perf_counter()
    burn(args.video, ass_path, ensure_font(style.font), output)
    log(f"Rendered {output.name} in {time.perf_counter() - started:.1f}s")
    log(f"Done in {time.perf_counter() - overall:.1f}s total")
    print(str(output))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

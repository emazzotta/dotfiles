#!/bin/bash
set -uo pipefail

show_usage() {
    cat <<EOF
Usage: $(basename "$0") [session]

Attach to a tmux session, or switch to it when already inside tmux.
Without one, take the only open session, or pick one with gum when
several are open. Inside tmux, the current session is left out.
EOF
}

choose_session() {
    local sessions="$1"
    if [ -t 0 ] && command -v gum >/dev/null 2>&1; then
        printf '%s\n' "$sessions" | gum choose --header "Attach to session:"
        return
    fi
    echo "tma: several tmux sessions open, pass one:" >&2
    printf '%s\n' "$sessions" | sed 's/^/  /' >&2
    return 1
}

join_session() {
    if [ -n "${TMUX:-}" ]; then
        exec tmux switch-client -t "$1"
    fi
    exec tmux attach -t "$1"
}

list_candidate_sessions() {
    if [ -z "${TMUX:-}" ]; then
        tmux list-sessions -F '#S' 2>/dev/null
        return
    fi
    local current
    current=$(tmux display-message -p '#S')
    tmux list-sessions -F '#S' | grep -vxF -- "$current"
}

main() {
    case "${1:-}" in
        -h|--help) show_usage; exit 0 ;;
        "") ;;
        *) join_session "$1" ;;
    esac

    local sessions session
    sessions=$(list_candidate_sessions)
    if [ -z "$sessions" ]; then
        echo "tma: no ${TMUX:+other }tmux sessions open" >&2
        exit 1
    fi

    if [[ "$sessions" == *$'\n'* ]]; then
        session=$(choose_session "$sessions") || exit
    else
        session=$sessions
    fi
    join_session "$session"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

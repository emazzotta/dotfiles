#!/bin/bash
set -uo pipefail

readonly namespace="personal-homepage"
readonly app="personal-homepage-file-server"
readonly deployment="deployment/${app}"
readonly webroot="/usr/share/caddy"
readonly sidecar="rsync"
# /share and /downloads both reach the same file-server (nginx rewrites /share/
# onto /downloads/), so old /downloads links stay valid; /share is the one to hand out.
readonly public_base="${FILESERVER_PUBLIC_BASE:-https://emanuelemazzotta.com/share}"

# When rsync runs us as its remote shell (--rsh "<self> __tunnel__"), tunnel into
# the sidecar container over kubectl exec instead of ssh. rsync appends the host
# (the pod name from the destination spec) and the remote command: [-l user] <pod> <cmd...>.
if [ "${1:-}" = "__tunnel__" ]; then
    shift
    [ "${1:-}" = "-l" ] && shift 2
    tunnel_pod="${1:?fileserver: tunnel mode requires a pod}"
    shift
    exec kubectl -n "$namespace" exec -i -c "$sidecar" "$tunnel_pod" -- "$@"
fi

self_path="$0"
case "$self_path" in
    */*) ;;
    *) self_path="$(command -v -- "$self_path" 2>/dev/null || printf '%s' "$self_path")" ;;
esac
readonly self_path

if [ -t 1 ]; then
    readonly c_ok=$'\033[0;32m'
    readonly c_warn=$'\033[0;33m'
    readonly c_err=$'\033[0;31m'
    readonly c_dim=$'\033[2m'
    readonly c_url=$'\033[4;36m'
    readonly c_off=$'\033[0m'
else
    readonly c_ok='' c_warn='' c_err='' c_dim='' c_url='' c_off=''
fi

ok()          { printf '%s✓%s %s\n' "$c_ok" "$c_off" "$*"; }
note()        { printf '%s%s%s\n' "$c_dim" "$*" "$c_off"; }
warn()        { printf '%s!%s %s\n' "$c_warn" "$c_off" "$*" >&2; }
fail()        { printf '%s✗%s %s\n' "$c_err" "$c_off" "$*" >&2; }
die()         { fail "$*"; exit 1; }
usage_error() { fail "$*"; exit 2; }

# C locale so slicing is byte-wise: a UTF-8 locale would hand back whole
# multibyte characters and percent-encode their code points instead of bytes.
url_encode() {
    (
        export LC_ALL=C
        local raw="$1" encoded='' index char
        for ((index = 0; index < ${#raw}; index++)); do
            char="${raw:index:1}"
            case "$char" in
                [a-zA-Z0-9._~-]) encoded+="$char" ;;
                *) printf -v char '%%%02X' "'$char"; encoded+="$char" ;;
            esac
        done
        printf '%s' "$encoded"
    )
}

public_url() {
    printf '%s/%s' "$public_base" "$(url_encode "$1")"
}

report_upload() {
    ok "uploaded ${1}"
    printf '  %s%s%s\n' "$c_url" "$(public_url "$1")" "$c_off"
}

# Canonical name first, aliases after. Single source for dispatch (CLI, bridge
# client, bridge server) and for the `--complete subcommands` endpoint that the
# shell completion reads.
subcommand_groups=(
    "list ls l"
    "upload up put push"
    "download down dl get pull"
    "remove rm del delete"
)

canonical_subcommand() {
    local group names name
    for group in "${subcommand_groups[@]}"; do
        read -r -a names <<< "$group"
        for name in "${names[@]}"; do
            [ "$name" = "$1" ] && { printf '%s' "${names[0]}"; return 0; }
        done
    done
    return 1
}

print_subcommand_groups() {
    printf '%s\n' "${subcommand_groups[@]}"
}

print_alias_help() {
    local group names joined index
    for group in "${subcommand_groups[@]}"; do
        read -r -a names <<< "$group"
        joined=''
        for ((index = 1; index < ${#names[@]}; index++)); do
            joined="${joined:+${joined}, }${names[$index]}"
        done
        printf '  %-9s %s\n' "${names[0]}" "$joined"
    done
}

# ---------------------------------------------------------------------------
# Container mode: kubectl/rsync only work on the Mac, so inside the dev
# container (/.dockerenv) forward every command to the Mac's fileserver over the
# keyguard bridge (endpoint: fileserver). The request is sent newline-separated
# (first line = subcommand); the Mac-side fileserver-bridge turns it back into
# `fileserver <args>`. Files for upload cross via the shared Desktop mount.
# ---------------------------------------------------------------------------
readonly bridge_staging="${FILESERVER_BRIDGE_STAGING:-/workspace/code/Desktop/.fileserver-staging}"
readonly bridge_url="http://host.docker.internal:7777/_bridge/fileserver"

bridge_token() {
    if [ -n "${MAC_BRIDGE_TOKEN:-}" ]; then
        printf '%s' "$MAC_BRIDGE_TOKEN"
        return 0
    fi
    # `envify VAR` evals internally and prints nothing; `source envify VAR`
    # exports it into this shell (one Touch ID on the Mac).
    # shellcheck disable=SC1091
    source envify MAC_BRIDGE_TOKEN 2>/dev/null || true
    printf '%s' "${MAC_BRIDGE_TOKEN:-}"
}

bridge_call() {
    # Args to forward are the positional params; token goes via curl --config
    # (process substitution) so it never lands in the process list.
    local token
    token=$(bridge_token)
    if [ -z "$token" ]; then
        fail "no MAC_BRIDGE_TOKEN - run 'source envify MAC_BRIDGE_TOKEN' or finish bridge setup"
        return 1
    fi
    printf '%s\n' "$@" | curl -sS --fail-with-body -X POST --data-binary @- \
        --config <(printf 'header = "Authorization: Bearer %s"' "$token") \
        "$bridge_url"
}

bridge_upload() {
    /bin/mkdir -p "$bridge_staging"
    local names=() file base source_path
    for file in "$@"; do
        [ -f "$file" ] || die "no such file: ${file}"
        base=$(basename "$file")
        source_path="$(cd "$(dirname "$file")" && pwd)/${base}"
        [ "$source_path" = "${bridge_staging}/${base}" ] || /bin/cp "$file" "${bridge_staging}/${base}"
        names+=("$base")
    done
    # Clean up the staged copies here (the container can write the mount); the Mac
    # side must not, since ~/Desktop is TCC-protected for the launchd process.
    bridge_call upload "${names[@]}" || return 1
    for base in "${names[@]}"; do /bin/rm -f "${bridge_staging}/${base}"; done
}

bridge_download() {
    /bin/mkdir -p "$bridge_staging"
    bridge_call download "$@" || return 1
    local file status=0
    for file in "$@"; do
        if [ -f "${bridge_staging}/${file}" ]; then
            /bin/mv "${bridge_staging}/${file}" "./${file}"
        else
            warn "did not arrive in the staging dir: ${file}"
            status=1
        fi
    done
    return "$status"
}

forward_via_bridge() {
    local sub="$1"
    shift
    case "$sub" in
        list)     bridge_call list ;;
        remove)   [ "$#" -ge 1 ] || usage_error "remove needs a filename"; bridge_call remove "$@" ;;
        upload)   [ "$#" -ge 1 ] || usage_error "upload needs a file"; bridge_upload "$@" ;;
        download) [ "$#" -ge 1 ] || usage_error "download needs a filename"; bridge_download "$@" ;;
    esac
}

# kubectl exec needs a TTY only when we have one; the bridge runs us headless,
# where -t would fail with "the input device is not a TTY".
kube_exec_flags() {
    if [ -t 0 ] && [ -t 1 ]; then printf '%s' '-ti'; else printf '%s' '-i'; fi
}

print_help() {
    local self
    self=$(basename "$0")
    cat <<EOF
${self} - manage files on the personal-homepage file-server pod.

Usage:
  ${self} <command> [file...]

Commands:
  list                 List files stored on the server
  upload   <file>...   Copy one or more local files to the server
  download <file>...   Copy one or more files from the server into the current directory
  remove   <file>...   Delete one or more files on the server

Aliases:
$(print_alias_help)

Options:
  -h, --help           Show this help and exit

Transfers:
  upload/download use rsync over the "${sidecar}" sidecar container and resume
  interrupted transfers on re-run. Falls back to kubectl cp when rsync is
  not installed locally.

Target:
  namespace  ${namespace}
  deployment ${deployment}
  directory  ${webroot}
  public URL ${public_base}/<file>

Examples:
  ${self} list
  ${self} up report.pdf photo.jpg
  ${self} get report.pdf
  ${self} rm old.txt stale.log
EOF
}

find_pod() {
    local pod
    pod=$(kubectl get pod -n "$namespace" -l "app=${app}" \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    [ -n "$pod" ] || die "no ${app} pod in namespace ${namespace}"
    printf '%s' "$pod"
}

# True when the pod actually carries the rsync sidecar. Some rollouts ship only
# the caddy container; there we fall back to `kubectl cp` (caddy's busybox tar).
pod_has_sidecar() {
    kubectl -n "$namespace" get pod "$1" \
        -o jsonpath='{.spec.containers[*].name}' 2>/dev/null | tr ' ' '\n' | grep -qx "$sidecar"
}

# Resumable transfer over the rsync sidecar. --partial keeps interrupted files so
# a re-run continues instead of restarting; --partial-dir keeps them out of the
# served web root until complete.
rsync_transfer() {
    rsync -a --partial --partial-dir=.fileserver-partial --progress \
        --rsh "$self_path __tunnel__" "$@"
}

list_files() {
    note "files on ${public_base}/"
    # $0/$@ are expanded by the remote sh, not bash - single quotes are intentional.
    # shellcheck disable=SC2016
    kubectl -n "$namespace" exec "$(kube_exec_flags)" "$deployment" -- /bin/sh -c 'cd "$0" && ls -al' "$webroot"
}

remove_files() {
    [ "$#" -ge 1 ] || usage_error "usage: $(basename "$0") remove <file> [file...]"
    local report line status name failed=0
    # No -t: the report is parsed, and a TTY would append CR to every line.
    # shellcheck disable=SC2016
    report=$(kubectl -n "$namespace" exec "$deployment" -- /bin/sh -c '
        cd "$0" || exit 1
        for target in "$@"; do
            if [ -e "$target" ]; then
                rm -rf "$target" && echo "removed:${target}" || echo "failed:${target}"
            else
                echo "missing:${target}"
            fi
        done' "$webroot" "$@") || die "remove failed: could not reach ${deployment}"

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        status="${line%%:*}"
        name="${line#*:}"
        case "$status" in
            removed) ok "removed ${name}" ;;
            missing) warn "not on the server: ${name}" ;;
            *)       fail "could not remove ${name}"; failed=1 ;;
        esac
    done <<< "$report"
    return "$failed"
}

upload_files() {
    [ "$#" -ge 1 ] || usage_error "usage: $(basename "$0") upload <file> [file...]"
    local pod file
    pod=$(find_pod) || exit 1
    if command -v rsync >/dev/null 2>&1 && pod_has_sidecar "$pod"; then
        rsync_transfer "$@" "${pod}:${webroot}/" || die "upload failed"
    else
        for file in "$@"; do
            kubectl -n "$namespace" cp "$file" "${pod}:${webroot}/$(basename "$file")" \
                || die "upload failed: $(basename "$file")"
        done
    fi
    for file in "$@"; do
        report_upload "$(basename "$file")"
    done
}

download_files() {
    [ "$#" -ge 1 ] || usage_error "usage: $(basename "$0") download <file> [file...]"
    local pod file use_rsync=0
    pod=$(find_pod) || exit 1
    if command -v rsync >/dev/null 2>&1 && pod_has_sidecar "$pod"; then
        use_rsync=1
    fi
    for file in "$@"; do
        if [ "$use_rsync" -eq 1 ]; then
            rsync_transfer "${pod}:${webroot}/${file}" . || die "download failed: ${file}"
        else
            kubectl -n "$namespace" cp "${pod}:${webroot}/${file}" . || die "download failed: ${file}"
        fi
        ok "downloaded ${file}"
    done
}

# Bridge-serve mode: invoked by the keyguard bridge as `fileserver __bridge_serve__`
# with the request piped to stdin (newline-separated; first line = subcommand).
# Turns it back into a native call, resolving upload/download files against the
# shared staging dir. Only the four allowlisted subcommands run - anything else
# is rejected, so the bridge cannot drive arbitrary commands.
serve_bridge() {
    # launchd runs the keyguard server with a minimal env - no PATH to Homebrew
    # and none of the shell-rc exports, so kubectl would default to localhost:8080.
    # Restore the bits the native path needs.
    export PATH="/opt/homebrew/bin:/usr/local/bin:${PATH}"
    [ -n "${KUBECONFIG:-}" ] || export KUBECONFIG="${HOME}/.kube/personal-infra.yaml"
    local staging="${FILESERVER_BRIDGE_STAGING:-${HOME}/Desktop/.fileserver-staging}"
    local args=() line
    while IFS= read -r line; do args+=("$line"); done
    [ "${#args[@]}" -ge 1 ] || die "empty bridge request"

    local sub rest=() i
    sub=$(canonical_subcommand "${args[0]}") || die "unsupported bridge subcommand: ${args[0]}"
    for ((i = 1; i < ${#args[@]}; i++)); do rest+=("${args[$i]}"); done

    case "$sub" in
        list)
            list_files
            ;;
        remove)
            [ "${#rest[@]}" -ge 1 ] || usage_error "remove needs filenames"
            remove_files "${rest[@]}"
            ;;
        upload)
            [ "${#rest[@]}" -ge 1 ] || usage_error "upload needs filenames"
            local paths=() name
            for name in "${rest[@]}"; do
                [ -f "${staging}/${name}" ] || die "not staged: ${name}"
                paths+=("${staging}/${name}")
            done
            upload_files "${paths[@]}"
            # Cleanup is the container's job (it can write the Desktop mount; the
            # launchd process cannot, due to macOS TCC).
            ;;
        download)
            [ "${#rest[@]}" -ge 1 ] || usage_error "download needs filenames"
            /bin/mkdir -p "$staging"
            ( cd "$staging" && download_files "${rest[@]}" )
            ;;
    esac
}

main() {
    case "${1:-}" in
        __bridge_serve__) serve_bridge; return $? ;;
        --complete)
            [ "${2:-}" = "subcommands" ] || return 1
            print_subcommand_groups
            return 0
            ;;
        -h | --help | "") print_help; return 0 ;;
    esac

    local sub
    sub=$(canonical_subcommand "$1") || { fail "invalid command: $1"; print_help >&2; return 2; }
    shift

    if [ -f /.dockerenv ]; then
        forward_via_bridge "$sub" "$@"
        return $?
    fi

    case "$sub" in
        list)     list_files ;;
        upload)   upload_files "$@" ;;
        download) download_files "$@" ;;
        remove)   remove_files "$@" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

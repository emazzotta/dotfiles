#!/bin/bash

function repo_alias_path() {
    awk -v name="${1}" '$1 == name { print $2; exit }' "${CUSTOM_BIN_DIR}/repo-aliases" 2>/dev/null
}

function repo_candidates() {
    awk '!/^#/ && NF == 2 { print $2 }' "${CUSTOM_BIN_DIR}/repo-aliases" 2>/dev/null
    find "${1}" -mindepth 2 -maxdepth 2 -type d | sed "s|^${1}/||"
}

function fuzzy_find_path() {
    result=$(repo_alias_path "${2}")
    test "${result}" || result=$(repo_candidates "${1}" | fzf -f "${2}" | head -n 1)
    test "${result}" && echo "${1}/${result}" || echo "${1}"
}

test "${argv}" && \
    cd $(fuzzy_find_path "${WDIR}" "${argv}") || \
    echo $(fuzzy_find_path "${WDIR}" "${1}")

#!/usr/bin/env python3
"""Sync Claude Code transcripts between this Mac and the dev box, and mirror the workspace config to it.

Every push also mirrors the tracked files of the opencode workspace tree to the dev box's /workspace,
minus LEFT_OUT and anything a git filter rewrites, and the installed plugins (PLUGIN_INSTALL) to its
~/.claude/plugins, and keeps enabledPlugins plus DEVBOX_SETTINGS in step in its ~/.claude/settings.json.
The Mac is the source of truth; the dev box keeps its own copy of DEVBOX_STATE and its other settings.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

SYNC_PATHS = ("projects", "file-history", "tasks", "paste-cache")
SSH_COMMAND = ("ssh -o BatchMode=yes -o ConnectTimeout=5 -o RequestTTY=no"
               " -o ControlMaster=auto -o ControlPath=~/.ssh/claude-sync-%C -o ControlPersist=60")
RSYNC_TIMEOUT_SECONDS = 20
MAX_LOG_BYTES = 1_000_000
UUID_PATTERN = re.compile(r"^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")

DEFAULT_HOME = "~/.claude"
DEFAULT_REMOTE = "devbox"
DEFAULT_REMOTE_HOME = "/home/opencode/.claude"
DEFAULT_WORKSPACE_REPO = "~/Projects/private/opencode"
DEFAULT_REMOTE_WORKSPACE = "/workspace"
WORKSPACE_TREE = "opencode/workspace"
GITLINK_MODE = "160000 "
UNFILTERED = ("unspecified", "unset")
# Relative to the workspace tree: never sent, and a dev box copy is left alone.
LEFT_OUT = (".claude/knowledge/private/", ".claude/knowledge/work/", ".claude/knowledge/sources/",
            ".claude/knowledge/secreviews/", ".claude/hooks/", ".claude/plugins/",
            ".claude/settings.json", ".claude/settings.local.json")
# What the opencode .gitignore keeps local; the dev box's own copy must survive --delete.
DEVBOX_STATE = (".claude/*-reference/", ".claude/knowledge/memory/????-??-??.md",
                ".claude/knowledge/content/", ".claude/.obsidian/", ".claude/scheduled_tasks.lock")
# What makes a plugin installed; synced/, data/ and the ssh mirrors stay per machine.
PLUGIN_INSTALL = ("installed_plugins.json", "known_marketplaces.json", "marketplaces", "cache")
MARKETPLACE_REGISTRY = "known_marketplaces.json"
# Owned by claude-sync in the dev box's settings.json, next to enabledPlugins copied from the Mac.
DEVBOX_SETTINGS = {"syncClaudeAiPlugins": False, "syncClaudeAiSkills": False, "disableClaudeAiConnectors": True}
RSYNC_MISSING_SOURCE = 23


def local_home() -> Path:
    return Path(os.environ.get("CLAUDE_HOME", DEFAULT_HOME)).expanduser()


def remote_base() -> str:
    remote = os.environ.get("CLAUDE_SYNC_REMOTE", DEFAULT_REMOTE)
    home = os.environ.get("CLAUDE_SYNC_REMOTE_HOME", DEFAULT_REMOTE_HOME)
    return f"{remote}:{home.rstrip('/')}"


def workspace_repo() -> Path:
    return Path(os.environ.get("CLAUDE_SYNC_WORKSPACE_REPO", DEFAULT_WORKSPACE_REPO)).expanduser()


def remote_workspace() -> str:
    remote = os.environ.get("CLAUDE_SYNC_REMOTE", DEFAULT_REMOTE)
    path = os.environ.get("CLAUDE_SYNC_REMOTE_WORKSPACE", DEFAULT_REMOTE_WORKSPACE)
    return f"{remote}:{path.rstrip('/')}"


def log(home: Path, message: str) -> None:
    logfile = home / "claude-sync.log"
    try:
        if logfile.exists() and logfile.stat().st_size > MAX_LOG_BYTES:
            logfile.replace(logfile.with_suffix(".log.1"))
        with open(logfile, "a") as handle:
            handle.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}\n")
    except OSError:
        pass


def find_live_sessions(home: Path) -> list[str]:
    live = set()
    for entry in sorted((home / "sessions").glob("*.json")):
        try:
            record = json.loads(entry.read_text())
        except (OSError, ValueError):
            continue
        session_id = record.get("sessionId")
        if record.get("status") == "running" and isinstance(session_id, str):
            live.add(session_id)
    return sorted(live)


def rsync_command(sources: list[str], destination: str, excludes: list[str]) -> list[str]:
    command = [
        "rsync", "-a", "--update",
        f"--timeout={RSYNC_TIMEOUT_SECONDS}",
        "-e", SSH_COMMAND,
    ]
    command += [f"--exclude={session}*" for session in excludes]
    return command + sources + [destination]


def relative(command: list[str]) -> list[str]:
    """One invocation carrying several paths, so the whole sync costs one rsync and one ssh."""
    return command[:1] + ["--relative"] + command[1:]


def full_transfers(home: Path, pull: bool, excludes: list[str]) -> list[list[str]]:
    if pull:
        # No trailing slash: with one, rsync copies each source's *contents* into
        # the destination and flattens every path into the config root.
        return [rsync_command([f"{remote_base()}/{name}" for name in SYNC_PATHS],
                              f"{home}/", excludes)]
    present = [name for name in SYNC_PATHS if (home / name).is_dir()]
    if not present:
        return []
    return [relative(rsync_command([f"{home}/./{name}/" for name in present],
                                   f"{remote_base()}/", excludes))]


def session_transfers(home: Path, session: str) -> list[list[str]]:
    sources = [str(path) for path in sorted((home / "projects").glob(f"*/{session}.jsonl"))]
    for name in ("file-history", "tasks"):
        if (home / name / session).is_dir():
            sources.append(f"{home / name / session}/")
    if (home / "paste-cache").is_dir():
        sources.append(f"{home / 'paste-cache'}/")
    if not sources:
        return []
    rooted = [source.replace(str(home) + "/", str(home) + "/./", 1) for source in sources]
    return [relative(rsync_command(rooted, f"{remote_base()}/", []))]


def git(repo: Path, *args: str, stdin: str = "") -> str:
    return subprocess.run(["git", "-C", str(repo), *args], input=stdin, capture_output=True,
                          encoding="utf-8", check=True).stdout


def tracked_paths(repo: Path) -> list[str]:
    entries = git(repo, "ls-files", "-z", "-s", "--", WORKSPACE_TREE).split("\0")
    paths = [entry.split("\t", 1)[1] for entry in entries if entry and not entry.startswith(GITLINK_MODE)]
    return list(dict.fromkeys(paths))


def filtered_paths(repo: Path, paths: list[str]) -> set[str]:
    """A filter such as git-crypt means the file on disk is not what git stores."""
    fields = git(repo, "check-attr", "-z", "filter", "--stdin", stdin="\0".join(paths)).split("\0")
    return {fields[i] for i in range(0, len(fields) - 2, 3) if fields[i + 2] not in UNFILTERED}


def left_out(relative: str) -> bool:
    """Also true for a directory holding a left-out part: a symlink to it would carry that part along."""
    path = relative.rstrip("/")
    if path in ("", "."):
        return True
    bases = (rule.rstrip("/") for rule in LEFT_OUT)
    return any(path == base or path.startswith(f"{base}/") or base.startswith(f"{path}/") for base in bases)


def mirrorable(repo: Path) -> list[str]:
    tracked = tracked_paths(repo)
    rewritten = filtered_paths(repo, tracked)
    prefix = len(WORKSPACE_TREE) + 1
    relatives = [path[prefix:] for path in tracked if path not in rewritten]
    return [relative for relative in relatives if not left_out(relative)]


def safe_source(root: Path, source: Path) -> bool:
    """A symlink may only pull content from inside the workspace tree, never from a left-out part."""
    try:
        return not left_out(source.relative_to(root).as_posix())
    except ValueError:
        return False


def stage(tree: Path, relatives: list[str], staging: Path) -> None:
    root = tree.resolve()
    for relative in relatives:
        source = (tree / relative).resolve()
        if not source.exists() or not safe_source(root, source):
            continue
        target = staging / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_dir():
            # A link nested in a linked directory is copied as a link, never followed.
            shutil.copytree(source, target, symlinks=True)
        else:
            shutil.copy2(source, target)


def mirror_rsync() -> list[str]:
    """The Mac wins: no --update, and --delete inside every directory sent."""
    return ["rsync", "-a", "--delete", f"--timeout={RSYNC_TIMEOUT_SECONDS}", "-e", SSH_COMMAND]


def mirror_transfers(staging: Path) -> list[list[str]]:
    """Staged directories mirror with --delete; the remote /workspace keeps its own top-level entries."""
    sources = [f"{staging}/./{entry.name}{'/' if entry.is_dir() else ''}" for entry in sorted(staging.iterdir())]
    if not sources:
        return []
    # An excluded path is never deleted on the receiving side either.
    excludes = [f"--exclude=/{pattern}" for pattern in LEFT_OUT + DEVBOX_STATE]
    return [relative(mirror_rsync() + excludes + sources + [f"{remote_workspace()}/"])]


def mirror_workspace(home: Path, stream: bool) -> int:
    repo = workspace_repo()
    tree = repo / WORKSPACE_TREE
    if not tree.is_dir():
        return 0
    with tempfile.TemporaryDirectory() as staging:
        try:
            stage(tree, mirrorable(repo), Path(staging))
        except (OSError, subprocess.CalledProcessError) as error:
            log(home, f"workspace mirror skipped: {error}")
            return 1
        return transfer(home, mirror_transfers(Path(staging)), stream)


def stage_marketplaces(source: Path, staging: Path) -> str:
    """The dev box never fetches a marketplace itself: its SSH remotes need a key it does not hold."""
    registry = json.loads(source.read_text())
    for marketplace in registry.values():
        marketplace["autoUpdate"] = False
    target = staging / "plugins" / source.name
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(registry, indent=2) + "\n")
    shutil.copystat(source, target)
    return f"{staging}/./plugins/{source.name}"


def plugin_source(home: Path, staging: Path, name: str) -> str:
    source = home / "plugins" / name
    if name == MARKETPLACE_REGISTRY:
        return stage_marketplaces(source, staging)
    return f"{home}/./plugins/{name}{'/' if source.is_dir() else ''}"


def mirror_plugins(home: Path, stream: bool) -> int:
    present = [name for name in PLUGIN_INSTALL if (home / "plugins" / name).exists()]
    if not present:
        return 0
    with tempfile.TemporaryDirectory() as staging:
        try:
            sources = [plugin_source(home, Path(staging), name) for name in present]
        except (OSError, ValueError) as error:
            log(home, f"plugin mirror skipped: {error}")
            return 1
        return transfer(home, [relative(mirror_rsync() + sources + [f"{remote_base()}/"])], stream)


def merged_settings(mac: dict, box: dict) -> dict:
    """The box keeps its own keys; plugins switch on and off as on the Mac, and claude.ai stays out."""
    merged = {**box, **DEVBOX_SETTINGS}
    if "enabledPlugins" in mac:
        merged["enabledPlugins"] = mac["enabledPlugins"]
    return merged


def pull_devbox_settings(home: Path, target: Path) -> bool:
    """False unless the box's file arrived or provably does not exist: a push after any other failure would wipe it."""
    command = mirror_rsync() + [f"{remote_base()}/settings.json", str(target)]
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    missing = result.returncode == RSYNC_MISSING_SOURCE and "No such file or directory" in result.stderr
    if result.returncode != 0 and not missing:
        log(home, f"settings sync skipped: rsync exit {result.returncode}: {result.stderr.strip()}")
        return False
    return True


def sync_devbox_settings(home: Path, stream: bool) -> int:
    """Read the box's file, change only the owned keys, and write it back only when they differ."""
    mac_file = home / "settings.json"
    if not mac_file.is_file():
        return 0
    with tempfile.TemporaryDirectory() as staging:
        box_file = Path(staging) / "settings.json"
        if not pull_devbox_settings(home, box_file):
            return 1
        try:
            box = json.loads(box_file.read_text()) if box_file.is_file() else {}
            merged = merged_settings(json.loads(mac_file.read_text()), box)
        except (OSError, ValueError) as error:
            log(home, f"settings sync skipped: {error}")
            return 1
        if merged == box:
            return 0
        box_file.write_text(json.dumps(merged, indent=2) + "\n")
        return transfer(home, [mirror_rsync() + [str(box_file), f"{remote_base()}/settings.json"]], stream)


def mirror_to_devbox(home: Path, stream: bool) -> int:
    return mirror_workspace(home, stream) + mirror_plugins(home, stream) + sync_devbox_settings(home, stream)


def invoker() -> str:
    """A failure that names who started it beats guessing which caller has the broken environment."""
    try:
        parent = subprocess.run(["ps", "-o", "comm=", "-p", str(os.getppid())],
                                capture_output=True, text=True, timeout=2).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        parent = "unknown"
    agent = "agent" if os.environ.get("SSH_AUTH_SOCK") else "no-agent"
    return f"{parent or 'unknown'}, {agent}"


def interactive() -> bool:
    return sys.stderr.isatty()


def transfer(home: Path, commands: list[list[str]], stream: bool = False) -> int:
    failures = 0
    for command in commands:
        if stream:
            command = command[:1] + ["--info=progress2"] + command[1:]
        result = subprocess.run(command, capture_output=not stream, text=True)
        if result.returncode != 0:
            failures += 1
            detail = (result.stderr or "").strip()
            log(home, f"rsync exit {result.returncode} [{invoker()}, home={os.environ.get('HOME', '?')}]"
                      f" -> {command[-1]}: {detail}")
            if interactive() and not stream:
                sys.stderr.write(f"claude-sync: {detail}\n")
    return failures


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="claude-sync",
        description="Sync Claude Code transcripts between this Mac and the dev box,"
                    " and mirror the workspace config and plugins to it on every push.",
    )
    direction = parser.add_mutually_exclusive_group()
    direction.add_argument("--push", action="store_true", help="local to remote only")
    direction.add_argument("--pull", action="store_true", help="remote to local only")
    direction.add_argument("--both", action="store_true", help="both directions (default)")
    parser.add_argument("--session", metavar="UUID", help="push one finished session")
    parser.add_argument("--push-stdin", action="store_true", help="push the session id read from stdin")
    parser.add_argument("-v", "--verbose", action="store_true", help="stream rsync progress instead of swallowing it")
    return parser.parse_args(argv)


def resolve_session(args: argparse.Namespace) -> str | None:
    session = sys.stdin.read().strip() if args.push_stdin else args.session
    if session is None:
        return None
    if not UUID_PATTERN.match(session):
        sys.stderr.write(f"claude-sync: not a session id: {session}\n")
        raise SystemExit(2)
    return session


def hold_lock(home: Path):
    lock = home / "claude-sync.lock"
    try:
        handle = open(lock, "a")
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return None
    return handle


def wrong_host() -> bool:
    """devbox_key and the tailnet route live on the Mac; in the container the default remote can only fail confusingly."""
    return Path("/.dockerenv").exists() and "CLAUDE_SYNC_REMOTE" not in os.environ


def announce(message: str) -> None:
    if interactive():
        sys.stderr.write(f"claude-sync: {message}\n")


def report(failures: int, done: str) -> int:
    """A hook or a detached launch must never fail; a person at a terminal must never be left guessing."""
    if not failures:
        announce(done)
        return 0
    return 1 if interactive() else 0


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if wrong_host():
        announce("runs on the Mac host, not inside the container")
        return 0
    session = resolve_session(args)
    home = local_home()
    if not home.is_dir():
        return 0

    handle = hold_lock(home)
    if handle is None:
        announce("another sync is already running, nothing to do")
        return 0

    if session:
        failures = transfer(home, session_transfers(home, session), args.verbose)
        return report(failures + mirror_to_devbox(home, args.verbose), "pushed session")

    excludes = find_live_sessions(home)
    failures = 0
    if not args.pull:
        failures += transfer(home, full_transfers(home, pull=False, excludes=excludes), args.verbose)
        failures += mirror_to_devbox(home, args.verbose)
    if not args.push:
        failures += transfer(home, full_transfers(home, pull=True, excludes=excludes), args.verbose)
    return report(failures, "up to date")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

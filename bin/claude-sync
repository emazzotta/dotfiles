#!/usr/bin/env python3
"""Sync Claude Code transcripts between this Mac and the dev box."""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

SYNC_PATHS = ("projects", "file-history", "tasks", "paste-cache")
SSH_COMMAND = "ssh -o BatchMode=yes -o ConnectTimeout=5 -o RequestTTY=no"
RSYNC_TIMEOUT_SECONDS = 20
MAX_LOG_BYTES = 1_000_000
UUID_PATTERN = re.compile(r"^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")

DEFAULT_HOME = "~/.claude"
DEFAULT_REMOTE = "devbox"
DEFAULT_REMOTE_HOME = "/home/opencode/.claude"


def local_home() -> Path:
    return Path(os.environ.get("CLAUDE_HOME", DEFAULT_HOME)).expanduser()


def remote_base() -> str:
    remote = os.environ.get("CLAUDE_SYNC_REMOTE", DEFAULT_REMOTE)
    home = os.environ.get("CLAUDE_SYNC_REMOTE_HOME", DEFAULT_REMOTE_HOME)
    return f"{remote}:{home.rstrip('/')}"


def log(home: Path, message: str) -> None:
    logfile = home / "claude-sync.log"
    try:
        if logfile.exists() and logfile.stat().st_size > MAX_LOG_BYTES:
            logfile.replace(logfile.with_suffix(".log.1"))
        with open(logfile, "a") as handle:
            handle.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}\n")
    except OSError:
        pass


def find_live_sessions(home: Path) -> list[str]:
    live = set()
    for entry in sorted((home / "sessions").glob("*.json")):
        try:
            record = json.loads(entry.read_text())
        except (OSError, ValueError):
            continue
        session_id = record.get("sessionId")
        if record.get("status") == "running" and isinstance(session_id, str):
            live.add(session_id)
    return sorted(live)


def rsync_command(sources: list[str], destination: str, excludes: list[str]) -> list[str]:
    command = [
        "rsync", "-a", "--update",
        f"--timeout={RSYNC_TIMEOUT_SECONDS}",
        "-e", SSH_COMMAND,
    ]
    command += [f"--exclude={session}*" for session in excludes]
    return command + sources + [destination]


def full_transfers(home: Path, pull: bool, excludes: list[str]) -> list[list[str]]:
    transfers = []
    for name in SYNC_PATHS:
        local = f"{home / name}/"
        remote = f"{remote_base()}/{name}/"
        if pull:
            transfers.append(rsync_command([remote], local, excludes))
        elif (home / name).is_dir():
            transfers.append(rsync_command([local], remote, excludes))
    return transfers


def session_transfers(home: Path, session: str) -> list[list[str]]:
    sources = [str(path) for path in sorted((home / "projects").glob(f"*/{session}.jsonl"))]
    for name in ("file-history", "tasks"):
        if (home / name / session).is_dir():
            sources.append(f"{home / name / session}/")
    if (home / "paste-cache").is_dir():
        sources.append(f"{home / 'paste-cache'}/")
    if not sources:
        return []
    relative = [source.replace(str(home) + "/", str(home) + "/./", 1) for source in sources]
    command = rsync_command(relative, f"{remote_base()}/", [])
    command.insert(1, "--relative")
    return [command]


def interactive() -> bool:
    return sys.stderr.isatty()


def transfer(home: Path, commands: list[list[str]], stream: bool = False) -> int:
    failures = 0
    for command in commands:
        if stream:
            command = command[:1] + ["--info=progress2"] + command[1:]
        result = subprocess.run(command, capture_output=not stream, text=True)
        if result.returncode != 0:
            failures += 1
            detail = (result.stderr or "").strip()
            log(home, f"rsync exit {result.returncode}: {detail}")
            if interactive() and not stream:
                sys.stderr.write(f"claude-sync: {detail}\n")
    return failures


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="claude-sync",
        description="Sync Claude Code transcripts between this Mac and the dev box.",
    )
    direction = parser.add_mutually_exclusive_group()
    direction.add_argument("--push", action="store_true", help="local to remote only")
    direction.add_argument("--pull", action="store_true", help="remote to local only")
    direction.add_argument("--both", action="store_true", help="both directions (default)")
    parser.add_argument("--session", metavar="UUID", help="push one finished session")
    parser.add_argument("--push-stdin", action="store_true", help="push the session id read from stdin")
    parser.add_argument("-v", "--verbose", action="store_true", help="stream rsync progress instead of swallowing it")
    return parser.parse_args(argv)


def resolve_session(args: argparse.Namespace) -> str | None:
    session = sys.stdin.read().strip() if args.push_stdin else args.session
    if session is None:
        return None
    if not UUID_PATTERN.match(session):
        sys.stderr.write(f"claude-sync: not a session id: {session}\n")
        raise SystemExit(2)
    return session


def hold_lock(home: Path):
    lock = home / "claude-sync.lock"
    try:
        handle = open(lock, "a")
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return None
    return handle


def wrong_host() -> bool:
    """devbox_key and the tailnet route live on the Mac; in the container the default remote can only fail confusingly."""
    return Path("/.dockerenv").exists() and "CLAUDE_SYNC_REMOTE" not in os.environ


def announce(message: str) -> None:
    if interactive():
        sys.stderr.write(f"claude-sync: {message}\n")


def report(failures: int, done: str) -> int:
    """A hook or a detached launch must never fail; a person at a terminal must never be left guessing."""
    if not failures:
        announce(done)
        return 0
    return 1 if interactive() else 0


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if wrong_host():
        announce("runs on the Mac host, not inside the container")
        return 0
    session = resolve_session(args)
    home = local_home()
    if not home.is_dir():
        return 0

    handle = hold_lock(home)
    if handle is None:
        announce("another sync is already running, nothing to do")
        return 0

    if session:
        return report(transfer(home, session_transfers(home, session), args.verbose), "pushed session")

    excludes = find_live_sessions(home)
    failures = 0
    if not args.pull:
        failures += transfer(home, full_transfers(home, pull=False, excludes=excludes), args.verbose)
    if not args.push:
        failures += transfer(home, full_transfers(home, pull=True, excludes=excludes), args.verbose)
    return report(failures, "up to date")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

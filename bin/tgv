#!/bin/bash
set -uo pipefail

# shellcheck source=telegramlib.sh
source "$(dirname "${BASH_SOURCE[0]}")/telegramlib.sh"

telegram_usage_guard "<audio_file> [user] [bot key]" "$@"
telegram_target "${2:-}" "${3:-}" || exit 1

echo "Sending voice to ${TELEGRAM_CHAT}..."
http --body -f POST "${TELEGRAM_URL}/sendVoice" chat_id=="${TELEGRAM_CHAT}" voice@"${1}"

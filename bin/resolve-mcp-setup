#!/bin/bash
# Idempotent Mac-side setup for the DaVinci Resolve MCP server (Studio path).
# Safe to run before Studio is installed: it prepares everything and reports
# what is still missing. Re-run after installing Studio to verify.
set -euo pipefail

readonly REPO_URL="https://github.com/samuelgursky/davinci-resolve-mcp.git"
readonly REPO_DIR="${RESOLVE_MCP_HOME:-$HOME/.local/share/davinci-resolve-mcp}"
readonly CONFIG_DIR="$HOME/.config/davinci-resolve-mcp"
readonly TOKEN_FILE="$CONFIG_DIR/mcp-token"
readonly LAUNCHER="$HOME/.local/bin/resolve-mcp-serve"
readonly SERVE_PORT=49633
readonly SCRIPT_API="/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting"
readonly SCRIPT_LIB="/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so"

GREEN='\033[0;32m'; YELLOW='\033[0;33m'; RED='\033[0;31m'; RESET='\033[0m'
log()  { printf "${GREEN}==>${RESET} %s\n" "$*"; }
warn() { printf "${YELLOW}[!]${RESET} %s\n" "$*"; }
fail() { printf "${RED}ERROR:${RESET} %s\n" "$*" >&2; exit 1; }

show_usage() {
    cat <<EOF
Usage: $(basename "$0") [--help]

Prepares the DaVinci Resolve MCP server on this Mac:
  - clones/updates $REPO_DIR
  - builds a venv on the most ABI-safe Python available
  - generates the loopback bearer token shared with the container bridge
  - writes the $LAUNCHER launcher

Idempotent. Run it now, and again once Resolve Studio is installed.
EOF
}

# Resolve's fusionscript.so is a native CPython extension; upstream reports
# 3.10-3.12 as lowest-risk and 3.13+ as able to fail with no connection.
find_best_python() {
    local candidate
    for candidate in python3.12 python3.11 python3.10 python3.13 python3; do
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s' "$(command -v "$candidate")"
            return 0
        fi
    done
    return 1
}

check_prerequisites() {
    command -v git >/dev/null 2>&1 || fail "git not found - install Xcode Command Line Tools"
    [ -d "$SCRIPT_API" ] || warn "Resolve scripting API not found at $SCRIPT_API"
}

sync_repository() {
    if [ -d "$REPO_DIR/.git" ]; then
        log "Updating $REPO_DIR"
        git -C "$REPO_DIR" pull --ff-only || warn "pull failed - leaving the checkout as is"
        return
    fi
    log "Cloning into $REPO_DIR"
    /bin/mkdir -p "$(dirname "$REPO_DIR")"
    git clone --depth 1 "$REPO_URL" "$REPO_DIR"
}

build_environment() {
    local python="$1" version
    version=$("$python" --version 2>&1)
    log "Building venv with $version ($python)"
    case "$version" in
        *3.13*|*3.14*)
            warn "$version is outside upstream's 3.10-3.12 low-risk range."
            warn "If Resolve tools later return no connection, install python@3.12 and re-run."
            ;;
    esac
    "$python" "$REPO_DIR/install.py" --clients manual --python "$python"
}

ensure_token() {
    /bin/mkdir -p "$CONFIG_DIR"
    /bin/chmod 700 "$CONFIG_DIR"
    if [ -s "$TOKEN_FILE" ]; then
        log "Reusing existing token at $TOKEN_FILE"
        return
    fi
    log "Generating bearer token at $TOKEN_FILE"
    /usr/bin/openssl rand -hex 32 >"$TOKEN_FILE"
    /bin/chmod 600 "$TOKEN_FILE"
}

write_launcher() {
    log "Writing $LAUNCHER"
    /bin/mkdir -p "$(dirname "$LAUNCHER")"
    cat >"$LAUNCHER" <<LAUNCHER_EOF
#!/bin/bash
# Serves the DaVinci Resolve MCP over authenticated loopback for the container.
# Generated by resolve-mcp-setup - re-run that script to regenerate.
set -euo pipefail

readonly REPO="$REPO_DIR"
readonly TOKEN_FILE="$TOKEN_FILE"

[ -s "\$TOKEN_FILE" ] || { echo "no token at \$TOKEN_FILE - run resolve-mcp-setup" >&2; exit 1; }
[ -x "\$REPO/venv/bin/python" ] || { echo "no venv at \$REPO - run resolve-mcp-setup" >&2; exit 1; }

export RESOLVE_SCRIPT_API="$SCRIPT_API"
export RESOLVE_SCRIPT_LIB="$SCRIPT_LIB"
export PYTHONPATH="$SCRIPT_API/Modules/"
export DAVINCI_MCP_HOST=127.0.0.1
export DAVINCI_MCP_PORT=$SERVE_PORT
DAVINCI_MCP_TOKEN=\$(cat "\$TOKEN_FILE")
export DAVINCI_MCP_TOKEN

echo "Serving Resolve MCP on 127.0.0.1:$SERVE_PORT (loopback only)"
exec "\$REPO/venv/bin/python" "\$REPO/src/server.py" --transport streamable-http
LAUNCHER_EOF
    /bin/chmod u+x "$LAUNCHER"
}

report_readiness() {
    printf '\n'
    log "Setup complete. Readiness:"
    printf '  scripting API:   %s\n' "$([ -d "$SCRIPT_API" ] && echo present || echo MISSING)"
    printf '  fusionscript.so: %s\n' "$([ -f "$SCRIPT_LIB" ] && echo present || echo MISSING)"
    printf '  venv:            %s\n' "$([ -x "$REPO_DIR/venv/bin/python" ] && echo built || echo MISSING)"
    printf '  token:           %s\n' "$([ -s "$TOKEN_FILE" ] && echo present || echo MISSING)"
    printf '\nOnce Resolve Studio is installed:\n'
    printf '  1. Resolve > Preferences > System > General > External scripting using = Local\n'
    printf '  2. Start Resolve and open a project\n'
    printf '  3. Run: %s\n' "$LAUNCHER"
}

main() {
    if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
        show_usage
        return 0
    fi
    check_prerequisites
    local python
    python=$(find_best_python) || fail "no python3 found"

    # Token and launcher first: they cost nothing, depend on no network or
    # Resolve install, and must survive a failed clone or venv build so the
    # script stays resumable.
    ensure_token
    write_launcher

    sync_repository || warn "repository sync failed - re-run once resolved"
    build_environment "$python" || warn "venv build failed - re-run once resolved"
    report_readiness
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

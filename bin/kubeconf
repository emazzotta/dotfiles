#!/bin/bash
set -uo pipefail

usage() {
    echo "usage: $(basename "${0}") <provider name>"
}

main() {
    case "${1:-}" in
        -h|--help)
            usage
            return 0
            ;;
        "")
            usage >&2
            return 1
            ;;
    esac

    local config="${KUBE_DIR}/${1}-kubeconfig.yaml"
    if [ ! -f "${config}" ]; then
        echo "Error: kubeconfig not found: ${config}" >&2
        return 1
    fi
    echo "${config}"
}

main "$@"

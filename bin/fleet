#!/usr/bin/env python3
"""Steer the agents in tmux through web-terminal's automation API.

Lists the live Claude Code, opencode and agy sessions on every box the terminal reaches,
starts new ones, sends messages, reads replies, answers questions, closes finished ones and
watches for changes. Permission prompts and Keyguard requests stay the owner's: the API refuses
a message to a waiting agent and answers questions only, and closes a busy or waiting session
only with --force. It never closes the master's window or one that holds more than the agent.

The master session (`fleet master on`) asks the owner to look at a session with `fleet flag`:
the terminal shows the flag on that window until the owner sees it. `fleet watch` leaves the
master's own session out, reports a session busy for --stuck-after minutes once with its last
reply, prints the reply of each session that turns idle, and sends a flag still unseen after
--telegram-after minutes to Telegram, where a reply reaches the master. It counts busy time
from its own start, so a restart begins the count anew.

`fleet send --as-owner` has the owner sign the message on the approve page first, asked through
keyguard on the Mac or the dev box's unlock client. The terminal pastes the text and the token,
and the Claude Code session checks the token with `owner-message verify` before it takes the text
as the owner's words.

WEB_TERMINAL_URL names the terminal: http://localhost:8122 by default,
http://host.docker.internal:8122 inside a container, and https://terminal.mazzotta.me
on the dev box (/opt/unlock exists), whose terminal sees the dev box only. The bearer is
TELEGRAM_BOT_WEB_TERMINAL_AUTOMATION_TOKEN when it is set, else the one the master's holder keeps,
else one loaded through envify. `fleet master on` loads it past keyguard's cache and starts the
holder (token_hold), which keeps it in memory until `fleet master off` or the container ends; a
held bearer the terminal refuses is loaded and held anew once per run. The dev box holds none,
since all its sessions share one container.

Exit codes: 0 done, 1 failed, 2 usage, 3 refused: the agent waits or asks no more, the session
cannot take a message the owner signs, or the session or its window may not close.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Callable, Dict, Final, Iterator, List, Optional, Set, Tuple

import envify
import master_session
import notify_delivery
import token_hold

TOKEN_NAME: Final = "TELEGRAM_BOT_WEB_TERMINAL_AUTOMATION_TOKEN"
CACHE_NAME: Final = "ENVIFY_CACHE_TIMEOUT"
NO_CACHE: Final = "0"
NOT_HELD: Final = "fleet master on holds no token on this box: each fleet call still loads it through envify"
URL_NAME: Final = "WEB_TERMINAL_URL"
LOCAL_URL: Final = "http://localhost:8122"
CONTAINER_URL: Final = "http://host.docker.internal:8122"
DEVBOX_URL: Final = "https://terminal.mazzotta.me"
DEVBOX_MARKER: Final = Path("/opt/unlock")
DEVBOX_UNLOCK_CLIENT: Final = DEVBOX_MARKER / "keyguard-passkey"
CONTAINER_MARKER: Final = Path("/.dockerenv")
REQUEST_TIMEOUT_S: Final = 30
FIRST_REPLY_WAIT_S: Final = 120
CLOSE_WAIT_S: Final = 30
WAIT_SLACK_S: Final = 20
DEFAULT_WATCH_INTERVAL_S: Final = 5.0
DEFAULT_STUCK_AFTER_MIN: Final = 20.0
DEFAULT_TELEGRAM_AFTER_MIN: Final = 10.0
S_PER_MIN: Final = 60
REPLY_COLUMNS: Final = 300
SESSION_ID_NAME: Final = "CLAUDE_CODE_SESSION_ID"
MASTER_CUE: Final = "master"
EXIT_FAILED: Final = 1
EXIT_REFUSED: Final = 3
HTTP_NO_CONTENT: Final = 204
HTTP_BAD_REQUEST: Final = 400
HTTP_UNAUTHORIZED: Final = 401
HTTP_NOT_FOUND: Final = 404
HTTP_CONFLICT: Final = 409
AGENTS: Final = ("claude", "opencode", "agy")
OWNER_CHECKING_AGENT: Final = "claude"
NO_OWNER_INPUT: Final = "the terminal takes no owner messages: it needs web-terminal fd5e2fd or later with KEYGUARD_OWNER_PUBLIC_KEY"
EFFORTS: Final = ("low", "medium", "high", "xhigh", "max")

Session = Dict[str, Any]


class FleetError(RuntimeError):
    pass


class Refused(RuntimeError):
    pass


@dataclass(frozen=True)
class Answer:
    status: int
    body: Any


def terminal_url(environ: Dict[str, str], exists: Callable[[Path], bool]) -> str:
    configured = environ.get(URL_NAME, "").rstrip("/")
    if configured:
        return configured
    if exists(DEVBOX_MARKER):
        return DEVBOX_URL
    return CONTAINER_URL if exists(CONTAINER_MARKER) else LOCAL_URL


def hold_socket(environ: Dict[str, str], exists: Callable[[Path], bool]) -> Optional[Path]:
    if exists(DEVBOX_MARKER):
        return None
    return token_hold.socket_in(token_hold.private_base(sys.platform, environ, token_hold.SHM), os.getuid())


class Tokens:
    """The bearer of one run, in the order the module doc names."""

    def __init__(self, environ: Dict[str, str], hold_at: Optional[Path]) -> None:
        self.environ = environ
        self.hold_at = hold_at
        self.value: Optional[str] = None
        self.held = False
        self.renewed = False

    def current(self) -> str:
        if self.value is None:
            self.value, self.held = self.find()
        return self.value

    def find(self) -> Tuple[str, bool]:
        exported = self.environ.get(TOKEN_NAME)
        if exported:
            return exported, False
        held = self.fetch_held()
        return (held, True) if held else (self.load(cached=True), False)

    def fetch_held(self) -> Optional[str]:
        return token_hold.fetch(self.hold_at) if self.hold_at else None

    def hold(self) -> bool:
        if self.hold_at is None:
            return False
        held = self.fetch_held()
        if held is None:
            held = self.environ.get(TOKEN_NAME) or self.load(cached=False)
            self.keep(self.hold_at, held)
        self.value, self.held = held, True
        return True

    def release(self) -> None:
        if self.hold_at is not None:
            token_hold.stop(self.hold_at)

    def renew(self) -> Optional[str]:
        if not self.held or self.renewed or self.hold_at is None:
            return None
        self.renewed = True
        token_hold.stop(self.hold_at)
        self.value = self.load(cached=False)
        self.keep(self.hold_at, self.value)
        return self.value

    def load(self, cached: bool) -> str:
        environ = self.environ if cached else {**self.environ, CACHE_NAME: NO_CACHE}
        try:
            token = envify.values_via_shell((TOKEN_NAME,), environ).get(TOKEN_NAME, "")
        except envify.EnvifyError as error:
            raise FleetError(f"envify could not load {TOKEN_NAME}: {error}".strip()) from error
        if not token:
            raise FleetError(f"{TOKEN_NAME} is empty")
        return token

    @staticmethod
    def keep(at: Path, token: str) -> None:
        try:
            token_hold.start(at, token)
        except (token_hold.HoldError, OSError) as error:
            raise FleetError(f"could not hold {TOKEN_NAME}: {error}") from error


class Api:
    def __init__(self, base: str, tokens: Tokens) -> None:
        self.base = base
        self.tokens = tokens

    def call(self, method: str, path: str, body: Optional[Any] = None, timeout: float = REQUEST_TIMEOUT_S) -> Answer:
        answer = self.send(method, path, body, timeout, self.tokens.current())
        if answer.status != HTTP_UNAUTHORIZED:
            return answer
        renewed = self.tokens.renew()
        return answer if renewed is None else self.send(method, path, body, timeout, renewed)

    def send(self, method: str, path: str, body: Optional[Any], timeout: float, token: str) -> Answer:
        data = None if body is None else json.dumps(body).encode()
        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
        request = urllib.request.Request(f"{self.base}/api/automation{path}", data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                return Answer(response.status, parsed(response.read()))
        except urllib.error.HTTPError as error:
            return Answer(error.code, parsed(error.read()))
        except (urllib.error.URLError, OSError) as error:
            raise FleetError(f"{self.base} does not answer: {error}") from error

    def ok(self, method: str, path: str, body: Optional[Any] = None, timeout: float = REQUEST_TIMEOUT_S) -> Any:
        answer = self.call(method, path, body, timeout)
        if answer.status == HTTP_CONFLICT:
            raise Refused(error_of(answer))
        if answer.status >= 400:
            raise FleetError(f"{answer.status}: {error_of(answer)}")
        return answer.body


def parsed(raw: bytes) -> Any:
    try:
        return json.loads(raw) if raw else None
    except ValueError:
        return raw.decode(errors="replace")


def error_of(answer: Answer) -> str:
    body = answer.body
    return str(body.get("error", body)) if isinstance(body, dict) else str(body)


def quoted(segment: str) -> str:
    return urllib.parse.quote(segment, safe="")


def state_of(session: Session) -> str:
    if session.get("status") != "waiting":
        return str(session.get("status", "?"))
    return "asks" if session.get("question") else "waits-for-owner"


def describe(session: Session) -> str:
    title = session.get("title") or "(untitled)"
    marks = "".join(mark for mark in (
        "  master" if session.get("master") else "",
        f"  cue:{session['cue']}" if session.get("cue") else "",
        f"  flag: {session['flag']}" if session.get("flag") else "",
    ))
    return f"{session['short']}  {session['agent']}@{session['box']}  {state_of(session)}  {title}  [{session['cwd']}]{marks}"


def one_line(text: str) -> str:
    line = " ".join(text.split())
    return line if len(line) <= REPLY_COLUMNS else line[:REPLY_COLUMNS - 1].rstrip() + "\u2026"


def find_session(sessions: List[Session], ref: str) -> Session:
    found = [each for each in sessions if ref in (each["conversation"], each["short"])]
    if len(found) != 1:
        raise FleetError(f"{len(found)} live sessions match {ref}")
    return found[0]


def question_lines(session: Session) -> Iterator[str]:
    for number, asked in enumerate(session["question"]["questions"], start=1):
        kind = "several" if asked.get("multiSelect") else "one"
        options = ", ".join(option["label"] for option in asked["options"])
        yield f"  Q{number} ({kind}): {asked['question']}  options: {options}"


def snapshot(sessions: List[Session]) -> Dict[str, Tuple[str, str]]:
    return {each["conversation"]: (state_of(each), describe(each)) for each in sessions}


def changes(before: Dict[str, Tuple[str, str]], after: Dict[str, Tuple[str, str]]) -> List[str]:
    lines = [f"+ {line}" for key, (_, line) in after.items() if key not in before]
    lines += [f"- {line}" for key, (_, line) in before.items() if key not in after]
    lines += [f"{before[key][0]} -> {line}" for key, (state, line) in after.items() if key in before and before[key][0] != state]
    return lines


def answers_from(args: argparse.Namespace) -> List[List[str]]:
    if args.answers_json:
        answers = json.loads(args.answers_json)
        if not isinstance(answers, list) or not all(isinstance(each, list) for each in answers):
            raise FleetError("--answers-json takes a list of lists of labels")
        return answers
    if not args.labels:
        raise FleetError("give the labels of one question, or --answers-json for several")
    return [list(args.labels)]


def text_of(argument: str) -> str:
    return sys.stdin.read() if argument == "-" else argument


def print_json(value: Any) -> None:
    print(json.dumps(value, indent=2, ensure_ascii=False))


def run_boxes(api: Api, args: argparse.Namespace) -> None:
    boxes = api.ok("GET", "/boxes")
    if args.json:
        return print_json(boxes)
    for box in boxes:
        print(f"{box['name']}  {'online' if box['online'] else 'offline'}  {box['latencyMs'] or '-'} ms")


def run_ls(api: Api, args: argparse.Namespace) -> None:
    query = f"?q={quoted(' '.join(args.query))}" if args.query else ""
    listed = api.ok("GET", f"/sessions{query}")
    if args.json:
        return print_json(listed)
    for session in listed["sessions"]:
        print(describe(session))
        if session.get("question"):
            print("\n".join(question_lines(session)))
    if listed["offline"]:
        print(f"could not read: {', '.join(listed['offline'])}")


def run_start(api: Api, args: argparse.Namespace) -> None:
    body = {"box": args.box, "agent": args.agent, "prompt": text_of(args.prompt)}
    body.update({key: value for key, value in (("model", args.model), ("effort", args.effort), ("cwd", args.cwd)) if value})
    started = api.ok("POST", "/sessions", body)
    print(f"started {started['pane']} ({started['window']}) on {started['box']}")
    if args.wait:
        print_reply(first_reply(api, started["pane"]), args.json)


def first_reply(api: Api, ref: str) -> Optional[Session]:
    answer = api.call("GET", f"/sessions/{quoted(ref)}/first-reply?timeout={FIRST_REPLY_WAIT_S}", timeout=FIRST_REPLY_WAIT_S + WAIT_SLACK_S)
    if answer.status == HTTP_NO_CONTENT:
        return None
    if answer.status >= 400:
        raise FleetError(f"{answer.status}: {error_of(answer)}")
    return answer.body


def print_reply(reply: Optional[Session], as_json: bool) -> None:
    if as_json:
        return print_json(reply)
    if reply is None:
        return print("no reply yet")
    print(f"{describe(reply)}\n\n{reply['text'] if reply['text'] is not None else '(no reply among the newest records)'}")


def run_first(api: Api, args: argparse.Namespace) -> None:
    print_reply(first_reply(api, args.session), args.json)


def run_reply(api: Api, args: argparse.Namespace) -> None:
    print_reply(api.ok("GET", f"/sessions/{quoted(args.session)}/last-reply", timeout=REQUEST_TIMEOUT_S), args.json)


def run_send(api: Api, args: argparse.Namespace) -> None:
    if args.as_owner:
        return send_as_owner(api, args.session, text_of(args.text))
    sent = api.ok("POST", f"/sessions/{quoted(args.session)}/input", {"text": text_of(args.text)})
    print(f"sent to {describe(sent)}")


def owner_token(text: str, session: Session, exists: Callable[[Path], bool]) -> str:
    title = session.get("title") or ""
    if exists(DEVBOX_MARKER):
        argv = [str(DEVBOX_UNLOCK_CLIENT), "sign", "--target", session["conversation"], "--box", session["box"]]
        ran = subprocess.run([*argv, *(["--title", title] if title else [])], input=text, stdout=subprocess.PIPE, text=True, check=False)
        if ran.returncode != 0:
            raise FleetError(f"keyguard-passkey sign exited {ran.returncode}")
        return ran.stdout.strip()
    try:
        return envify.owner_signature(text, session["conversation"], session["box"], title)
    except envify.EnvifyError as error:
        raise FleetError(f"keyguard gave no owner signature: {error}") from error


def send_as_owner(api: Api, ref: str, text: str) -> None:
    session = find_session(api.ok("GET", "/sessions")["sessions"], ref)
    if session["agent"] != OWNER_CHECKING_AGENT:
        raise Refused(f"{session['short']} runs {session['agent']}: only Claude Code checks a message the owner signed")
    if session["status"] != "idle":
        raise Refused(f"{session['short']} is {state_of(session)}: the owner signs for an idle session only")
    path = f"/sessions/{quoted(session['conversation'])}/owner-input"
    ready = api.call("POST", path, {})
    if ready.status == HTTP_NOT_FOUND:
        raise FleetError(NO_OWNER_INPUT)
    if ready.status != HTTP_BAD_REQUEST:
        raise FleetError(f"{ready.status}: {error_of(ready)}")
    sent = api.ok("POST", path, {"token": owner_token(text, session, Path.exists)})
    print(f"sent as the owner to {describe(sent)}")


def run_answer(api: Api, args: argparse.Namespace) -> None:
    session = find_session(api.ok("GET", "/sessions")["sessions"], args.session)
    if not session.get("question"):
        raise Refused(f"{session['short']} asks no question ({state_of(session)})")
    body = {"question": session["question"]["id"], "answers": answers_from(args)}
    answered = api.ok("POST", f"/sessions/{quoted(session['conversation'])}/answer", body)
    print(f"answered {describe(answered)}")


def run_flag(api: Api, args: argparse.Namespace) -> None:
    flagged = api.ok("POST", f"/sessions/{quoted(args.session)}/flag", {"text": text_of(args.text)})
    print(f"flagged {describe(flagged)}")


def own_session(environ: Dict[str, str]) -> Optional[str]:
    return environ.get(SESSION_ID_NAME) or None


def run_close(api: Api, args: argparse.Namespace) -> None:
    session = find_session(api.ok("GET", "/sessions")["sessions"], args.session)
    if session["conversation"] == own_session(dict(os.environ)):
        raise Refused(f"{session['short']} is this session")
    query = "?force=true" if args.force else ""
    closed = api.ok("DELETE", f"/sessions/{quoted(session['conversation'])}{query}", timeout=CLOSE_WAIT_S + WAIT_SLACK_S)
    print(f"closed {describe(closed)}  ({closed['ended']})")


def run_master(api: Api, args: argparse.Namespace) -> None:
    own = own_session(dict(os.environ))
    session = args.session or own
    if session is None:
        raise FleetError(f"name the session with --session: {SESSION_ID_NAME} is not set")
    on = args.state == "on"
    if on and session == own and not api.tokens.hold():
        print(NOT_HELD, file=sys.stderr)
    marked = api.ok("POST", f"/sessions/{quoted(session)}/master", {"on": on})
    try:
        master_session.mark(uuid.UUID(marked["conversation"]), on)
    except ValueError:
        print("no Telegram quiet for this agent: claude-notify knows Claude Code sessions only", file=sys.stderr)
    if not on and session == own:
        api.tokens.release()
    print(f"{'marked' if on else 'unmarked'} {describe(marked)}")


@dataclass(frozen=True)
class Limits:
    stuck_after_s: float
    telegram_after_s: float


class Watcher:
    """Turns each look at the sessions into the lines the master reads (module doc, fleet watch)."""

    def __init__(self, api: Api, own: Optional[str], limits: Limits, alert: Callable[[str, str], bool],
                 clock: Callable[[], float] = time.monotonic) -> None:
        self.api = api
        self.own = own
        self.limits = limits
        self.alert = alert
        self.clock = clock
        self.before: Dict[str, Tuple[str, str]] = {}
        self.busy_since: Dict[str, float] = {}
        self.told_stuck: Set[str] = set()
        self.flagged_since: Dict[Tuple[str, str], float] = {}
        self.alerted: Set[Tuple[str, str]] = set()

    def others(self) -> List[Session]:
        return [each for each in self.api.ok("GET", "/sessions")["sessions"] if each["conversation"] != self.own]

    def start(self) -> int:
        sessions = self.others()
        self.before = snapshot(sessions)
        self.note(sessions)
        return len(sessions)

    def look(self) -> List[str]:
        sessions = self.others()
        after = snapshot(sessions)
        lines = changes(self.before, after)
        lines += [f"  reply: {self.reply(key)}" for key, (state, _) in after.items()
                  if state == "idle" and self.before.get(key, ("",))[0] == "busy"]
        self.before = after
        return lines + self.note(sessions)

    def note(self, sessions: List[Session]) -> List[str]:
        now = self.clock()
        return self.stuck(sessions, now) + self.unseen_flags(sessions, now)

    def stuck(self, sessions: List[Session], now: float) -> List[str]:
        busy = {each["conversation"]: each for each in sessions if each.get("status") == "busy"}
        self.busy_since = {key: self.busy_since.get(key, now) for key in busy}
        self.told_stuck &= set(busy)
        lines = []
        for key, session in busy.items():
            minutes = int((now - self.busy_since[key]) // S_PER_MIN)
            if now - self.busy_since[key] >= self.limits.stuck_after_s and key not in self.told_stuck:
                self.told_stuck.add(key)
                lines += [f"stuck {describe(session)}  busy {minutes} min", f"  last reply: {self.reply(key)}"]
        return lines

    def unseen_flags(self, sessions: List[Session], now: float) -> List[str]:
        flagged = {(each["conversation"], each["flag"]): each for each in sessions if each.get("flag") and each.get("cue") == MASTER_CUE}
        self.flagged_since = {key: self.flagged_since.get(key, now) for key in flagged}
        self.alerted &= set(flagged)
        lines = []
        for key, session in flagged.items():
            if now - self.flagged_since[key] >= self.limits.telegram_after_s and key not in self.alerted:
                self.alerted.add(key)
                sent = self.alert(session.get("title") or session["short"], key[1])
                lines.append(f"{'telegram' if sent else 'telegram not sent'} {session['short']}: {key[1]}")
        return lines

    def reply(self, conversation: str) -> str:
        try:
            text = self.api.ok("GET", f"/sessions/{quoted(conversation)}/last-reply")["text"]
        except FleetError:
            text = None
        return one_line(text) if text else "(none to judge from)"


def telegram_alert(own: Optional[str]) -> Callable[[str, str], bool]:
    def alert(title: str, flag: str) -> bool:
        try:
            master = uuid.UUID(own or "")
        except ValueError:
            return False
        text = one_line(f"Master: {title}: {flag}")
        return notify_delivery.send(master, text, notify_delivery.PingKind.PROMPT) == 0
    return alert


def run_watch(api: Api, args: argparse.Namespace) -> None:
    own = own_session(dict(os.environ))
    watcher = Watcher(api, own, Limits(args.stuck_after * S_PER_MIN, args.telegram_after * S_PER_MIN), telegram_alert(own))
    print(f"watching {watcher.start()} sessions", flush=True)
    lost = False
    while True:
        time.sleep(args.interval)
        try:
            lines = watcher.look()
        except FleetError as error:
            if not lost:
                print(f"! lost the terminal: {error}", flush=True)
            lost = True
            continue
        if lost:
            print("! the terminal answers again", flush=True)
        lost = False
        for line in lines:
            print(line, flush=True)


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="fleet", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    root.add_argument("--json", action="store_true", help="print the API's JSON")
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("boxes", help="list the boxes and whether they answer").set_defaults(run=run_boxes)
    ls = commands.add_parser("ls", help="list the live sessions, the newest first")
    ls.add_argument("query", nargs="*", help="words the title, folder or name holds")
    ls.set_defaults(run=run_ls)
    start = commands.add_parser("start", help="start an agent with a prompt in a new window")
    start.add_argument("box")
    start.add_argument("agent", choices=AGENTS)
    start.add_argument("prompt", help="the prompt, or - to read it from stdin")
    start.add_argument("--model")
    start.add_argument("--effort", choices=EFFORTS)
    start.add_argument("--cwd", help="an absolute folder the box allows")
    start.add_argument("--wait", action="store_true", help="print the agent's first reply")
    start.set_defaults(run=run_start)
    for name, run, about in (("first", run_first, "the first reply"), ("reply", run_reply, "the last reply, with the status")):
        command = commands.add_parser(name, help=f"print {about} of a session")
        command.add_argument("session", help="a conversation id, short id or pane")
        command.set_defaults(run=run)
    send = commands.add_parser("send", help="send a message to a session that does not wait")
    send.add_argument("session", help="a conversation id or short id")
    send.add_argument("text", help="the message, or - to read it from stdin")
    send.add_argument("--as-owner", action="store_true",
                      help="have the owner sign it on the approve page first; the session checks it with owner-message")
    send.set_defaults(run=run_send)
    answer = commands.add_parser("answer", help="answer the questions a session asks")
    answer.add_argument("session", help="a conversation id or short id")
    answer.add_argument("labels", nargs="*", help="option labels, then at most one answer of your own, for one question")
    answer.add_argument("--answers-json", help='several questions: [["Postgres"], ["Small", "Large"]]')
    answer.set_defaults(run=run_answer)
    flag = commands.add_parser("flag", help="ask the owner to look at a session, shown on its window until seen")
    flag.add_argument("session", help="a conversation id or short id")
    flag.add_argument("text", help="what the owner should look at, or - to read it from stdin")
    flag.set_defaults(run=run_flag)
    close = commands.add_parser("close", help="end the agent of an idle session with /exit and close its window")
    close.add_argument("session", help="a conversation id or short id")
    close.add_argument("--force", action="store_true",
                       help="close a busy or waiting session too by hanging its agent up, or one that does not exit in time")
    close.set_defaults(run=run_close)
    master = commands.add_parser("master", help="mark this session as the master, or unmark it")
    master.add_argument("state", choices=("on", "off"))
    master.add_argument("--session", help=f"another session than ${SESSION_ID_NAME}")
    master.set_defaults(run=run_master)
    watch = commands.add_parser("watch", help="print a line each time a session starts, ends, changes status or seems stuck")
    watch.add_argument("--interval", type=float, default=DEFAULT_WATCH_INTERVAL_S, help="seconds between looks")
    watch.add_argument("--stuck-after", type=float, default=DEFAULT_STUCK_AFTER_MIN, help="minutes busy before a session counts as stuck")
    watch.add_argument("--telegram-after", type=float, default=DEFAULT_TELEGRAM_AFTER_MIN,
                       help="minutes a flag stays unseen before it goes to Telegram")
    watch.set_defaults(run=run_watch)
    return root


def main(argv: List[str], connect: Callable[[], Api]) -> int:
    args = parser().parse_args(argv)
    try:
        args.run(connect(), args)
    except Refused as refusal:
        print(f"refused: {refusal}", file=sys.stderr)
        return EXIT_REFUSED
    except (FleetError, ValueError) as error:
        print(f"fleet: {error}", file=sys.stderr)
        return EXIT_FAILED
    return 0


def connect() -> Api:
    environ = dict(os.environ)
    return Api(terminal_url(environ, Path.exists), Tokens(environ, hold_socket(environ, Path.exists)))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:], connect))
    except KeyboardInterrupt:
        sys.exit(130)

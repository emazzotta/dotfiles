#!/bin/bash
# ref-pin - Pin upstream git clones under <workspace>/.claude/<name>-reference/ to a
# SHA and audit what points into them.
#
# References are listed in <workspace>/.claude/pinned-references, one per line as
# name|upstream-url|sparse paths (space-separated, empty = full checkout). Each is a
# git-ignored clone kept detached at the SHA in <workspace>/.claude/<name>-reference.pin,
# so symlinked skills and overlay-composed upstream files do not mutate under us on
# `git pull`. Clones live inside .claude/ so the same relative symlinks
# (../<name>-reference/...) resolve on the Mac host and in the container.

set -euo pipefail

MAC_WORKSPACE="$HOME/Projects/private/opencode/opencode/workspace"
CONTAINER_WORKSPACE="/workspace"

NAME=""
UPSTREAM=""
SPARSE=""
REF=""
PIN_FILE=""

die() {
    echo "ref-pin: $*" >&2
    exit 1
}

resolve_workspace() {
    local candidate
    if [[ -n "${REF_PIN_WORKSPACE:-}" ]]; then
        [[ -d "$REF_PIN_WORKSPACE/.claude" ]] || die "no workspace at REF_PIN_WORKSPACE=$REF_PIN_WORKSPACE"
        echo "$REF_PIN_WORKSPACE"
        return 0
    fi
    for candidate in "$CONTAINER_WORKSPACE" "$MAC_WORKSPACE"; do
        if [[ -d "$candidate/.claude" ]]; then
            echo "$candidate"
            return 0
        fi
    done
    die "no workspace with a .claude/ directory found - set REF_PIN_WORKSPACE"
}

WORKSPACE_DIR=""
CLAUDE_DIR=""
REGISTRY_FILE=""
SKILLS_DIR=""
AGENTS_DIR=""

load_workspace() {
    WORKSPACE_DIR="$(resolve_workspace)"
    CLAUDE_DIR="$WORKSPACE_DIR/.claude"
    REGISTRY_FILE="$CLAUDE_DIR/pinned-references"
    SKILLS_DIR="$CLAUDE_DIR/skills"
    AGENTS_DIR="$CLAUDE_DIR/agents"
}

registry_entries() {
    [[ -f "$REGISTRY_FILE" ]] || die "no registry at $REGISTRY_FILE"
    grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$REGISTRY_FILE" || true
}

load_entry() {
    IFS='|' read -r NAME UPSTREAM SPARSE <<< "$1"
    REF="$CLAUDE_DIR/${NAME}-reference"
    PIN_FILE="$CLAUDE_DIR/${NAME}-reference.pin"
}

select_reference() {
    local entry
    while IFS= read -r entry; do
        load_entry "$entry"
        [[ "$NAME" == "$1" ]] && return 0
    done < <(registry_entries)
    die "unknown reference: $1 (run 'ref-pin list')"
}

ensure_cloned() {
    [[ -d "$REF/.git" ]] || die "$REF is not cloned - run 'ref-pin $NAME init'"
}

read_pin() {
    [[ -f "$PIN_FILE" ]] || die "no pin file at $PIN_FILE"
    tr -d '[:space:]' < "$PIN_FILE"
}

default_branch() {
    git -C "$REF" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main
}

confirm() {
    if command -v gum >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
        gum confirm --default=false "$1"
    else
        local answer
        read -rp "$1 [y/N] " answer
        [[ "$answer" =~ ^[Yy]$ ]]
    fi
}

# Print "link|relpath" for each symlink in skills/ or agents/ that resolves into the reference.
list_symlinks() {
    find "$SKILLS_DIR" "$AGENTS_DIR" -maxdepth 2 -type l 2>/dev/null | while read -r link; do
        local target
        target=$(readlink -f "$link" 2>/dev/null || true)
        [[ "$target" == "$REF"/* ]] || continue
        echo "${link}|${target#"$REF"/}"
    done
}

# Paths whose upstream history matters: symlink targets plus the sparse paths.
watched_paths() {
    local rel
    while IFS='|' read -r _ rel; do
        if [[ -n "$rel" ]]; then echo "$rel"; fi
    done < <(list_symlinks)
    if [[ -n "$SPARSE" ]]; then
        tr ' ' '\n' <<< "$SPARSE"
    fi
}

print_path_changes() {
    local from="$1" to="$2" path count any=0
    while read -r path; do
        [[ -n "$path" ]] || continue
        count=$(git -C "$REF" rev-list --count "$from..$to" -- "$path" 2>/dev/null || echo 0)
        if [[ "$count" -gt 0 ]]; then
            any=1
            echo "  $path ($count commits)"
        fi
    done < <(watched_paths | sort -u)
    if [[ $any -eq 0 ]]; then echo "  (no changes on watched paths)"; fi
}

cmd_init() {
    if [[ -d "$REF/.git" ]]; then
        echo "$REF already cloned"
        return 0
    fi
    if [[ -n "$SPARSE" ]]; then
        local -a sparse_dirs
        read -ra sparse_dirs <<< "$SPARSE"
        git clone --filter=blob:none --no-checkout "$UPSTREAM" "$REF"
        git -C "$REF" sparse-checkout set "${sparse_dirs[@]}"
    else
        git clone --no-checkout "$UPSTREAM" "$REF"
    fi
    local pin
    if [[ -f "$PIN_FILE" ]]; then
        pin=$(read_pin)
    else
        pin=$(git -C "$REF" rev-parse "$(default_branch)")
        echo "$pin" > "$PIN_FILE"
        echo "Pinned $NAME to $(default_branch) ($pin)"
    fi
    git -C "$REF" checkout --detach "$pin" --quiet
    echo "Checked out $NAME at $pin"
}

cmd_status() {
    ensure_cloned
    local pinned current branch upstream_sha behind
    pinned=$(read_pin)
    current=$(git -C "$REF" rev-parse HEAD)
    branch=$(default_branch)
    upstream_sha=$(git -C "$REF" rev-parse "$branch" 2>/dev/null || echo unknown)

    echo "Reference:   $NAME ($UPSTREAM)"
    echo "Path:        $REF"
    if [[ -n "$SPARSE" ]]; then echo "Sparse:      $SPARSE"; fi
    echo "Pinned SHA:  $pinned"
    echo "Checked out: $current"
    echo "$branch: $upstream_sha"

    if [[ "$pinned" == "$current" ]]; then
        echo "State:       OK (checked out matches pin)"
    else
        echo "State:       DRIFT - run 'ref-pin $NAME restore' to re-checkout pin"
    fi

    if [[ "$upstream_sha" != unknown && "$pinned" != "$upstream_sha" ]]; then
        behind=$(git -C "$REF" rev-list --count "$pinned..$upstream_sha" 2>/dev/null || echo "?")
        echo "Upstream:    $behind commits ahead on $branch (run 'ref-pin $NAME diff')"
    fi

    echo
    echo "Symlinks into ${NAME}-reference:"
    local any=0 link rel
    while IFS='|' read -r link rel; do
        [[ -n "$link" ]] || continue
        any=1
        if [[ -e "$link" ]]; then
            echo "  OK     $(basename "$link") -> $rel"
        else
            echo "  BROKEN $(basename "$link") -> $rel"
        fi
    done < <(list_symlinks)
    if [[ $any -eq 0 ]]; then echo "  (none)"; fi
}

cmd_fetch() {
    ensure_cloned
    git -C "$REF" fetch origin
    echo "Fetched. Run 'ref-pin $NAME diff' to see what changed on watched paths."
}

cmd_diff() {
    ensure_cloned
    local pinned branch path log any=0
    pinned=$(read_pin)
    branch=$(default_branch)
    echo "Commits on $branch since pin that touch watched paths:"
    while read -r path; do
        [[ -n "$path" ]] || continue
        log=$(git -C "$REF" log --oneline "$pinned..$branch" -- "$path" 2>/dev/null || true)
        if [[ -n "$log" ]]; then
            any=1
            echo
            echo "### $path"
            echo "$log"
        fi
    done < <(watched_paths | sort -u)
    if [[ $any -eq 0 ]]; then echo "  (no changes on watched paths)"; fi
}

cmd_bump() {
    ensure_cloned
    git -C "$REF" fetch origin
    local old new
    old=$(read_pin)
    new=$(git -C "$REF" rev-parse "$(default_branch)")

    if [[ "$old" == "$new" ]]; then
        echo "Already at $(default_branch) ($new)"
        return 0
    fi

    echo "Current pin: $old"
    echo "New pin:     $new"
    echo
    echo "Changed watched paths between these commits:"
    print_path_changes "$old" "$new"
    echo
    confirm "Update $NAME pin to $new?" || die "aborted"

    echo "$new" > "$PIN_FILE"
    git -C "$REF" checkout --detach "$new" --quiet
    echo "Pin updated to $new - commit $PIN_FILE"
}

cmd_restore() {
    ensure_cloned
    local pinned
    pinned=$(read_pin)
    git -C "$REF" checkout --detach "$pinned" --quiet
    echo "Checked out pinned SHA $pinned"
}

cmd_list() {
    local entry state pinned
    while IFS= read -r entry; do
        load_entry "$entry"
        pinned="(no pin)"
        if [[ -f "$PIN_FILE" ]]; then pinned=$(read_pin); fi
        if [[ ! -d "$REF/.git" ]]; then
            state="not cloned"
        elif [[ "$(git -C "$REF" rev-parse HEAD)" == "$pinned" ]]; then
            state="OK"
        else
            state="DRIFT"
        fi
        printf '%-12s %-10s %s  %s\n' "$NAME" "$state" "$pinned" "$UPSTREAM"
    done < <(registry_entries)
}

cmd_help() {
    cat <<USAGE
Usage: ref-pin list
       ref-pin <name> [command]

Workspace: ${WORKSPACE_DIR:-$CONTAINER_WORKSPACE or $MAC_WORKSPACE} (override with REF_PIN_WORKSPACE)
Registry:  <workspace>/.claude/pinned-references  (name|upstream-url|sparse paths)

Commands (default: status):
  init      Clone the reference (sparse when registered so) at the pin, or pin its default branch
  status    Show pinned SHA, current checkout, upstream head, symlink health
  fetch     git fetch origin (no state change)
  diff      Commits on the upstream default branch since pin that touch watched paths
  bump      Interactively advance the pin to the upstream default branch head
  restore   Re-checkout the pinned SHA (recover from accidental detach)

State per reference:
  <workspace>/.claude/<name>-reference.pin   (git-tracked)
  <workspace>/.claude/<name>-reference/      (git-ignored clone, detached at the pin)

Watched paths are symlinks found under .claude/skills and .claude/agents plus the
sparse paths from the registry. Symlinks use relative targets (../<name>-reference/...).
USAGE
}

main() {
    case "${1:-}" in
        help | -h | --help | "") cmd_help ;;
        list)
            load_workspace
            cmd_list
            ;;
        *)
            load_workspace
            select_reference "$1"
            case "${2:-status}" in
                init) cmd_init ;;
                status) cmd_status ;;
                fetch) cmd_fetch ;;
                diff) cmd_diff ;;
                bump) cmd_bump ;;
                restore) cmd_restore ;;
                help | -h | --help) cmd_help ;;
                *) die "unknown command: $2 (run 'ref-pin help')" ;;
            esac
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

#!/bin/bash

set -e

if [ "$1" == "" ]; then
    echo "Usage: $0 <substring>"
    exit 1
fi

# pgrep -f also matches this script's own command line, so list through a file and drop its PID and its parent's
matches_file=$(mktemp)
trap 'rm -f "$matches_file"' EXIT
pgrep -fl "$1" > "$matches_file" || true
processes=$(awk -v self="$$" -v parent="$PPID" '$1 != self && $1 != parent' "$matches_file")

if [ "$processes" == "" ]; then
    echo "No processes found with substring '$1'"
    exit 1
fi

echo "Found processes:"
echo "$processes"

# Confirming the action
read -p "Are you sure you want to kill these processes? (y/n) " -n 1 -r
echo    # (optional) move to a new line
if [[ $REPLY =~ ^[Yy]$ ]]
then
    # Killing the processes
    echo "$processes" | awk '{print $1}' | xargs kill
    echo "Processes killed."
else
    echo "Operation cancelled."
fi


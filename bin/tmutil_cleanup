#!/bin/bash

set -euo pipefail

readonly BACKUPS_TO_KEEP=1

log() {
    printf '%s\n' "$*"
}

error() {
    printf 'Error: %s\n' "$*" >&2
}

backup_in_progress() {
    tmutil status 2>/dev/null | grep -q 'Running = 1;'
}

delete_local_snapshots() {
    log "Deleting local snapshots"
    if ! sudo tmutil deletelocalsnapshots /; then
        error "could not delete local snapshots for /"
    fi
}

find_destination_mount_points() {
    { tmutil destinationinfo || true; } | sed -n 's/^Mount Point *: *//p'
}

find_backup_timestamps() {
    local mount_point="$1"
    { sudo tmutil listbackups -d "${mount_point}" || true; } \
        | sed -n 's/.*\([0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}-[0-9]\{6\}\).*/\1/p' \
        | sort -u
}

prune_backups() {
    local mount_point="$1"
    local timestamps total expired timestamp
    local delete_command=(tmutil delete -d "${mount_point}")

    timestamps=$(find_backup_timestamps "${mount_point}")
    if [ -z "${timestamps}" ]; then
        log "No completed backups on ${mount_point}"
        return 0
    fi

    total=$(printf '%s\n' "${timestamps}" | wc -l | tr -d '[:space:]')
    if [ "${total}" -le "${BACKUPS_TO_KEEP}" ]; then
        log "Keeping all ${total} backup(s) on ${mount_point}"
        return 0
    fi

    expired=$(printf '%s\n' "${timestamps}" | head -n "$((total - BACKUPS_TO_KEEP))")
    while IFS= read -r timestamp; do
        delete_command+=(-t "${timestamp}")
    done <<< "${expired}"

    log "Deleting $((total - BACKUPS_TO_KEEP)) of ${total} backup(s) on ${mount_point}"
    if ! sudo "${delete_command[@]}"; then
        error "could not delete backups on ${mount_point}"
    fi
}

main() {
    local mount_point

    if backup_in_progress; then
        error "a Time Machine backup is running, run this again once it finishes"
        exit 1
    fi

    delete_local_snapshots

    while IFS= read -r mount_point; do
        if [ -d "${mount_point}" ]; then
            prune_backups "${mount_point}"
        else
            log "Destination ${mount_point} is not mounted"
        fi
    done < <(find_destination_mount_points)
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi


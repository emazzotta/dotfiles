#!/bin/bash

set -uo pipefail

block_start="# BEGIN dotfiles dns-hosts"
block_end="# END dotfiles dns-hosts"
hosts_file="/etc/hosts"
fragments_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/dns-hosts"

show_usage() {
    cat <<EOF
Usage: $(basename "${0}") [--hosts-file FILE] [--fragments DIR]

Copies every DIR/*.hosts file into a marked block of FILE and removes the block
once none are left. FILE is rewritten, and the macOS DNS cache flushed, only when
the block changed.

Options:
  --hosts-file FILE   hosts file to update (default: ${hosts_file})
  --fragments DIR     directory holding the *.hosts files (default: ${fragments_dir})
  -h, --help          show this help
EOF
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "${1}" in
            -h|--help) show_usage; exit 0 ;;
            --hosts-file) hosts_file="${2:?--hosts-file needs a file}"; shift ;;
            --fragments) fragments_dir="${2:?--fragments needs a directory}"; shift ;;
            *) printf 'unknown option: %s\n' "${1}" >&2; show_usage >&2; exit 2 ;;
        esac
        shift
    done
}

desired_block() {
    local fragment
    local lines=""
    for fragment in "${fragments_dir}"/*.hosts; do
        if [ -f "${fragment}" ]; then
            lines="${lines}$(awk 1 "${fragment}")"$'\n'
        fi
    done
    if [ -n "${lines}" ]; then
        printf '%s\n%s%s' "${block_start}" "${lines}" "${block_end}"
    fi
}

current_block() {
    sed -n "/^${block_start}\$/,/^${block_end}\$/p" "${hosts_file}"
}

replace_block() {
    local desired="${1}"
    local updated
    updated=$(mktemp)
    trap 'rm -f "${updated}"' EXIT
    sed "/^${block_start}\$/,/^${block_end}\$/d" "${hosts_file}" > "${updated}"
    if [ -n "${desired}" ]; then
        printf '%s\n' "${desired}" >> "${updated}"
    fi
    if ! { cat "${updated}" > "${hosts_file}"; } 2> /dev/null; then
        sudo /bin/cp "${updated}" "${hosts_file}"
    fi
}

flush_dns_cache() {
    if command -v dscacheutil > /dev/null; then
        sudo dscacheutil -flushcache
        sudo killall -HUP mDNSResponder
    fi
}

main() {
    parse_args "$@"
    local desired
    desired=$(desired_block)
    if [ "${desired}" = "$(current_block)" ]; then
        return 0
    fi
    replace_block "${desired}"
    flush_dns_cache
    echo "Updated ${hosts_file}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

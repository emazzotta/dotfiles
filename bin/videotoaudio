#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/shelllog.sh"

if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
    log "usage: $(basename "${0}") [video_file]"
    exit 0
fi

input_file="${1:-$(pickfile --class video)}"
[ -n "${input_file}" ] || exit 1

output_file="${input_file%.*}.mp3"
ffmpeg -i "${input_file}" -vn "${output_file}"

#!/bin/bash
set -uo pipefail

readonly BYTES_PER_KIB=1024
readonly BYTES_PER_GIB=1073741824

mem_bytes_macos() {
  local page_size total
  page_size=$(sysctl -n vm.pagesize) || return 1
  total=$(sysctl -n hw.memsize) || return 1
  vm_stat | awk -F ':' -v page_size="$page_size" -v total="$total" '
    /^Pages (active|inactive):/ { used += $2 }
    END { printf "%.0f %.0f\n", used * page_size, total }
  '
}

mem_bytes_linux() {
  awk -v kib="$BYTES_PER_KIB" '
    /^MemTotal:/ { total = $2 }
    /^MemAvailable:/ { available = $2 }
    END { printf "%.0f %.0f\n", (total - available) * kib, total * kib }
  ' /proc/meminfo
}

format_gib() {
  awk -v gib="$BYTES_PER_GIB" '{ printf "%.2fG/%.2fG\n", $1 / gib, $2 / gib }'
}

main() {
  local os
  os=$(uname -s)
  case "$os" in
    Darwin) mem_bytes_macos ;;
    Linux) mem_bytes_linux ;;
    *) echo "mem: unsupported OS: $os" >&2; return 1 ;;
  esac | format_gib
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi

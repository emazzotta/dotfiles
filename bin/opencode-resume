#!/usr/bin/env python3
"""
opencode-resume: session resumer for opencode with ranked content search.

Queries the opencode SQLite database, indexes each session's title + full
text-part content into a TSV cache keyed by time_updated, and hands the
result to fzf with a live preview pane. The query matches both titles and
message bodies, and sessions whose query words appear consecutively are
ranked first.

Usage:
    opencode-resume [SEARCH] [-n COUNT] [-f] [--rebuild] [-- OPENCODE_ARGS...]
    opencode-resume --preview-id <sid>      # internal, used by fzf preview
    opencode-resume --search-query <query>  # internal, used by fzf reload

On selection, execs `opencode --session <id> [--fork] OPENCODE_ARGS...`.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import sqlite3
import sys
from collections import defaultdict
from pathlib import Path
from typing import Final

try:
    import session_picker
    import session_search
except ImportError:
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    import session_picker
    import session_search

DB_PATH: Final = Path(os.environ.get("OPENCODE_DB", Path.home() / ".local/share/opencode/opencode.db"))
CACHE_PATH: Final = Path.home() / ".cache" / "opencode-resume-index.tsv"
CACHE_HEADER: Final = "#opencode-resume-index v2"
MS_PER_SECOND: Final = 1000
USER_COLOR: Final = "\033[36m"
ASSISTANT_COLOR: Final = "\033[32m"
DIM: Final = "\033[2m"

CONTENT_QUERY: Final = (
    "SELECT p.session_id, p.data "
    "FROM part p JOIN message m ON p.message_id = m.id "
    "WHERE p.data LIKE '%\"type\":\"text\"%' "
    "ORDER BY m.time_created, p.time_created"
)
TURNS_QUERY: Final = (
    "SELECT m.data, p.data "
    "FROM part p JOIN message m ON p.message_id = m.id "
    "WHERE p.session_id = ? "
    "ORDER BY m.time_created, p.time_created"
)


def connect_ro() -> sqlite3.Connection:
    if not DB_PATH.exists():
        raise FileNotFoundError(f"opencode db not found: {DB_PATH}")
    return sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True)


def fetch_session_content(conn: sqlite3.Connection, target_sids: set[str] | None = None) -> dict[str, str]:
    """Return {session_id: searchable text} - lowercased once, matched many times."""
    chunks: dict[str, list[str]] = defaultdict(list)
    for sid, data in conn.execute(CONTENT_QUERY):
        if target_sids is not None and sid not in target_sids:
            continue
        text = _part_text(data)
        if text:
            chunks[sid].append(text)
    return {sid: " ".join(parts).lower() for sid, parts in chunks.items()}


def _part_text(data: str) -> str:
    try:
        part = json.loads(data)
    except (json.JSONDecodeError, TypeError):
        return ""
    if part.get("type") != "text":
        return ""
    return session_picker.flatten(part.get("text", ""))


def _to_session(sid: str, updated_ms: int, title: str, content: str) -> session_search.Session:
    return session_search.Session(sid, updated_ms // MS_PER_SECOND, title, content)


def build_sessions(force_rebuild: bool = False) -> list[session_search.Session]:
    """Index every session, reusing cached text whose time_updated is unchanged."""
    conn = connect_ro()
    try:
        cache = {} if force_rebuild else session_picker.load_cache(CACHE_PATH, CACHE_HEADER)
        rows = conn.execute("SELECT id, title, time_updated FROM session ORDER BY time_updated DESC").fetchall()
        stale = {sid for sid, _title, updated in rows if sid not in cache or cache[sid].stamp != updated}
        rebuilt = fetch_session_content(conn, stale) if stale else {}

        fresh: dict[str, session_picker.CacheEntry] = {}
        sessions: list[session_search.Session] = []
        for sid, title, updated in rows:
            content = rebuilt.get(sid, "") if sid in stale else cache[sid].content
            fresh[sid] = session_picker.CacheEntry(updated, title, content)
            sessions.append(_to_session(sid, updated, title, content))
        session_picker.save_cache(CACHE_PATH, CACHE_HEADER, fresh)
        return sessions
    finally:
        conn.close()


def load_sessions() -> list[session_search.Session]:
    """Read the cache only - the fast path fzf calls on every keystroke."""
    cache = session_picker.load_cache(CACHE_PATH, CACHE_HEADER)
    return [_to_session(sid, entry.stamp, entry.title, entry.content) for sid, entry in cache.items()]


def build_rows(sessions: list[session_search.Session], count: int) -> list[str]:
    return [
        session_picker.format_row(session_picker.format_display(s.title, s.updated_at), s.sid)
        for s in sessions[:count]
    ]


def rank(sessions: list[session_search.Session], raw_query: str) -> list[session_search.Session]:
    return session_search.search(sessions, session_search.parse_query(raw_query))


def render_preview(sid: str, raw_query: str = "") -> str:
    tokens = session_search.highlight_tokens(session_search.parse_query(raw_query))
    try:
        conn = connect_ro()
    except FileNotFoundError as e:
        return str(e)
    try:
        session = conn.execute("SELECT title, time_updated FROM session WHERE id = ?", (sid,)).fetchone()
        if not session:
            return f"session {sid} not found"
        title, updated = session
        reset = session_picker.RESET
        out = [
            f"{DIM}{sid}  {session_picker.format_ago(updated // MS_PER_SECOND)}{reset}",
            f"{DIM}{title}{reset}",
            "",
        ]
        turns = 0
        for message_data, part_data in conn.execute(TURNS_QUERY, (sid,)):
            if turns >= session_picker.PREVIEW_TURN_LIMIT:
                out.append(f"{DIM}…(truncated){reset}")
                break
            text = _part_text(part_data)
            if not text:
                continue
            role = _role(message_data)
            color = USER_COLOR if role == "user" else ASSISTANT_COLOR
            highlighted = session_picker.highlight_matches(session_picker.truncate_turn(text), tokens)
            out.append(f"{color}▌ {role}{reset} {highlighted}")
            out.append("")
            turns += 1
    finally:
        conn.close()
    return "\n".join(out)


def _role(message_data: str) -> str:
    try:
        return json.loads(message_data).get("role", "?")
    except (json.JSONDecodeError, TypeError):
        return "?"


def cmd_preview(sid: str, raw_query: str) -> int:
    print(render_preview(sid, raw_query))
    return 0


def cmd_search(raw_query: str, count: int) -> int:
    session_picker.write_rows(build_rows(rank(load_sessions(), raw_query), count))
    return 0


def build_commands(count: int) -> session_picker.PickerCommands:
    self_path = shlex.quote(str(Path(__file__).resolve()))
    return session_picker.PickerCommands(
        preview=f"{self_path} --preview-id={{2}} --preview-query={{q}}",
        reload=f"{self_path} --search-query={{q}} -n {count}",
    )


def cmd_pick(raw_query: str, count: int, fork: bool, rebuild: bool, opencode_args: list[str]) -> int:
    try:
        sessions = build_sessions(force_rebuild=rebuild)
    except FileNotFoundError as e:
        print(e, file=sys.stderr)
        return 1
    if not sessions:
        print("No sessions found", file=sys.stderr)
        return 1

    rows = build_rows(rank(sessions, raw_query), count)
    try:
        sid = session_picker.pick(
            rows, raw_query,
            f"Resume opencode session | {session_picker.FZF_HEADER_HINT}",
            build_commands(count),
        )
    except FileNotFoundError as e:
        print(e, file=sys.stderr)
        return 2
    if sid is None:
        return 1

    opencode = shutil.which("opencode")
    if not opencode:
        print("opencode not found on PATH", file=sys.stderr)
        return 2
    exec_args = [opencode, "--session", sid]
    if fork:
        exec_args.append("--fork")
    os.execvp(opencode, [*exec_args, *opencode_args])


def main() -> int:
    parser = argparse.ArgumentParser(prog="opencode-resume", add_help=True)
    parser.add_argument("search", nargs="*", default=[])
    parser.add_argument("-n", "--count", type=int, default=10000)
    parser.add_argument("-f", "--fork", action="store_true", help="fork the session instead of resuming in-place")
    parser.add_argument("--rebuild", action="store_true", help="force cache rebuild")
    parser.add_argument("--preview-id", dest="preview_id", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--preview-query", dest="preview_query", default="", help=argparse.SUPPRESS)
    parser.add_argument("--search-query", dest="search_query", default=None, help=argparse.SUPPRESS)

    our_argv, opencode_args = session_picker.split_args(sys.argv[1:])
    args = parser.parse_args(our_argv)

    if args.preview_id:
        return cmd_preview(args.preview_id, args.preview_query)
    if args.search_query is not None:
        return cmd_search(args.search_query, args.count)
    return cmd_pick(" ".join(args.search), args.count, args.fork, args.rebuild, opencode_args)


if __name__ == "__main__":
    sys.exit(main())

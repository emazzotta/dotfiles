#!/bin/bash
# Resolve one file in the current directory by extension.
#
# Globs for the given extensions, then:
#   none -> error
#   one  -> print it
#   many -> hand them to `picker` and print the selection
#
# Extensions match case-insensitively, with or without a leading dot, and
# compound forms work (tar.gz). The resolved path goes to stdout and
# everything else to stderr, so it composes into a one-line default:
#
#   input="$(pickfile pdf)" || exit 1
#   archive="$(pickfile --header 'Select archive:' 7z zip tar.gz)" || exit 1
#   clip="$(pickfile --class video)" || exit 1
#
# Classes name the extension sets that several scripts share: image, video,
# audio. Combine them freely with bare extensions.
#
# Usage:
#   pickfile [--header TEXT] [--class NAME] [EXT...]
#
# Exit codes:
#   0   resolved (path on stdout)
#   1   nothing found, or cancelled
#   2   usage error

set -uo pipefail
shopt -s nocaseglob

IMAGE_EXTENSIONS="jpg jpeg png gif bmp tiff webp svg heic"
VIDEO_EXTENSIONS="mp4 m4v mov mkv avi webm mpg mpeg wmv flv 3gp mts m2ts"
AUDIO_EXTENSIONS="mp3 m4a aac flac wav aif aiff alac ogg opus wma ape wv"

expand_class() {
    case "$1" in
        image) echo "$IMAGE_EXTENSIONS" ;;
        video) echo "$VIDEO_EXTENSIONS" ;;
        audio) echo "$AUDIO_EXTENSIONS" ;;
        *) return 1 ;;
    esac
}

show_help() {
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

header="Select file:"
extensions=""
class_labels=""

while [ $# -gt 0 ]; do
    case "$1" in
        --class)
            if ! expanded="$(expand_class "${2:-}")"; then
                echo "pickfile: unknown class: ${2:-} (want image, video or audio)" >&2
                exit 2
            fi
            extensions="${extensions} ${expanded}"
            class_labels="${class_labels} ${2}"
            shift 2
            ;;
        --header)
            if [ -z "${2:-}" ]; then
                echo "pickfile: --header requires a value" >&2
                exit 2
            fi
            header="$2"
            shift 2
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        -*)
            echo "pickfile: unknown option: $1" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

bare_extensions="$*"
description="${class_labels}${bare_extensions:+ ${bare_extensions}}"

# Deliberate word splitting: every class and bare extension becomes one argument.
# shellcheck disable=SC2086
set -- ${extensions} "$@"

if [ $# -eq 0 ]; then
    echo "pickfile: at least one extension or class required" >&2
    exit 2
fi

matches=""
for extension in "$@"; do
    for candidate in *."${extension#.}"; do
        if [ -f "$candidate" ]; then
            matches="${matches}${candidate}"$'\n'
        fi
    done
done
matches="$(printf '%s' "$matches" | sort -u)"

if [ -z "$matches" ]; then
    echo "pickfile: no${description} file in $(pwd)" >&2
    exit 1
fi

match_count="$(printf '%s\n' "$matches" | wc -l | tr -d ' ')"

if [ "$match_count" -eq 1 ]; then
    printf '%s\n' "$matches"
    exit 0
fi

if ! command -v picker >/dev/null 2>&1; then
    echo "pickfile: several matches but picker is unavailable:" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi

selected="$(printf '%s\n' "$matches" | picker --header "$header")"

if [ -z "$selected" ]; then
    echo "pickfile: nothing selected" >&2
    exit 1
fi

printf '%s\n' "$selected"

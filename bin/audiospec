#!/bin/bash

set -e

if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
    echo "usage: $(basename "${0}") [audio file]"
    exit 0
fi

input_file="${1:-$(pickfile --class audio)}"
[ -n "${input_file}" ] || exit 1

output_file="${input_file%.*}_spectrogram.png"
sox "${input_file}" -n spectrogram -o "${output_file}"

#!/usr/bin/env python3
"""Answer git's credential requests with one keyguard secret, held in this box's memory.

git runs `git-credential-keyguard NAME get|store|erase` for the URLs its config scopes the helper to.
`get` answers with the value of NAME: from the holder (token_hold) when one answers, otherwise loaded
once through envify, one approval, and handed to a new holder that keeps it until `erase` or the box
ends. git sends `erase` when the server rejects the value, so the next `get` loads it again. `store`
does nothing: the value never reaches a file.
"""
from __future__ import annotations

import contextlib
import fcntl
import os
import re
import sys
from pathlib import Path
from typing import Dict, Final, Iterator, List, Optional

import envify
import token_hold

NAME_PATTERN: Final = re.compile(r"^[A-Z][A-Z0-9_]{0,63}$")
GET: Final = "get"
STORE: Final = "store"
ERASE: Final = "erase"
LOCK_SUFFIX: Final = ".lock"
PRIVATE_FILE_MODE: Final = 0o600
EXIT_USAGE: Final = 2
USAGE: Final = f"usage: {Path(__file__).name} NAME {GET}|{STORE}|{ERASE}, as git's credential.helper"


class LoadError(RuntimeError):
    pass


def hold_socket(name: str) -> Optional[Path]:
    return token_hold.socket_in(token_hold.private_base(sys.platform, os.environ, token_hold.SHM), os.getuid(), name)


def value_of(name: str) -> str:
    at = hold_socket(name)
    if at is None:
        return load(name)
    held = token_hold.fetch(at)
    if held:
        return held
    token_hold.private_folder(at.parent)
    with locked(at.with_suffix(LOCK_SUFFIX)):
        return token_hold.fetch(at) or held_after_load(name, at)


def held_after_load(name: str, at: Path) -> str:
    value = load(name)
    try:
        token_hold.start(at, value)
    except (token_hold.HoldError, OSError) as error:
        print(f"{Path(__file__).name}: {name} is not held, the next request loads it again: {error}", file=sys.stderr)
    return value


@contextlib.contextmanager
def locked(path: Path) -> Iterator[None]:
    descriptor = os.open(path, os.O_CREAT | os.O_RDWR, PRIVATE_FILE_MODE)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def load(name: str) -> str:
    try:
        value = envify.values_via_shell((name,), with_own_folder_on_path(dict(os.environ))).get(name, "")
    except envify.EnvifyError as error:
        raise LoadError(first_line(str(error))) from error
    if not value:
        raise LoadError(f"{name} is empty")
    return value


def with_own_folder_on_path(environ: Dict[str, str]) -> Dict[str, str]:
    own = str(Path(__file__).resolve().parent)
    return {**environ, "PATH": os.pathsep.join(filter(None, (environ.get("PATH"), own)))}


def first_line(text: str) -> str:
    return next((line for line in text.splitlines() if line.strip()), "no reason given")


def answer(name: str) -> str:
    try:
        return f"password={value_of(name)}\n"
    except (LoadError, token_hold.HoldError, OSError) as error:
        print(f"{Path(__file__).name}: no value for {name}: {error}", file=sys.stderr)
        return "quit=1\n"


def forget(name: str) -> None:
    at = hold_socket(name)
    if at is not None:
        token_hold.stop(at)


def main(arguments: List[str]) -> int:
    if arguments[:1] in (["-h"], ["--help"]):
        print(USAGE)
        return 0
    if len(arguments) != 2 or not NAME_PATTERN.match(arguments[0]):
        print(USAGE, file=sys.stderr)
        return EXIT_USAGE
    name, operation = arguments
    sys.stdin.read()
    if operation == GET:
        sys.stdout.write(answer(name))
    elif operation == ERASE:
        forget(name)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/bin/bash

set -e

if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
    echo "usage: $(basename "${0}") [input_file]"
    exit 0
fi

input_file="${1:-$(pickfile --class image)}"
[ -n "${input_file}" ] || exit 1

output_file="${input_file%.*}_mirrored.${input_file##*.}"
echo "Converting to ${output_file}..."
convert "${input_file}" -flop "${output_file}"

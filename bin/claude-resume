#!/usr/bin/env python3
"""
claude-resume: session resumer for Claude Code with ranked content search.

Indexes each session's title + full message text into a TSV cache keyed by
mtime, then hands the result to fzf with a live preview pane. Unlike
`claude --resume`, the query matches both titles and message bodies, and
sessions whose query words appear consecutively are ranked first.

Usage:
    claude-resume [SEARCH] [-n COUNT] [-a] [--rebuild] [-- CLAUDE_ARGS...]
    claude-resume --preview-id <id>      # internal, used by fzf preview
    claude-resume --search-query <query> # internal, used by fzf reload

On selection, execs `claude --resume <id> CLAUDE_ARGS...`.
"""

import argparse
import json
import os
import shlex
import shutil
import sys
from pathlib import Path
from typing import Final

try:
    import session_picker
    import session_search
except ImportError:
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    import session_picker
    import session_search

PROJECTS_DIR: Final = Path(os.environ.get("CLAUDE_PROJECTS", Path.home() / ".claude" / "projects"))
CACHE_NAME: Final = ".claude-resume-index.tsv"
CACHE_HEADER: Final = "#claude-resume-index v3"
NO_PROMPT: Final = "(no prompt)"
USER_COLOR: Final = "\033[36m"
ASSISTANT_COLOR: Final = "\033[32m"
DIM: Final = "\033[2m"


def path_to_slug(path: Path) -> str:
    return str(path).replace("/", "-")


def extract_text(content) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(
            item["text"] for item in content
            if isinstance(item, dict) and isinstance(item.get("text"), str)
        )
    return ""


def read_turns(path: Path):
    """Yield (kind, text) for every user/assistant message in a session file."""
    try:
        with path.open(errors="replace") as f:
            for line in f:
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                kind = entry.get("type")
                message = entry.get("message")
                if kind not in ("user", "assistant") or not isinstance(message, dict):
                    continue
                text = session_picker.flatten(extract_text(message.get("content", "")))
                if text:
                    yield kind, text
    except OSError:
        return


def scan_jsonl(path: Path) -> tuple[str, str]:
    """Return (title, searchable content) for a session file.

    Content is lowercased once here so the per-keystroke search never has to.
    It is only ever matched against - the preview re-reads the session file.
    """
    title = ""
    chunks: list[str] = []
    for kind, text in read_turns(path):
        if not title and kind == "user":
            title = text
        chunks.append(text)
    return title or NO_PROMPT, " ".join(chunks).lower()


def resolve_scopes(all_projects: bool) -> list[Path]:
    if not PROJECTS_DIR.is_dir():
        return []
    if all_projects:
        return sorted(d for d in PROJECTS_DIR.iterdir() if d.is_dir())
    scope = PROJECTS_DIR / path_to_slug(Path.cwd())
    return [scope] if scope.is_dir() else []


def build_sessions(scope_dirs: list[Path], force_rebuild: bool = False) -> list[session_search.Session]:
    """Index every session file, reusing cached text whose mtime is unchanged."""
    sessions: list[session_search.Session] = []
    for scope in scope_dirs:
        cache_path = scope / CACHE_NAME
        cache = {} if force_rebuild else session_picker.load_cache(cache_path, CACHE_HEADER)
        fresh: dict[str, session_picker.CacheEntry] = {}
        for jsonl in scope.glob("*.jsonl"):
            try:
                mtime = int(jsonl.stat().st_mtime)
            except OSError:
                continue
            cached = cache.get(jsonl.stem)
            title, content = (cached.title, cached.content) if cached and cached.stamp == mtime else scan_jsonl(jsonl)
            fresh[jsonl.stem] = session_picker.CacheEntry(mtime, title, content)
            sessions.append(session_search.Session(jsonl.stem, mtime, title, content, scope.name))
        session_picker.save_cache(cache_path, CACHE_HEADER, fresh)
    return sessions


def load_sessions(scope_dirs: list[Path]) -> list[session_search.Session]:
    """Read the caches only - the fast path fzf calls on every keystroke."""
    return [
        session_search.Session(sid, entry.stamp, entry.title, entry.content, scope.name)
        for scope in scope_dirs
        for sid, entry in session_picker.load_cache(scope / CACHE_NAME, CACHE_HEADER).items()
    ]


def build_rows(sessions: list[session_search.Session], show_project: bool, count: int) -> list[str]:
    return [
        session_picker.format_row(
            session_picker.format_display(s.title, s.updated_at, s.project if show_project else ""),
            s.sid,
        )
        for s in sessions[:count]
    ]


def rank(sessions: list[session_search.Session], raw_query: str) -> list[session_search.Session]:
    return session_search.search(sessions, session_search.parse_query(raw_query))


def find_jsonl(session_id: str) -> Path | None:
    if not PROJECTS_DIR.is_dir():
        return None
    for scope in PROJECTS_DIR.iterdir():
        candidate = scope / f"{session_id}.jsonl"
        if scope.is_dir() and candidate.exists():
            return candidate
    return None


def render_preview(jsonl: Path, raw_query: str = "") -> str:
    tokens = session_search.highlight_tokens(session_search.parse_query(raw_query))
    out: list[str] = [f"{DIM}{jsonl.parent.name}/{jsonl.name}{session_picker.RESET}", ""]
    for turns, (kind, text) in enumerate(read_turns(jsonl)):
        if turns >= session_picker.PREVIEW_TURN_LIMIT:
            out.append(f"{DIM}…(truncated){session_picker.RESET}")
            break
        color = USER_COLOR if kind == "user" else ASSISTANT_COLOR
        highlighted = session_picker.highlight_matches(session_picker.truncate_turn(text), tokens)
        out.append(f"{color}▌ {kind}{session_picker.RESET} {highlighted}")
        out.append("")
    return "\n".join(out)


def cmd_preview(session_id: str, raw_query: str) -> int:
    jsonl = find_jsonl(session_id)
    if jsonl is None:
        print(f"session {session_id} not found", file=sys.stderr)
        return 1
    print(render_preview(jsonl, raw_query))
    return 0


def cmd_search(raw_query: str, count: int, all_projects: bool) -> int:
    sessions = rank(load_sessions(resolve_scopes(all_projects)), raw_query)
    session_picker.write_rows(build_rows(sessions, all_projects, count))
    return 0


def build_commands(count: int, all_projects: bool) -> session_picker.PickerCommands:
    self_path = shlex.quote(str(Path(__file__).resolve()))
    scope_flag = " -a" if all_projects else ""
    return session_picker.PickerCommands(
        preview=f"{self_path} --preview-id={{2}} --preview-query={{q}}",
        reload=f"{self_path} --search-query={{q}} -n {count}{scope_flag}",
    )


def cmd_pick(raw_query: str, count: int, all_projects: bool, rebuild: bool, claude_args: list[str]) -> int:
    if not PROJECTS_DIR.is_dir():
        print(f"projects dir not found: {PROJECTS_DIR}", file=sys.stderr)
        return 1
    scopes = resolve_scopes(all_projects)
    if not scopes:
        print(f"No sessions for current project ({path_to_slug(Path.cwd())}). Use -a for all projects.", file=sys.stderr)
        return 1

    sessions = build_sessions(scopes, force_rebuild=rebuild)
    if not sessions:
        print("No sessions found", file=sys.stderr)
        return 1

    rows = build_rows(rank(sessions, raw_query), all_projects, count)
    try:
        session_id = session_picker.pick(
            rows, raw_query,
            f"Resume session | {session_picker.FZF_HEADER_HINT}",
            build_commands(count, all_projects),
        )
    except FileNotFoundError as e:
        print(e, file=sys.stderr)
        return 2
    if session_id is None:
        return 1

    claude = shutil.which("claude")
    if not claude:
        print("claude not found on PATH", file=sys.stderr)
        return 2
    os.execvp(claude, [claude, "--resume", session_id, *claude_args])


def main() -> int:
    parser = argparse.ArgumentParser(prog="claude-resume", add_help=True)
    parser.add_argument("search", nargs="*", default=[])
    parser.add_argument("-n", "--count", type=int, default=10000)
    parser.add_argument("-a", "--all", action="store_true")
    parser.add_argument("--rebuild", action="store_true", help="force cache rebuild")
    parser.add_argument("--preview-id", dest="preview_id", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--preview-query", dest="preview_query", default="", help=argparse.SUPPRESS)
    parser.add_argument("--search-query", dest="search_query", default=None, help=argparse.SUPPRESS)

    our_argv, claude_args = session_picker.split_args(sys.argv[1:])
    args = parser.parse_args(our_argv)

    if args.preview_id:
        return cmd_preview(args.preview_id, args.preview_query)
    if args.search_query is not None:
        return cmd_search(args.search_query, args.count, args.all)
    return cmd_pick(" ".join(args.search), args.count, args.all, args.rebuild, claude_args)


if __name__ == "__main__":
    sys.exit(main())

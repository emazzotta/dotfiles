#!/usr/bin/env python3
from __future__ import annotations

import argparse
from functools import partial
from pathlib import Path

import medialib
from medialib import OutputNaming
import scriptlog as logger


AUDIO_CODECS = {
    "mp3": "libmp3lame",
    "m4a": "aac",
    "aac": "aac",
    "flac": "flac",
    "wav": "pcm_s16le",
    "aif": "pcm_s16le",
    "aiff": "pcm_s16le",
    "alac": "alac",
    "ogg": "libvorbis",
    "opus": "libopus",
    "wma": "wmav2",
}


def plan_conversion(input_file: Path, output_dir: Path | None, fmt: str) -> medialib.FfmpegJob | None:
    codec = AUDIO_CODECS.get(fmt)
    if not codec:
        logger.error(f"Unsupported format: {fmt}")
        return None

    output_file = medialib.resolve_output_path(input_file, output_dir, OutputNaming(extension=f".{fmt}"))

    cmd = [
              "ffmpeg",
              "-i", str(input_file),
              "-c:a", codec,
          ] + medialib.LOSSY_AUDIO_QUALITY_ARGS.get(fmt, []) + ["-y", str(output_file)]
    return medialib.FfmpegJob(cmd, output_file)


def main():
    p = argparse.ArgumentParser(description="Convert audio files")
    p.add_argument("-i", "--input", nargs="+", help="Audio files or directories (default: pick from the current directory)")
    p.add_argument("-f", "--format", dest="fmt", default="mp3",
                   choices=AUDIO_CODECS.keys(), help="Output format (default: mp3)")
    p.add_argument("-o", "--output-path", help="Output directory")
    p.add_argument("-d", "--delete", action="store_true", help="Delete original after conversion")
    args = p.parse_args()

    spec = medialib.BatchSpec(
        media=medialib.AUDIO, task="convert", doing="Converting", done="Converted",
        plan=partial(plan_conversion, fmt=args.fmt))
    medialib.run_batch(spec, args.input, args.output_path, args.delete)


if __name__ == "__main__":
    main()

#!/bin/bash
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "Usage: $(basename "$0") [--disconnect]"
    echo ""
    echo "Without an option, connects the VPN when needed and mounts the network drive."
    echo "  --disconnect  Unmount the network drive and disconnect the VPN"
    exit 0
fi

source leonardo_account

ask_primary_email() {
    local not_supplied="PRIMARY_EMAIL is not set and keyguard did not supply it."
    local profile_hint="add this line to your shell profile (~/.zshrc):"

    if [ ! -t 0 ]; then
        echo "Error: $not_supplied" >&2
        echo "To set it, $profile_hint export PRIMARY_EMAIL=you@example.com" >&2
        exit 1
    fi

    printf '%s●%s %s\n' "$YELLOW" "$RESET" "$not_supplied" >&2
    read -r -p "Enter PRIMARY_EMAIL (your personal Tailscale login): " PRIMARY_EMAIL || true
    if [ -z "$PRIMARY_EMAIL" ]; then
        echo "Error: No email address entered." >&2
        exit 1
    fi
    printf '%s●%s To keep it, %s export PRIMARY_EMAIL=%q\n' "$YELLOW" "$RESET" "$profile_hint" "$PRIMARY_EMAIL" >&2
}

load_primary_email() {
    if [ -z "${PRIMARY_EMAIL:-}" ]; then
        source envify PRIMARY_EMAIL || true
    fi
    if [ -z "${PRIMARY_EMAIL:-}" ]; then
        ask_primary_email
    fi
}

STATUS_HOST="updates.leonardo.local"
TIMEOUT_IN_MS=350

is_network_up() {
    [ "$(host-resolver "$STATUS_HOST" --timeout $TIMEOUT_IN_MS 2>/dev/null)" != "127.0.0.1" ]
}

mount_k_drive_on_network_up() {
    if is_network_up; then
        printf "${GREEN}●${RESET} Leonardo network is reachable.\n"
        leonardo_drive --mount
        if command -v tailscale-toggle-exit-node > /dev/null 2>&1; then
            tailscale-toggle-exit-node
        fi
        return 0
    fi
    return 1
}

disconnect() {
    local disconnected=false

    # Only the Tailscale account check below needs the address, so a connect never asks for it.
    if command -v tailscale > /dev/null 2>&1; then
        load_primary_email
    fi

    leonardo_drive --unmount

    if command -v tailscale > /dev/null 2>&1; then
        local ts_json ts_state ts_user
        ts_json=$(tailscale status --json 2>/dev/null || true)
        ts_state=$(echo "$ts_json" | jq -r '.BackendState // empty' 2>/dev/null || true)
        ts_user=$(echo "$ts_json" | jq -r '.User[(.Self.UserID | tostring)].LoginName // empty' 2>/dev/null || true)
        if [ "$ts_state" = "Running" ] && [ "$ts_user" != "$PRIMARY_EMAIL" ]; then
            tailscale set --exit-node=
            tailscale down
            scutil --nc stop "Tailscale" 2>/dev/null || true
            printf "${RED}●${RESET} Tailscale disconnected\n"
            disconnected=true
        elif [ "$ts_user" = "$PRIMARY_EMAIL" ]; then
            printf "${YELLOW}●${RESET} Tailscale on personal account - skipping disconnect\n"
        fi
    fi

    if leonardo_vpn_toggle --disable; then
        disconnected=true
    fi

    if [ "$disconnected" = false ]; then
        printf "${YELLOW}●${RESET} Nothing to disconnect\n"
    fi
}

if [ "${1:-}" = "--disconnect" ]; then
    disconnect
    exit 0
fi

if is_network_up; then
    leonardo_vpn_toggle || exit 0
    mount_k_drive_on_network_up && exit 0
else
    leonardo_vpn_toggle --enable
    printf "${YELLOW}●${RESET} Waiting for network...\n"
    DEADLINE=$((SECONDS + 15))
    while [ $SECONDS -lt $DEADLINE ]; do
        sleep 1
        mount_k_drive_on_network_up && exit 0
    done
fi

leonardo_drive --unmount
printf "${RED}●${RESET} $STATUS_HOST is not reachable.\n"
exit 1

#!/usr/bin/env python3
"""Ping Telegram through mazzotta-bot when a Claude session waits for input.

As a Claude Code hook (no arguments, the hook's JSON on stdin), it arms a ping. With a
computer or phone at a web terminal (presence.py), the ping goes out 10 min later unless
the session was seen first: a prompt was submitted, or a tmux client showing its pane got
a key or a focus change. Attaching alone does not count, since the web terminal reattaches
every tab at once. With nobody there, or no way to tell, it goes out at the next 5 s poll,
unless a prompt was submitted or the prompted tool finished first. Someone showing up
before that poll puts it back on the 10 min wait.
- Stop arms the ping with the first sentence of the reply, or with the whole reply as an
  `answer` when the session's tmux window carries `@wt_origin automation`, which the web
  terminal sets on a window it opens for a Telegram request. An answer ignores presence
  and tmux activity: it goes out at the next 5 s poll unless its pending ping is gone or
  was replaced. Background agents still at work for the session hold it. It carries the
  presence and the last use read when it goes out, for mazzotta-bot's spoken answers.
- On a window that also carries `@wt_ephemeral 1`, which the web terminal sets when the
  Telegram request asked for a one-shot session, the answer closes the window once the
  unlock service accepted it (tmux kill-window). The window stays, and the message says
  why in its first line, when background shells or crons may still run, or when the last
  line of the reply is a question. It stays too, silently, when the send failed, since the
  answer then lives only there. The flag stays on the window: the next Stop is judged anew.
- A reply whose last line is `[silent]` (SILENT_MARKER) or a routing line of mazzotta-bot's
  router (`route: <id>`, ROUTING_LINE) sends nothing and cancels what is pending. A one-shot
  window still closes as it would after a send.
- PermissionRequest notes what the prompt is about. The permission_prompt Notification,
  which Claude Code raises only once a prompt has waited about 6 s unanswered, arms it.
- PostToolUse and PostToolUseFailure of the prompted tool cancel the prompt's ping: an
  answer from the web terminal's chat view comes as tmux send-keys, which is not seen.
- UserPromptSubmit and SessionEnd cancel what is pending.

The master session (master_session.py) gets no Stop ping: it reports through its flags.
Delivery: notify_delivery.py. Runs outside an interactive session (`claude -p`, the Agent
SDK) never ping.
"""
from __future__ import annotations

import json
import os
import re
import secrets
import subprocess
import sys
import time
from collections.abc import Callable, Iterable, Sequence
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Final
from uuid import UUID

import master_session
import presence
from notify_delivery import PingKind, deliver, notice

PING_DELAY: Final = timedelta(minutes=10)
SEEN_POLL: Final = timedelta(seconds=5)
TMUX_TIMEOUT: Final = timedelta(seconds=2)
TMUX_CLIENT_FORMAT: Final = "#{pane_id}\t#{client_created}\t#{client_activity}"
WINDOW_FORMAT: Final = "#{@wt_origin}\t#{@wt_ephemeral}"
AUTOMATION_ORIGIN: Final = "automation"
EPHEMERAL_FLAG: Final = "1"
BACKGROUND_NOTE: Final = "Window kept open: background work may still be running."
QUESTION_NOTE: Final = "Window kept open: the reply ends with a question."
SENTENCE_LIMIT: Final = 200
FINISHED_FALLBACK: Final = "Finished, waiting for your input."
SILENT_MARKER: Final = "[silent]"
SHORT_ID: Final = r"[0-9A-Za-z]{8}"
ROUTING_LINE: Final = re.compile(
    rf"(?:\w+, )?(`?)route: (?:approval|ask(?: {SHORT_ID}){{1,3}}|{SHORT_ID})\1")
STATE_DIR: Final = Path.home() / ".cache" / "claude-notify"
UNATTENDED_ENTRYPOINT_PREFIX: Final = "sdk"
WAKING_TASK_TYPES_EXEMPT: Final = frozenset({"shell"})
CANARY: Final = re.compile(
    r"^\s*Emanuele,\s*(?:\d{4}-\d{2}-\d{2} \d{2}:\d{2} [A-Z]+ \([^)]*\):\s*)?")
MARKDOWN_LINK: Final = re.compile(r"\[([^\]]+)\]\([^)]*\)")
MARKDOWN_EMPHASIS: Final = re.compile(r"\*\*|__|`")
TRAILING_MARKUP: Final = "*_`"
LINE_MARKER: Final = re.compile(r"^(?:[#>*\-]+|\d+\.)\s+")
SENTENCE_END: Final = re.compile(r"(?<=[.!?])\s")
USAGE: Final = """Usage: claude-notify [send | fire SESSION TOKEN]

Without arguments, a Claude Code hook: reads the hook event on stdin and arms
or cancels a Telegram ping through the unlock service.

  send                read a notice ({"session", "container", "title", "text", "kind"}) on stdin and
                      deliver it; the keyguard bridge endpoint runs this on the Mac
  fire SESSION TOKEN  internal: wait for the session's pending ping to fall due (10 minutes
                      with someone at a web terminal, one poll without, and one poll for
                      an answer whoever is there), then send it if TOKEN still holds it and
                      the session's tmux pane went unseen (an answer ignores the pane); an
                      answer of a one-shot window then closes the window if TOKEN still
                      holds it and the send succeeded

Options:
  -h, --help  show this help and exit
"""


def capped(text: str, limit: int = SENTENCE_LIMIT) -> str:
    text = " ".join(text.split())
    return text if len(text) <= limit else text[:limit - 1].rstrip() + "\u2026"


def first_sentence(message: str) -> str:
    text = MARKDOWN_EMPHASIS.sub("", MARKDOWN_LINK.sub(r"\1", CANARY.sub("", message)))
    lines = [LINE_MARKER.sub("", line).strip() for line in text.splitlines()]
    line = next((line for line in lines if line), "")
    sentence = SENTENCE_END.split(line, maxsplit=1)[0]
    return capped(sentence[:1].upper() + sentence[1:]) if sentence else FINISHED_FALLBACK


def prompt_sentence(tool_name: str, tool_input: dict) -> str:
    if tool_name == "AskUserQuestion":
        questions = tool_input.get("questions") or [{}]
        return capped(f"Asks: {questions[0].get('question', 'a question')}")
    if tool_name == "ExitPlanMode":
        return "Has a plan ready for your approval."
    if tool_name == "Bash":
        return capped(f"Needs your OK to run: {tool_input.get('description') or tool_input.get('command', '')}")
    return capped(f"Needs your OK for {tool_name}.")


def is_unattended() -> bool:
    return os.environ.get("CLAUDE_CODE_ENTRYPOINT", "").startswith(UNATTENDED_ENTRYPOINT_PREFIX)


def background_work_pending(event: dict) -> bool:
    tasks = event.get("background_tasks") or []
    return any(task.get("type") not in WAKING_TASK_TYPES_EXEMPT for task in tasks)


def work_may_remain(event: dict) -> bool:
    return any(event.get(key) is None or bool(event[key]) for key in ("background_tasks", "session_crons"))


def ends_with_question(reply: str) -> bool:
    return last_line(reply).rstrip(TRAILING_MARKUP).endswith("?")


def last_line(reply: str) -> str:
    lines = [line.strip() for line in reply.splitlines() if line.strip()]
    return lines[-1] if lines else ""


def is_silent(reply: str) -> bool:
    line = last_line(reply)
    return line == SILENT_MARKER or ROUTING_LINE.fullmatch(line) is not None


def open_note(event: dict, reply: str) -> str | None:
    if work_may_remain(event):
        return BACKGROUND_NOTE
    return QUESTION_NOTE if ends_with_question(reply) else None


def state_file(session: UUID, kind: str) -> Path:
    return STATE_DIR / f"{session}.{kind}"


def write_state(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.{os.getpid()}")
    temporary.write_text(content)
    os.replace(temporary, path)


def take_state(path: Path) -> str | None:
    try:
        content = path.read_text()
        path.unlink()
    except FileNotFoundError:
        return None
    return content


def read_pending(session: UUID) -> dict | None:
    try:
        return json.loads(state_file(session, "pending").read_text())
    except FileNotFoundError:
        return None


def spawn(arguments: Sequence[str]) -> None:
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), *arguments],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def arm(session: UUID, text: str, kind: PingKind, prompt: dict | None = None, close: bool = False,
        silent: bool = False) -> None:
    token = secrets.token_hex(8)
    pending = {"token": token, "text": text, "kind": kind.value, "prompt": prompt, "close": close,
               "silent": silent}
    write_state(state_file(session, "pending"), json.dumps(pending))
    spawn(["fire", str(session), token])


def prompted_tool(event: dict) -> dict:
    return {"tool": event.get("tool_name"), "agent": event.get("agent_id")}


def on_stop(session: UUID, event: dict) -> None:
    if background_work_pending(event) or master_session.is_master(session):
        take_state(state_file(session, "pending"))
        return
    reply = event.get("last_assistant_message") or ""
    marks = window_marks()
    if is_silent(reply):
        stay_silent(session, event, marks)
        return
    if not marks.automation:
        arm(session, first_sentence(reply), PingKind.FINISHED)
        return
    answer = reply if reply.strip() else FINISHED_FALLBACK
    note = open_note(event, answer) if marks.one_shot else None
    arm(session, f"{note}\n\n{answer}" if note else answer, PingKind.ANSWER, close=marks.one_shot and note is None)


def stay_silent(session: UUID, event: dict, marks: WindowMarks) -> None:
    take_state(state_file(session, "pending"))
    if marks.one_shot and not work_may_remain(event):
        arm(session, "", PingKind.ANSWER, close=True, silent=True)


def on_permission_request(session: UUID, event: dict) -> None:
    sentence = prompt_sentence(event.get("tool_name", "a tool"), event.get("tool_input") or {})
    write_state(state_file(session, "prompt"), json.dumps({"text": sentence, "prompt": prompted_tool(event)}))


def on_notification(session: UUID, event: dict) -> None:
    if event.get("notification_type") != "permission_prompt":
        return
    noted = json.loads(take_state(state_file(session, "prompt")) or "{}")
    text = noted.get("text") or event.get("message") or "Needs your input."
    arm(session, text, PingKind.PROMPT, noted.get("prompt"))


def on_tool_done(session: UUID, event: dict) -> None:
    pending = read_pending(session)
    if pending is not None and pending.get("prompt") == prompted_tool(event):
        take_state(state_file(session, "pending"))


def on_cancel(session: UUID, event: dict) -> None:
    take_state(state_file(session, "pending"))
    take_state(state_file(session, "prompt"))


HANDLERS: Final[dict[str, Callable[[UUID, dict], None]]] = {
    "Stop": on_stop,
    "PermissionRequest": on_permission_request,
    "Notification": on_notification,
    "PostToolUse": on_tool_done,
    "PostToolUseFailure": on_tool_done,
    "UserPromptSubmit": on_cancel,
    "SessionEnd": on_cancel,
}


def handle_hook(raw: str) -> None:
    event = json.loads(raw)
    handler = HANDLERS.get(event.get("hook_event_name", ""))
    if handler is None or is_unattended():
        return
    handler(UUID(event["session_id"]), event)


@dataclass(frozen=True)
class TmuxClient:
    pane: str
    created: datetime
    activity: datetime

    def used_since(self, armed: datetime) -> bool:
        return self.activity >= armed and self.activity > self.created


def parse_clients(listing: str) -> list[TmuxClient]:
    clients = []
    for line in listing.splitlines():
        pane, *stamps = line.split("\t")
        if len(stamps) == 2 and all(stamp.isdigit() for stamp in stamps):
            created, activity = (datetime.fromtimestamp(int(stamp), timezone.utc) for stamp in stamps)
            clients.append(TmuxClient(pane, created, activity))
    return clients


def tmux_output(*arguments: str) -> str:
    try:
        return subprocess.run(["tmux", *arguments], capture_output=True, text=True, check=False,
                              timeout=TMUX_TIMEOUT.total_seconds()).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def tmux_clients() -> list[TmuxClient]:
    return parse_clients(tmux_output("list-clients", "-F", TMUX_CLIENT_FORMAT))


@dataclass(frozen=True)
class WindowMarks:
    origin: str = ""
    ephemeral: str = ""

    @property
    def automation(self) -> bool:
        return self.origin == AUTOMATION_ORIGIN

    @property
    def one_shot(self) -> bool:
        return self.automation and self.ephemeral == EPHEMERAL_FLAG


def window_marks() -> WindowMarks:
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return WindowMarks()
    origin, _, ephemeral = tmux_output("display-message", "-p", "-t", pane, WINDOW_FORMAT).rstrip("\n").partition("\t")
    return WindowMarks(origin, ephemeral)


def close_window() -> None:
    pane = os.environ.get("TMUX_PANE")
    if pane and window_marks().one_shot:
        tmux_output("kill-window", "-t", pane)


def seen_since(pane: str, armed: datetime, clients: Iterable[TmuxClient]) -> bool:
    return any(client.pane == pane and client.used_since(armed) for client in clients)


def armed_ping(session: UUID, token: str) -> dict | None:
    pending = read_pending(session)
    return pending if pending is not None and pending.get("token") == token else None


def wait_until_due(session: UUID, token: str, sleep: Callable[[float], None], seen: Callable[[], bool],
                   away: Callable[[], bool]) -> bool:
    for _ in range(PING_DELAY // SEEN_POLL):
        sleep(SEEN_POLL.total_seconds())
        if armed_ping(session, token) is None or seen():
            return False
        if away():
            return True
    return True


def is_answer(ping: dict | None) -> bool:
    return ping is not None and ping["kind"] == PingKind.ANSWER.value


def fire(session: UUID, token: str, sleep: Callable[[float], None] = time.sleep,
         clients: Callable[[], Iterable[TmuxClient]] = tmux_clients,
         presence_reader: Callable[[], presence.Presence] = presence.current) -> int:
    armed = datetime.now(timezone.utc).replace(microsecond=0)
    pane = os.environ.get("TMUX_PANE")
    answer = is_answer(armed_ping(session, token))
    due = wait_until_due(session, token, sleep,
                         lambda: not answer and pane is not None and seen_since(pane, armed, clients()),
                         lambda: answer or not presence_reader().attended)
    ping = armed_ping(session, token)
    if ping is None:
        return 0
    if not due:
        take_state(state_file(session, "pending"))
        return 0
    if ping.get("silent"):
        take_state(state_file(session, "pending"))
        close_window()
        return 0
    reading = presence.read() if is_answer(ping) else None
    body = json.dumps(notice(session, ping["text"], PingKind(ping["kind"]), reading))
    if not ping.get("close"):
        take_state(state_file(session, "pending"))
        return deliver(body)
    return deliver_then_close(session, token, body)


def deliver_then_close(session: UUID, token: str, body: str) -> int:
    sent = deliver(body)
    if armed_ping(session, token) is not None:
        take_state(state_file(session, "pending"))
        if sent == 0:
            close_window()
    return sent


def main(argv: Sequence[str]) -> int:
    if argv[:1] in (["-h"], ["--help"]):
        print(USAGE, end="")
        return 0
    if not argv:
        try:
            handle_hook(sys.stdin.read())
        except (ValueError, KeyError, OSError) as error:
            print(f"claude-notify: hook skipped ({type(error).__name__}: {error})", file=sys.stderr)
        return 0
    if argv == ["send"]:
        return deliver(sys.stdin.read())
    if len(argv) == 3 and argv[0] == "fire":
        return fire(UUID(argv[1]), argv[2])
    print(USAGE, end="", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

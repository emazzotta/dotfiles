#!/usr/bin/env python3
"""Name the Claude Code or opencode session this process runs in, for secret approval prompts.

Prints one JSON line, {"session": "<short session ID>", "title": "<session title>"}, which
envify sends to keyguard and the devbox unlock client signs into its request. The short ID is a
Claude session ID's first block, or an opencode session ID's last eight characters, since
opencode starts its IDs with the time. opencode gives its commands no session ID, so the
session is the one the opencode above this process works on, as its server tells. Outside
both the title names the shell and its tmux window. An unknown value is empty, and the exit
status is always 0, so an approval never fails on this lookup.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import unicodedata
import urllib.request
from collections.abc import Iterator, Sequence
from pathlib import Path
from typing import Final
from uuid import UUID

PROJECTS_DIR: Final = Path(os.environ.get("CLAUDE_PROJECTS", Path.home() / ".claude" / "projects"))
SESSION_ENV: Final = "CLAUDE_CODE_SESSION_ID"
SHORT_ID_LENGTH: Final = 8
TITLE_LIMIT: Final = 60
ELLIPSIS: Final = "\u2026"
HIDDEN_CATEGORIES: Final = frozenset({"Cc", "Cf", "Co", "Cs", "Zl", "Zp"})
TITLE_TYPE: Final = "ai-title"
TITLE_MARK: Final = TITLE_TYPE.encode()
CHUNK_BYTES: Final = 1 << 16
SCAN_LIMIT_BYTES: Final = 16 << 20
TMUX_TIMEOUT_SECONDS: Final = 1.0
SHELL_TITLE: Final = "shell"
OPENCODE: Final = "opencode"
OPENCODE_SESSION: Final = re.compile(r"ses_[0-9A-Za-z]{20,40}")
OPENCODE_SHORT_ID: Final = 8
OPENCODE_TIMEOUT_SECONDS: Final = 0.5
WORKING: Final = frozenset({"busy", "retry"})
MAX_DEPTH: Final = 40


def session_id() -> UUID | None:
    try:
        return UUID(os.environ.get(SESSION_ENV, ""))
    except ValueError:
        return None


def clean(title: str) -> str:
    spaced = "".join(" " if char.isspace() else char for char in title)
    visible = "".join(char for char in spaced if unicodedata.category(char) not in HIDDEN_CATEGORIES)
    collapsed = " ".join(visible.split())
    if len(collapsed) <= TITLE_LIMIT:
        return collapsed
    return collapsed[:TITLE_LIMIT - len(ELLIPSIS)].rstrip() + ELLIPSIS


def lines_from_end(path: Path) -> Iterator[bytes]:
    with path.open("rb") as handle:
        position = handle.seek(0, os.SEEK_END)
        floor = max(0, position - SCAN_LIMIT_BYTES)
        partial = b""
        while position > floor:
            step = min(CHUNK_BYTES, position - floor)
            position -= step
            handle.seek(position)
            lines = (handle.read(step) + partial).split(b"\n")
            partial = lines.pop(0)
            yield from reversed(lines)
        if position == 0:
            yield partial


def title_in(line: bytes) -> str | None:
    if TITLE_MARK not in line:
        return None
    try:
        record = json.loads(line)
    except ValueError:
        return None
    title = record.get("aiTitle") if isinstance(record, dict) and record.get("type") == TITLE_TYPE else None
    return title if isinstance(title, str) else None


def session_title(session: UUID) -> str:
    transcript = next(PROJECTS_DIR.glob(f"*/{session}.jsonl"), None)
    if transcript is None:
        return ""
    try:
        titles = (title_in(line) for line in lines_from_end(transcript))
        return clean(next((title for title in titles if title is not None), ""))
    except OSError:
        return ""


def tmux_place() -> str | None:
    server, pane = os.environ.get("TMUX", ""), os.environ.get("TMUX_PANE", "")
    if not server or not pane:
        return None
    command = ["tmux", "-S", server.split(",")[0], "display-message", "-p", "-t", pane, "#S:#I"]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=TMUX_TIMEOUT_SECONDS)
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    return clean(result.stdout) or None


def shell_title() -> str:
    place = tmux_place()
    return f"{SHELL_TITLE} in tmux {place}" if place else SHELL_TITLE


def parent_and_name(pid: int) -> tuple[int, str] | None:
    try:
        result = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                                capture_output=True, text=True, check=False, timeout=OPENCODE_TIMEOUT_SECONDS)
    except (OSError, subprocess.SubprocessError):
        return None
    fields = result.stdout.split(None, 1)
    if result.returncode != 0 or len(fields) != 2 or not fields[0].isdigit():
        return None
    return int(fields[0]), fields[1].strip().rsplit("/", 1)[-1]


def opencode_ancestor() -> int | None:
    pid = os.getppid()
    for _ in range(MAX_DEPTH):
        found = parent_and_name(pid)
        if found is None:
            return None
        parent, name = found
        if name == OPENCODE:
            return pid
        if parent <= 1:
            return None
        pid = parent
    return None


def listening_ports(pid: int) -> list[int]:
    try:
        result = subprocess.run(["lsof", "-nP", "-a", "-p", str(pid), "-iTCP", "-sTCP:LISTEN", "-Fn"],
                                capture_output=True, text=True, check=False, timeout=OPENCODE_TIMEOUT_SECONDS)
    except (OSError, subprocess.SubprocessError):
        return []
    ports = (line.rsplit(":", 1)[-1] for line in result.stdout.splitlines() if line.startswith("n"))
    return [int(port) for port in ports if port.isdigit()]


def asked(port: int, path: str) -> object:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=OPENCODE_TIMEOUT_SECONDS) as response:
            return json.load(response)
    except (OSError, ValueError):
        return None


def owner_of(port: int, session: object) -> dict | None:
    """The session `session` belongs to: itself, or the one its subagent works for."""
    for _ in range(MAX_DEPTH):
        known = isinstance(session, str) and OPENCODE_SESSION.fullmatch(session)
        info = asked(port, f"/session/{session}") if known else None
        if not isinstance(info, dict) or info.get("id") != session:
            return None
        if info.get("parentID") is None:
            return info
        session = info["parentID"]
    return None


def working_owner(port: int, statuses: dict) -> dict | None:
    owners = {}
    for session, status in statuses.items():
        if not isinstance(status, dict) or status.get("type") not in WORKING:
            continue
        owner = owner_of(port, session)
        if owner is None:
            return None
        owners[owner["id"]] = owner
    return next(iter(owners.values())) if len(owners) == 1 else None


def opencode_session() -> dict[str, str] | None:
    """The opencode session working above this process; None outside opencode or when it is unclear which one."""
    pid = opencode_ancestor()
    for port in [] if pid is None else listening_ports(pid):
        statuses = asked(port, "/session/status")
        if isinstance(statuses, dict):
            owner = working_owner(port, statuses)
            if owner is None:
                return None
            title = owner.get("title")
            return {"session": owner["id"][-OPENCODE_SHORT_ID:], "title": clean(title) if isinstance(title, str) else ""}
    return None


def describe() -> dict[str, str]:
    session = session_id()
    if session is not None:
        return {"session": session.hex[:SHORT_ID_LENGTH], "title": session_title(session)}
    return opencode_session() or {"session": "", "title": shell_title()}


def main(argv: Sequence[str]) -> int:
    argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter).parse_args(argv)
    print(json.dumps(describe()))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
from __future__ import annotations

import argparse
import subprocess
import time
from pathlib import Path
import sys

import medialib
from medialib import OutputNaming
from scriptlog import Logger

logger = Logger()

FORMAT_CODECS = {
    "mp4": ("libx264", "aac"),
    "m4v": ("libx264", "aac"),
    "mov": ("libx264", "aac"),
    "mkv": ("libx264", "aac"),
    "avi": ("libx264", "mp3"),
    "webm": ("libvpx-vp9", "libopus"),
    "mpg": ("mpeg2video", "mp2"),
    "mpeg": ("mpeg2video", "mp2"),
}

EXTRA_ARGS = {
    "mp4": ["-movflags", "+faststart"],
    "m4v": ["-movflags", "+faststart"],
    "mov": ["-movflags", "+faststart"],
    "webm": ["-b:v", "0"],
}



def convert_one(input_file: Path, fmt: str, output_dir: Path | None, delete_original: bool, crf: str, file_num: int, total_files: int) -> Path | None:
    vcodec, acodec = FORMAT_CODECS.get(fmt, (None, None))
    if not vcodec:
        logger.error(f"Unsupported format: {fmt}")
        return None

    output_file = medialib.resolve_output_path(input_file, output_dir, OutputNaming(extension=f".{fmt}"))

    cmd = [
              "ffmpeg",
              "-i", str(input_file),
              "-c:v", vcodec,
              "-c:a", acodec,
              "-crf", crf,
          ] + EXTRA_ARGS.get(fmt, []) + ["-y", str(output_file)]

    logger.log(f"\n[{file_num}/{total_files}] Converting: {input_file.name} -> {output_file.name}")
    print()

    start_time = time.time()
    try:
        subprocess.run(cmd, check=True)
        elapsed = time.time() - start_time
        print()
        logger.success(f"Converted in {medialib.format_time(elapsed)}: {input_file.name} -> {output_file.name}")
        if delete_original:
            input_file.unlink(missing_ok=True)
        return output_file
    except subprocess.CalledProcessError:
        print()
        logger.error(f"Failed: {input_file.name}")
        return None


def main():
    p = argparse.ArgumentParser(description="Convert video files")
    p.add_argument("-i", "--input", required=True, nargs="+", help="Video files or directories")
    p.add_argument("-f", "--format", dest="fmt", default="mp4",
                   choices=FORMAT_CODECS.keys(), help="Output format (default: mp4)")
    p.add_argument("-o", "--output-path", help="Output directory")
    p.add_argument("-d", "--delete", action="store_true", help="Delete original after conversion")
    p.add_argument("-q", "--quality", default="23", help="CRF quality (0-51, default: 23)")
    args = p.parse_args()

    sources = [Path(i).expanduser().resolve() for i in args.input]
    out_dir = Path(args.output_path).expanduser().resolve() if args.output_path else None
    if out_dir:
        out_dir.mkdir(parents=True, exist_ok=True)

    inputs = medialib.collect_inputs(sources, medialib.VIDEO_EXTS)
    if not inputs:
        logger.error("No video files found")
        sys.exit(1)

    logger.log(f"Found {len(inputs)} video file(s) to convert")

    results = []
    failed = 0
    batch_start_time = time.time()
    for idx, f in enumerate(inputs, 1):
        result = convert_one(f, args.fmt, out_dir, args.delete, args.quality, idx, len(inputs))
        if result:
            results.append(result)
        else:
            failed += 1

    batch_elapsed = time.time() - batch_start_time
    print()
    logger.log(f"Summary: {len(results)} succeeded, {failed} failed, {len(inputs)} total in {medialib.format_time(batch_elapsed)}")


if __name__ == "__main__":
    main()

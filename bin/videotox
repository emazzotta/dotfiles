#!/usr/bin/env python3
from __future__ import annotations

import argparse
from functools import partial
from pathlib import Path

import medialib
from medialib import OutputNaming
import scriptlog as logger


FORMAT_CODECS = {
    "mp4": ("libx264", "aac"),
    "m4v": ("libx264", "aac"),
    "mov": ("libx264", "aac"),
    "mkv": ("libx264", "aac"),
    "avi": ("libx264", "mp3"),
    "webm": ("libvpx-vp9", "libopus"),
    "mpg": ("mpeg2video", "mp2"),
    "mpeg": ("mpeg2video", "mp2"),
}

EXTRA_ARGS = {
    "mp4": ["-movflags", "+faststart"],
    "m4v": ["-movflags", "+faststart"],
    "mov": ["-movflags", "+faststart"],
    "webm": ["-b:v", "0"],
}



def plan_conversion(input_file: Path, output_dir: Path | None, fmt: str, crf: str) -> medialib.FfmpegJob | None:
    vcodec, acodec = FORMAT_CODECS.get(fmt, (None, None))
    if not vcodec:
        logger.error(f"Unsupported format: {fmt}")
        return None

    output_file = medialib.resolve_output_path(input_file, output_dir, OutputNaming(extension=f".{fmt}"))

    cmd = [
              "ffmpeg",
              "-i", str(input_file),
              "-c:v", vcodec,
              "-c:a", acodec,
              "-crf", crf,
          ] + EXTRA_ARGS.get(fmt, []) + ["-y", str(output_file)]
    return medialib.FfmpegJob(cmd, output_file)


def main():
    p = argparse.ArgumentParser(description="Convert video files")
    p.add_argument("-i", "--input", nargs="+", help="Video files or directories (default: pick from the current directory)")
    p.add_argument("-f", "--format", dest="fmt", default="mp4",
                   choices=FORMAT_CODECS.keys(), help="Output format (default: mp4)")
    p.add_argument("-o", "--output-path", help="Output directory")
    p.add_argument("-d", "--delete", action="store_true", help="Delete original after conversion")
    p.add_argument("-q", "--quality", default="23", help="CRF quality (0-51, default: 23)")
    args = p.parse_args()

    spec = medialib.BatchSpec(
        media=medialib.VIDEO, task="convert", doing="Converting", done="Converted",
        plan=partial(plan_conversion, fmt=args.fmt, crf=args.quality))
    medialib.run_batch(spec, args.input, args.output_path, args.delete)


if __name__ == "__main__":
    main()

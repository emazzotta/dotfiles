#!/bin/bash
set -uo pipefail

readonly WORKTREE_DIR=".claude/worktrees"

show_usage() {
    cat <<EOF
Usage: git wt <command>

  add <branch> [<start>]  create the worktree $WORKTREE_DIR/<branch> in the main checkout;
                          a new branch starts from <start> (default origin/HEAD)
  path <branch>           print where the worktree holding <branch> is checked out on this machine
  rm <branch>...          delete each branch and the worktree holding it, also when that
                          worktree was registered from the other side of a container mount
  rm --merged             delete each branch whose work is in origin/HEAD, squash merges included,
                          and its worktree; a branch without commits of its own qualifies only once
                          its upstream is gone, and checked-out branches and worktrees with
                          uncommitted changes or not on this machine are kept
  sweep [-n]              remove clean worktrees whose branch is merged or upstream gone, and registrations
                          whose $WORKTREE_DIR directory is gone; -n only lists them
EOF
}

usage_error() {
    show_usage >&2
    exit 2
}

main_worktree() {
    git worktree list --porcelain | awk '/^worktree / && !seen { print substr($0, 10); seen = 1 }'
}

linked_worktrees() {
    git worktree list --porcelain | awk '
        /^worktree / { path = substr($0, 10); count++ }
        /^branch refs\/heads\// { branch = substr($0, 19) }
        /^$/ { if (count > 1) print path "\t" branch; branch = "" }'
}

worktree_of_branch() {
    linked_worktrees | awk -F '\t' -v branch="$1" '$2 == branch { print $1 }'
}

common_dir() {
    git rev-parse --path-format=absolute --git-common-dir
}

admin_dir_of() {
    local gitdir_file
    for gitdir_file in "$(common_dir)"/worktrees/*/gitdir; do
        if [ -f "$gitdir_file" ] && [ "$(cat "$gitdir_file")" = "$1/.git" ]; then
            printf '%s\n' "${gitdir_file%/gitdir}"
            return 0
        fi
    done
    return 1
}

locate_worktree() {
    local registered="$1" twin
    if [ -e "$registered" ]; then
        printf '%s\n' "$registered"
        return 0
    fi
    case "$registered" in
        */"$WORKTREE_DIR"/*) twin="$PWD/$WORKTREE_DIR/${registered#*/"$WORKTREE_DIR"/}" ;;
        *) return 1 ;;
    esac
    [ -e "$twin" ] || return 1
    printf '%s\n' "$twin"
}

checkout_of_branch() {
    local registered
    if [ "$(git symbolic-ref -q HEAD)" = "refs/heads/$1" ]; then
        printf '%s\n' "$PWD"
        return 0
    fi
    registered=$(worktree_of_branch "$1")
    if [ -z "$registered" ]; then
        echo "no worktree holds $1" >&2
        return 1
    fi
    if ! locate_worktree "$registered"; then
        echo "$registered is not on this machine" >&2
        return 1
    fi
}

is_clean() {
    local admin status
    admin=$(admin_dir_of "$1") || return 1
    status=$(git --no-optional-locks --git-dir="$admin" --work-tree="$2" status --porcelain) || return 1
    [ -z "$status" ]
}

delete_worktree() {
    local registered="$1" local_path="${2:-}"
    if [ -z "$local_path" ]; then
        git worktree remove "$registered"
        return
    fi
    if [ "$local_path" != "$registered" ]; then
        git worktree repair "$local_path" >/dev/null 2>&1 || return 1
    fi
    git worktree remove "$local_path"
}

remove_if_clean() {
    local registered="$1" local_path
    if ! local_path=$(locate_worktree "$registered"); then
        delete_worktree "$registered" || return 1
        echo "dropped $registered (directory not on this machine)"
        return 0
    fi
    if ! is_clean "$registered" "$local_path"; then
        echo "kept $local_path: uncommitted changes" >&2
        return 1
    fi
    delete_worktree "$registered" "$local_path"
}

remove_branches() {
    local branch registered failed=0
    for branch in "$@"; do
        registered=$(worktree_of_branch "$branch")
        if [ -n "$registered" ] && ! remove_if_clean "$registered"; then
            failed=1
            continue
        fi
        git branch -D "$branch" || failed=1
    done
    return "$failed"
}

exclude_worktree_dir() {
    local info
    git check-ignore -q "$WORKTREE_DIR/" && return 0
    info="$(common_dir)/info"
    mkdir -p "$info"
    printf '/%s/\n' "$WORKTREE_DIR" >>"$info/exclude"
}

trust_like_main_checkout() {
    if git config --global --get-all safe.directory | grep -qxF "$PWD"; then
        git config --global --add safe.directory "$1"
    fi
}

relative_path() {
    local from="$1" to="$2" up=""
    until [ "${to#"$from"/}" != "$to" ]; do
        from="${from%/*}"
        up="../$up"
    done
    printf '%s%s\n' "$up" "${to#"$from"/}"
}

link_across_mounts() {
    local worktree admin
    worktree=$(cd "$1" && pwd -P) || return 1
    admin=$(git -C "$worktree" rev-parse --absolute-git-dir) || return 1
    printf 'gitdir: %s\n' "$(relative_path "$worktree" "$admin")" >"$worktree/.git"
}

add_worktree() {
    local branch="$1" start="${2:-}" path
    path="$PWD/$WORKTREE_DIR/$branch"
    exclude_worktree_dir
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add "$path" "$branch" >&2 || return 1
    elif [ -z "$start" ] && git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        git worktree add --track -b "$branch" "$path" "origin/$branch" >&2 || return 1
    else
        git worktree add --no-track -b "$branch" "$path" "${start:-origin/HEAD}" >&2 || return 1
    fi
    link_across_mounts "$path"
    trust_like_main_checkout "$path"
    printf '%s\n' "$path"
}

upstream_gone() {
    [ "$(git for-each-ref --format='%(upstream:track)' "refs/heads/$1")" = "[gone]" ]
}

sweep_reason() {
    local registered="$1" branch="$2" local_path reason
    if ! local_path=$(locate_worktree "$registered"); then
        case "$registered" in
            */"$WORKTREE_DIR"/*) echo "directory gone" ;;
            *) return 1 ;;
        esac
        return 0
    fi
    [ -n "$branch" ] || return 1
    if upstream_gone "$branch"; then
        reason="upstream gone"
    elif merged_into_origin_head "$branch"; then
        reason="merged"
    else
        return 1
    fi
    is_clean "$registered" "$local_path" || return 1
    echo "$reason"
}

merged_into_origin_head() {
    local merged
    git merge-base --is-ancestor "refs/heads/$1" origin/HEAD 2>/dev/null && return 1
    merged=$(git merge-tree --write-tree origin/HEAD "refs/heads/$1" 2>/dev/null) || return 1
    [ "$merged" = "$(git rev-parse 'origin/HEAD^{tree}')" ]
}

landed_in_origin_head() {
    if git merge-base --is-ancestor "refs/heads/$1" origin/HEAD 2>/dev/null; then
        upstream_gone "$1"
    else
        merged_into_origin_head "$1"
    fi
}

landed_and_clean() {
    local branch="$1" registered local_path
    landed_in_origin_head "$branch" || return 1
    registered=$(worktree_of_branch "$branch")
    [ -n "$registered" ] || return 0
    local_path=$(locate_worktree "$registered") || return 1
    is_clean "$registered" "$local_path"
}

remove_merged_branches() {
    local invoking_branch="$1" main_branch default_branch branch failed=0
    main_branch=$(git symbolic-ref -q --short HEAD)
    default_branch=$(git symbolic-ref -q --short refs/remotes/origin/HEAD)
    while IFS= read -r branch; do
        case "$branch" in
            "$invoking_branch" | "$main_branch" | "${default_branch#origin/}") continue ;;
        esac
        if landed_and_clean "$branch"; then
            remove_branches "$branch" || failed=1
        fi
    done < <(local_branches)
    return "$failed"
}

sweep() {
    local dry_run="$1" registered branch reason
    while IFS=$'\t' read -r registered branch; do
        reason=$(sweep_reason "$registered" "$branch") || continue
        if [ "$dry_run" = true ]; then
            echo "would remove $registered ($reason)"
        elif delete_worktree "$registered" "$(locate_worktree "$registered")"; then
            echo "removed $registered ($reason)"
        fi
    done < <(linked_worktrees)
}

local_branches() {
    git for-each-ref --format='%(refname:lstrip=2)' refs/heads
}

origin_branches() {
    git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin | grep -vx HEAD
}

worktree_branches() {
    git worktree list --porcelain | sed -n 's|^branch refs/heads/||p'
}

complete_next_word() {
    case "${1:-}" in
        "") printf '%s\n' add path rm sweep ;;
        add) [ $# -eq 1 ] && { local_branches; origin_branches; } | sort -u ;;
        path) [ $# -eq 1 ] && worktree_branches ;;
        rm) [ $# -eq 1 ] && echo --merged; [ "${2:-}" = --merged ] || local_branches ;;
        sweep) [ $# -eq 1 ] && printf '%s\n' -n ;;
    esac
}

main() {
    local command="${1:-}" main_checkout invoking_branch
    case "$command" in
        -h|--help) show_usage; return 0 ;;
        --complete) shift; complete_next_word "$@"; return 0 ;;
        add) [ $# -ge 2 ] && [ $# -le 3 ] || usage_error ;;
        path) [ $# -eq 2 ] || usage_error ;;
        rm)
            [ $# -ge 2 ] || usage_error
            [ "$2" != --merged ] || [ $# -eq 2 ] || usage_error
            ;;
        sweep) [ $# -eq 1 ] || { [ $# -eq 2 ] && [ "$2" = "-n" ]; } || usage_error ;;
        *) usage_error ;;
    esac
    shift
    invoking_branch=$(git symbolic-ref -q --short HEAD 2>/dev/null)
    main_checkout=$(main_worktree)
    [ -n "$main_checkout" ] && cd "$main_checkout" || return 1
    case "$command" in
        add) add_worktree "$@" ;;
        path) checkout_of_branch "$@" ;;
        rm)
            if [ "$1" = --merged ]; then
                remove_merged_branches "$invoking_branch"
            else
                remove_branches "$@"
            fi
            ;;
        sweep) sweep "$([ "${1:-}" = "-n" ] && echo true || echo false)" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

#!/bin/bash

set -euo pipefail

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <plugin-name> <target-version>"
    exit 1
fi

PLUGIN_NAME=$1
TARGET_VERSION=$2
ESCAPED_PLUGIN_NAME=$(echo "$PLUGIN_NAME" | sed 's/\//\\\//g')

while IFS= read -r -d '' file; do
    if grep -q "${ESCAPED_PLUGIN_NAME}@" "$file"; then
        sed -i.bak "s/${ESCAPED_PLUGIN_NAME}@[a-zA-Z0-9_.-]*/${ESCAPED_PLUGIN_NAME}@${TARGET_VERSION}/g" "$file"
        if ! cmp -s "$file" "$file.bak"; then
            echo "Updated $file"
        fi
        rm -f "$file.bak"
    fi
done < <(find "$(pwd)" -maxdepth 5 -type f -path "*/.github/workflows/*" -name "*.yml" -print0)

echo "Replacement process completed."


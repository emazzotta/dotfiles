#!/bin/bash

set -uo pipefail

root_dir="$(pwd)"
[ -n "${1:-}" ] && root_dir="${1}"

[ -f "${CUSTOM_BIN_DIR}/prettyprint" ] && source "${CUSTOM_BIN_DIR}/prettyprint"
# shellcheck source=repolib.sh
source "$(dirname "${BASH_SOURCE[0]}")/repolib.sh"

CUSTOM_RELEASE_PATTERN='^[0-9]+\.([0-9]+|x)(\.[0-9]+|\.x)?$'

failed_pulls_file=$(mktemp)
unreachable_file=$(mktemp)
repo_failures_file=$(mktemp)
status_file=$(mktemp)
trap 'rm -f "${failed_pulls_file}" "${unreachable_file}" "${repo_failures_file}" "${status_file}"' EXIT

record_failed_pull() {
    local branch="$1"
    if ! grep -qxF -- "${branch}" "${repo_failures_file}"; then
        printf '%s\n' "${branch}" >> "${repo_failures_file}"
    fi
}

convert_git_url_to_http() {
    local git_url="$1"
    [[ "$git_url" =~ ^git@ ]] && git_url=$(echo "$git_url" | sed -E 's#git@([^:]+):#https://\1/#')
    echo "${git_url%.git}"
}

has_remote_access() {
    curl -k --silent --head --connect-timeout 5 "$1" &>/dev/null
}

has_git_access() {
    local remote_url
    remote_url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
    has_remote_access "$(convert_git_url_to_http "$remote_url")"
}

rebase_in_progress() {
    local git_dir
    git_dir=$(git -C "$1" rev-parse --absolute-git-dir) || return 1
    [ -d "${git_dir}/rebase-merge" ] || [ -d "${git_dir}/rebase-apply" ]
}

pull_or_record_failure() {
    local branch="$1" dir="$2" rebase_was_running=false
    if rebase_in_progress "${dir}"; then
        rebase_was_running=true
    fi
    git -C "${dir}" pull --quiet --rebase="$(rh_rebase_mode "${branch}")" &>/dev/null && return 0
    if [ "${rebase_was_running}" = false ]; then
        git -C "${dir}" rebase --abort &>/dev/null || true
    fi
    record_failed_pull "${branch}"
}

pull_branch() {
    local branch="$1" dir="$2"
    [ -n "${dir}" ] || return 0
    if git -C "${dir}" rev-parse --verify "origin/${branch}" &>/dev/null; then
        git -C "${dir}" checkout "${branch}" &>/dev/null || return 0
        pull_or_record_failure "${branch}" "${dir}"
        git -C "${dir}" checkout --quiet - &>/dev/null || true
    fi
}

pull_branches_by_regex() {
    local pattern="$1" dir="$2"
    [ -n "${dir}" ] || return 0
    git -C "${dir}" branch -r \
        | sed 's/origin\///g' \
        | sed 's/ //g' \
        | grep -E "${pattern}" \
        | while read -r branch; do
            pull_branch "${branch}" "${dir}"
          done || true
}

render_failed_pulls() {
    local dir="$1"
    local width branch
    width=$(rh_longest_name < "${repo_failures_file}")
    printf '%s\n' "$(rh_repo_link "${dir}" "${root_dir}")"
    while IFS= read -r branch; do
        printf '  %s%*s  %s\n' "${branch}" "$((width - ${#branch}))" '' "${BOLD}${RED}pull failed${RESET}"
    done < "${repo_failures_file}"
}

update_repo() {
    local dir="$1"
    local branch_name
    : > "${repo_failures_file}"
    pull_branch "main" "${dir}"
    pull_branch "master" "${dir}"
    pull_branches_by_regex "${CUSTOM_RELEASE_PATTERN}" "${dir}"
    branch_name=$(git -C "${dir}" symbolic-ref -q --short HEAD) || branch_name=""
    if [ -n "${branch_name}" ] && [ "${branch_name}" != "master" ] && [ "${branch_name}" != "main" ]; then
        pull_or_record_failure "${branch_name}" "${dir}"
    fi
    if [ -s "${repo_failures_file}" ]; then
        render_failed_pulls "${dir}" >> "${failed_pulls_file}"
    fi
}

update_repos() {
    rh_find_dirs "${root_dir}" | while read -r dir; do
        [ -d "${dir}/.git" ] || continue
        rh_ignored gupallin "${dir}" && continue
        printf '%s' "${dir}" > "${status_file}"
        if has_git_access "${dir}"; then
            update_repo "${dir}"
        else
            printf '%s\n' "$(rh_repo_link "${dir}" "${root_dir}")" >> "${unreachable_file}"
        fi
    done
}

update_repos &
UPDATE_PID=$!
rh_spin "${UPDATE_PID}" "${status_file}"
wait "${UPDATE_PID}" || true

cat "${failed_pulls_file}"
rh_print_warnings "No remote access:" "${unreachable_file}"

echo
success "Done."

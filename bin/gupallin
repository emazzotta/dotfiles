#!/bin/bash

set -uo pipefail

root_dir="$(pwd)"
[ -n "${1:-}" ] && root_dir="${1}"

[ -f "${CUSTOM_BIN_DIR}/prettyprint" ] && source "${CUSTOM_BIN_DIR}/prettyprint"

CUSTOM_RELEASE_PATTERN="^[0-9]+.([0-9]+|x)(.[0-9]+|.x)?$"

failed_pulls_file=$(mktemp)
unreachable_file=$(mktemp)
repo_failures_file=$(mktemp)
status_file=$(mktemp)
trap 'rm -f "${failed_pulls_file}" "${unreachable_file}" "${repo_failures_file}" "${status_file}"' EXIT

record_failed_pull() {
    local branch="$1"
    if ! grep -qxF -- "${branch}" "${repo_failures_file}"; then
        printf '%s\n' "${branch}" >> "${repo_failures_file}"
    fi
}

convert_git_url_to_http() {
    local git_url="$1"
    [[ "$git_url" =~ ^git@ ]] && git_url=$(echo "$git_url" | sed -E 's#git@([^:]+):#https://\1/#')
    echo "${git_url%.git}"
}

has_remote_access() {
    curl -k --silent --head --connect-timeout 5 "$1" &>/dev/null
}

has_git_access() {
    local remote_url
    remote_url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
    has_remote_access "$(convert_git_url_to_http "$remote_url")"
}

pull_branch() {
    local branch="$1" dir="$2"
    [ -n "${dir}" ] || return 0
    if git -C "${dir}" rev-parse --verify "origin/${branch}" &>/dev/null; then
        git -C "${dir}" checkout "${branch}" &>/dev/null || return 0
        git -C "${dir}" pull --quiet --rebase &>/dev/null || record_failed_pull "${branch}"
        git -C "${dir}" checkout --quiet - &>/dev/null || true
    fi
}

pull_branches_by_regex() {
    local pattern="$1" dir="$2"
    [ -n "${dir}" ] || return 0
    git -C "${dir}" branch -r \
        | sed 's/origin\///g' \
        | sed 's/ //g' \
        | grep -E "${pattern}" \
        | while read -r branch; do
            pull_branch "${branch}" "${dir}"
          done || true
}

repo_link() {
    local dir="$1"
    local path label
    path=$(git -C "${dir}" rev-parse --show-toplevel)
    label="${dir#"${root_dir%/}"/}"
    if [ "${dir}" = "${root_dir}" ]; then
        label="${path##*/}"
    fi
    hyperlink "file://${path}" "${YELLOW}${label}${RESET}"
}

longest_name() {
    local width=0
    local name
    while IFS= read -r name; do
        if [ "${#name}" -gt "${width}" ]; then
            width=${#name}
        fi
    done
    printf '%s' "${width}"
}

render_failed_pulls() {
    local dir="$1"
    local width branch
    width=$(longest_name < "${repo_failures_file}")
    printf '%s\n' "$(repo_link "${dir}")"
    while IFS= read -r branch; do
        printf '  %s%*s  %s\n' "${branch}" "$((width - ${#branch}))" '' "${BOLD}${RED}pull failed${RESET}"
    done < "${repo_failures_file}"
}

update_repo() {
    local dir="$1"
    local branch_name
    : > "${repo_failures_file}"
    pull_branch "main" "${dir}"
    pull_branch "master" "${dir}"
    pull_branches_by_regex "${CUSTOM_RELEASE_PATTERN}" "${dir}"
    branch_name=$(git -C "${dir}" rev-parse --abbrev-ref HEAD)
    if [ "${branch_name}" != "master" ] && [ "${branch_name}" != "main" ]; then
        git -C "${dir}" pull --quiet --rebase &>/dev/null || record_failed_pull "${branch_name}"
    fi
    if [ -s "${repo_failures_file}" ]; then
        render_failed_pulls "${dir}" >> "${failed_pulls_file}"
    fi
}

update_repos() {
    find "${root_dir}" -mindepth 0 -maxdepth 3 -type d -or -type l | while read -r dir; do
        [ -d "${dir}/.git" ] || continue
        printf '%s' "${dir}" > "${status_file}"
        if has_git_access "${dir}"; then
            update_repo "${dir}"
        else
            printf '%s\n' "$(repo_link "${dir}")" >> "${unreachable_file}"
        fi
    done
}

print_warnings() {
    local heading="$1"
    local file="$2"
    if [ ! -s "${file}" ]; then
        return 0
    fi
    echo
    error "${heading}"
    local warning
    while IFS= read -r warning; do
        substep_error "${warning}"
    done < "${file}"
}

spin() {
    local spinners='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0
    while kill -0 "${UPDATE_PID}" 2>/dev/null; do
        local current
        current=$(cat "${status_file}" 2>/dev/null || echo "")
        printf "\033[2K\r  ${YELLOW}%s${RESET}  %s" "${spinners:$((i % 10)):1}" "${current}" >&2
        sleep 0.1
        i=$((i + 1))
    done
    printf "\r%-100s\r" "" >&2
}

update_repos &
UPDATE_PID=$!
spin
wait "${UPDATE_PID}" || true

cat "${failed_pulls_file}"
print_warnings "No remote access:" "${unreachable_file}"

echo
success "Done."

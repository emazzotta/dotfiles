#!/bin/bash
# Update Claude Code marketplaces and plugins without the private SSH key ever entering
# the container. Two ends of one flow, picked by host:
#   Mac       - invoked by the keyguard bridge endpoint `claude-plugin-update`: refresh a
#               bare mirror of every SSH marketplace repo with the login-keychain key.
#   Container - POST that endpoint, then update plugins. A git conditional include scoped
#               to the plugins dir rewrites each SSH marketplace URL to its mirror, so the
#               /plugin UI and background refreshes stay key-less too.
#
# The mirrors exist because Claude Code refreshes a marketplace by replacing its clone:
# pointing the rewrite at that same clone makes the CLI its own fetch source and leaves an
# empty repo behind. A mirror is a directory the CLI never manages.
set -uo pipefail

readonly BRIDGE_ENDPOINT="claude-plugin-update"
readonly PLUGINS_DIR="$HOME/.claude/plugins"
readonly MIRRORS_DIR="$PLUGINS_DIR/ssh-mirrors"
readonly KNOWN_MARKETPLACES_FILE="$PLUGINS_DIR/known_marketplaces.json"
readonly INSTALLED_PLUGINS_FILE="$PLUGINS_DIR/installed_plugins.json"
readonly REWRITES_FILE="$HOME/.gitconfig-claude-plugins"

show_usage() {
    cat << EOF
Usage: $(basename "$0") [PLUGIN_FILTER ...]
       $(basename "$0") --write-git-rewrites

In the container: refresh the SSH marketplace mirrors on the Mac (keyguard bridge
endpoint '$BRIDGE_ENDPOINT'), then update every user-scope plugin from those mirrors.
No SSH key reaches this container.

With no argument every installed plugin is updated. Each PLUGIN_FILTER is matched as a
substring against 'plugin@marketplace', so 'leonardo' updates leonardo@leonardo-skills.

--write-git-rewrites only refreshes the git URL rewrites and exits, for the SessionStart
hook. Container-only: on the Mac those rewrites would redirect the mirrors to themselves.

On the Mac this is the bridge endpoint itself: it mirrors every SSH marketplace repo into
$MIRRORS_DIR and prints a per-marketplace report. Arguments are ignored there.
EOF
}

check_required_commands() {
    local cmd missing=()
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    if [ ${#missing[@]} -gt 0 ]; then
        printf 'Missing required command(s): %s\n' "${missing[*]}" >&2
        return 1
    fi
}

find_ssh_marketplaces() {
    python3 - "$KNOWN_MARKETPLACES_FILE" << 'PY'
import json
import sys

try:
    with open(sys.argv[1]) as handle:
        marketplaces = json.load(handle)
except (OSError, ValueError):
    sys.exit(0)

for name, entry in sorted(marketplaces.items()):
    source = entry.get("source", {})
    url = source.get("url", "")
    if source.get("source") == "git" and (url.startswith("git@") or url.startswith("ssh://")):
        print("%s\t%s" % (name, url))
PY
}

use_login_ssh_agent() {
    if [ -z "${SSH_AUTH_SOCK:-}" ]; then
        # launchd starts the bridge without SSH_AUTH_SOCK; the GUI session's agent holds the key.
        SSH_AUTH_SOCK="$(launchctl getenv SSH_AUTH_SOCK 2>/dev/null)"
        if [ -n "$SSH_AUTH_SOCK" ]; then
            export SSH_AUTH_SOCK
        fi
    fi
}

mirror_marketplace() {
    local name="$1" url="$2"
    local mirror="$MIRRORS_DIR/$name.git"
    local before after error
    if [ ! -d "$mirror" ]; then
        if ! error="$(git clone --mirror "$url" "$mirror" 2>&1)"; then
            printf '%s: FAILED to mirror - %s\n' "$name" "$(printf '%s' "$error" | tr '\n' ' ')"
            return 1
        fi
        printf '%s: mirrored (%s)\n' "$name" "$(git -C "$mirror" rev-parse --short HEAD 2>/dev/null)"
        return 0
    fi
    before="$(git -C "$mirror" rev-parse --short HEAD 2>/dev/null)"
    if ! error="$(git -C "$mirror" remote update --prune 2>&1)"; then
        printf '%s: FAILED - %s\n' "$name" "$(printf '%s' "$error" | tr '\n' ' ')"
        return 1
    fi
    after="$(git -C "$mirror" rev-parse --short HEAD 2>/dev/null)"
    if [ "$before" = "$after" ]; then
        printf '%s: up to date (%s)\n' "$name" "$after"
    else
        printf '%s: %s -> %s\n' "$name" "$before" "$after"
    fi
    return 0
}

refresh_mirrors_with_login_key() {
    use_login_ssh_agent
    mkdir -p "$MIRRORS_DIR"
    local name url total=0 failures=0
    while IFS=$'\t' read -r name url; do
        [ -n "$name" ] || continue
        total=$((total + 1))
        mirror_marketplace "$name" "$url" || failures=$((failures + 1))
    done < <(find_ssh_marketplaces)
    printf '%s SSH marketplace(s), %s failed\n' "$total" "$failures"
    # Exit 0 even on failures: the bridge only relays stdout on a 200, and the report
    # above is more useful to the caller than an opaque bridge error.
    return 0
}

refresh_mirrors_on_mac() {
    printf 'Refreshing marketplace mirrors on the Mac...\n'
    if ! envify --bridge "$BRIDGE_ENDPOINT"; then
        printf 'Bridge call failed - updating from the mirrors as they are.\n' >&2
    fi
}

build_git_rewrite_config() {
    local name url mirror
    while IFS=$'\t' read -r name url; do
        mirror="$MIRRORS_DIR/$name.git"
        if [ ! -d "$mirror" ]; then
            printf 'No mirror for %s yet.\n' "$name" >&2
            continue
        fi
        printf '[url "%s"]\n\tinsteadOf = %s\n' "$mirror" "$url"
    done < <(find_ssh_marketplaces)
}

write_git_rewrites() {
    if [ "$(uname -s)" = "Darwin" ]; then
        printf 'Refusing to write git rewrites on the Mac - see --help.\n' >&2
        return 1
    fi
    local content include_key
    content="$(build_git_rewrite_config)"
    if [ ! -f "$REWRITES_FILE" ] || [ "$content" != "$(cat "$REWRITES_FILE")" ]; then
        printf '%s\n' "$content" > "$REWRITES_FILE"
    fi
    include_key="includeIf.gitdir:$PLUGINS_DIR/.path"
    if [ "$(git config --global --get "$include_key" 2>/dev/null)" != "$REWRITES_FILE" ]; then
        git config --global "$include_key" "$REWRITES_FILE"
    fi
}

require_complete_rewrites() {
    local expected actual
    expected="$(find_ssh_marketplaces | wc -l | tr -d ' ')"
    actual="$(grep -c '^\[url ' "$REWRITES_FILE" 2>/dev/null)"
    if [ "${actual:-0}" -lt "$expected" ]; then
        printf 'Only %s of %s SSH marketplaces have a mirror. Refusing to update: the missing\n' \
            "${actual:-0}" "$expected" >&2
        printf 'ones would fetch over SSH from here, which can leave an empty clone behind.\n' >&2
        return 1
    fi
}

find_user_scope_plugins() {
    jq -r '.plugins | to_entries[] | select(any(.value[]; .scope == "user")) | .key' \
        "$INSTALLED_PLUGINS_FILE" 2>/dev/null
}

matches_filter() {
    local plugin="$1"
    shift
    [ $# -eq 0 ] && return 0
    local filter
    for filter in "$@"; do
        case "$plugin" in
            *"$filter"*) return 0 ;;
        esac
    done
    return 1
}

update_plugins_from_mirrors() {
    local plugin checked=0
    claude plugin marketplace update
    while IFS= read -r plugin; do
        if matches_filter "$plugin" "$@"; then
            claude plugin update "$plugin" -y
            checked=$((checked + 1))
        fi
    done < <(find_user_scope_plugins)
    printf '%s plugin(s) checked. Restart Claude Code to pick up new versions.\n' "$checked"
}

main() {
    case "${1:-}" in
        -h|--help)
            show_usage
            return 0
            ;;
        --write-git-rewrites)
            check_required_commands git python3 || return 1
            write_git_rewrites
            return
            ;;
    esac

    if [ ! -f "$KNOWN_MARKETPLACES_FILE" ]; then
        printf 'No marketplace registry: %s\n' "$KNOWN_MARKETPLACES_FILE" >&2
        return 1
    fi

    if [ "$(uname -s)" = "Darwin" ]; then
        check_required_commands git python3 || return 1
        refresh_mirrors_with_login_key
        return 0
    fi

    check_required_commands claude envify git jq python3 || return 1
    if [ ! -f "$INSTALLED_PLUGINS_FILE" ]; then
        printf 'No installed plugins file: %s\n' "$INSTALLED_PLUGINS_FILE" >&2
        return 1
    fi
    refresh_mirrors_on_mac
    write_git_rewrites || return 1
    require_complete_rewrites || return 1
    update_plugins_from_mirrors "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

#!/bin/bash

set -euo pipefail

source "${CUSTOM_BIN_DIR}/prettyprint"

show_usage() {
    cat <<EOF
Usage: $(basename "${0}") [-f|--fast] [-v|--verbose] [dir]

Show each git repo under dir (default: \$WDIR) that has uncommitted, unpushed or
stashed work or branches besides the default branch: the default branch with its
CI state, then one row per branch. Repos with work to push, commit or unstash
come first; everything that needs no action is dimmed.

  💻        local branch
  ⛅        branch only on origin
  ✓ ✗ ● 💤  CI passed, failed, running, no pipeline
  ↓N        commits behind the default branch
  ↑N        commits not pushed
  ✎N        uncommitted files
  ✭N        stashes

Options:
  -f, --fast       skip the CI lookups
  -v, --verbose    list each uncommitted file, unpushed commit and stash
  -h, --help       show this help
EOF
}

fast=false
verbose=false
scan_dir=""
while [ $# -gt 0 ]; do
    case "${1}" in
        -h|--help) show_usage; exit 0 ;;
        -f|--fast) fast=true ;;
        -v|--verbose) verbose=true ;;
        -*) printf 'unknown option: %s\n' "${1}" >&2; show_usage >&2; exit 2 ;;
        *) scan_dir="${1}" ;;
    esac
    shift
done
scan_dir="${scan_dir:-${WDIR}}"

ignore_dirs=("dev")
bot_branch_pattern='^(renovate|dependabot|greenkeeper|snyk|whitesource-remediate|pyup)[/-]'
pull_request_cache_dir="${HOME}/.cache/gck"
pull_request_cache_minutes=10
behind_column_width=5
detail_indent="        "
no_pipeline_mark="💤"
local_branch_mark="💻"
remote_only_mark="⛅"
unpushed_mark="↑"
uncommitted_mark="✎"
stash_mark="✭"
mkdir -p "${pull_request_cache_dir}"

action_file=$(mktemp)
info_file=$(mktemp)
block_file=$(mktemp)
rows_file=$(mktemp)
status_file=$(mktemp)
links_file=$(mktemp)
pull_requests_file=$(mktemp)
pull_request_warnings_file=$(mktemp)
fetch_error_file=$(mktemp)
ci_states_file=$(mktemp)
ci_errors_file=$(mktemp)
ci_warnings_file=$(mktemp)
trap 'rm -f "${action_file}" "${info_file}" "${block_file}" "${rows_file}" "${status_file}" "${links_file}" "${pull_requests_file}" "${pull_request_warnings_file}" "${fetch_error_file}" "${ci_states_file}" "${ci_errors_file}" "${ci_warnings_file}"' EXIT

remote_slug() {
    local dir="${1}"
    local remote
    remote=$(git -C "${dir}" remote get-url origin 2>/dev/null) || return 0
    remote="${remote%.git}"
    case "${remote}" in
        *://*) remote="${remote#*://}" ;;
        *:*) remote="${remote%%:*}/${remote#*:}" ;;
        *) return 0 ;;
    esac
    printf '%s' "${remote#*@}"
}

tree_url_prefix() {
    local slug="${1}"
    case "${slug%%/*}" in
        *gitlab*) printf 'https://%s/-/tree/' "${slug}" ;;
        *) printf 'https://%s/tree/' "${slug}" ;;
    esac
}

add_warning() {
    local file="${1}"
    local message="${2}"
    if grep -qxF "${message}" "${file}"; then
        return 0
    fi
    printf '%s\n' "${message}" >> "${file}"
}

print_warnings() {
    local heading="${1}"
    local file="${2}"
    if [ ! -s "${file}" ]; then
        return 0
    fi
    echo
    error "${heading}"
    local warning
    while IFS= read -r warning; do
        substep_error "${warning}"
    done < "${file}"
}

fetch_pull_requests() {
    local slug="${1}"
    local cache_file
    cache_file="${pull_request_cache_dir}/$(printf '%s' "${slug}" | tr '/.' '__')"
    if [ -n "$(find "${cache_file}" -mmin "-${pull_request_cache_minutes}" 2>/dev/null)" ]; then
        cat "${cache_file}"
        return 0
    fi
    local client
    local client_command
    case "${slug%%/*}" in
        github.com)
            client="gh"
            client_command=(gh pr list --repo "${slug#*/}" --state open --limit 100
                --json "headRefName,url" --jq '.[] | "\(.headRefName)\t\(.url)"')
            ;;
        *)
            client="glab"
            client_command=(glab mr list --repo "https://${slug}" --per-page 100 --output json
                --jq '.[] | "\(.source_branch)\t\(.web_url)"')
            ;;
    esac
    if ! command -v "${client}" > /dev/null; then
        add_warning "${pull_request_warnings_file}" "${slug}: ${client} is not installed"
        return 0
    fi
    local pairs=""
    local status=0
    pairs=$("${client_command[@]}" 2> "${fetch_error_file}") || status=$?
    if [ "${status}" -ne 0 ]; then
        local reason
        reason=$(head -1 "${fetch_error_file}")
        if [ -z "${reason}" ]; then
            reason="${client} exited with status ${status}"
        fi
        add_warning "${pull_request_warnings_file}" "${slug}: ${reason}"
        return 0
    fi
    printf '%s\n' "${pairs}" | tee "${cache_file}"
}

build_branch_links() {
    local dir="${1}"
    local slug
    slug=$(remote_slug "${dir}")
    [ -n "${slug}" ] || return 0
    local prefix
    prefix=$(tree_url_prefix "${slug}")
    fetch_pull_requests "${slug}" > "${pull_requests_file}"
    local branch url
    while IFS= read -r branch; do
        [ -n "${branch}" ] || continue
        url=$(awk -F'\t' -v b="${branch}" '$1 == b { print $2; exit }' "${pull_requests_file}")
        [ -n "${url}" ] || url="${prefix}${branch}"
        printf '%s\t%s\n' "${branch}" "${url}"
    done >> "${links_file}"
}

format_branch() {
    local branch="${1}"
    local emphasis="${2:-}"
    local color=""
    if [[ "${branch}" =~ ${bot_branch_pattern} ]]; then
        color="${TURQUOISE}"
    fi
    local label="${emphasis}${color}${branch}${RESET}"
    local url
    url=$(awk -F'\t' -v b="${branch}" '$1 == b { print $2; exit }' "${links_file}")
    if [ -n "${url}" ]; then
        hyperlink "${url}" "${label}"
    else
        printf '%s' "${label}"
    fi
}

default_branch_ref() {
    local dir="${1}"
    local ref
    if ref=$(git -C "${dir}" symbolic-ref -q --short refs/remotes/origin/HEAD); then
        printf '%s' "${ref}"
        return 0
    fi
    for ref in origin/main origin/master; do
        if git -C "${dir}" show-ref --verify --quiet "refs/remotes/${ref}"; then
            printf '%s' "${ref}"
            return 0
        fi
    done
}

remote_only_branches() {
    local dir="${1}"
    local origin_branches="${2}"
    local branch
    while IFS= read -r branch; do
        if [ -n "${branch}" ] && ! git -C "${dir}" show-ref --verify --quiet "refs/heads/${branch}"; then
            printf '%s\n' "${branch}"
        fi
    done <<< "${origin_branches}"
}

build_ci_states() {
    local dir="${1}"
    local branches="${2}"
    local slug
    slug=$(remote_slug "${dir}")
    [ -n "${slug}" ] || return 0
    printf '%s\n' "${branches}" | python3 "${CUSTOM_BIN_DIR}/branch_ci.py" "${slug}" \
        > "${ci_states_file}" 2> "${ci_errors_file}" || true
    local warning
    while IFS= read -r warning; do
        add_warning "${ci_warnings_file}" "${slug}: ${warning}"
    done < "${ci_errors_file}"
}

load_ci_state() {
    local branch="${1}"
    local category url color
    ci_state=""
    ci_mark=" "
    ci_mark_padding=" "
    ci_label=""
    IFS=$'\037' read -r ci_state category url < <(awk -F'\t' -v b="${branch}" \
        'BEGIN { OFS = "\037" } $1 == b { print $2, $3, $4; exit }' "${ci_states_file}") || return 0
    case "${ci_state}" in
        none) ci_mark="${no_pipeline_mark}"; ci_mark_padding=""; return 0 ;;
        success) color="${GREEN}"; ci_mark="✓" ;;
        failed) color="${RED}"; ci_mark="✗"; ci_label="${category}" ;;
        *) color="${YELLOW}"; ci_mark="●"; ci_label="${ci_state}" ;;
    esac
    ci_mark=$(hyperlink "${url}" "${color}${ci_mark}${RESET}")
    if [ -n "${ci_label}" ]; then
        ci_label=$(hyperlink "${url}" "${color}${ci_label}${RESET}")
    fi
}

count_behind() {
    local dir="${1}"
    local ref="${2}"
    local default_ref="${3}"
    if [ -z "${default_ref}" ]; then
        printf '0'
        return 0
    fi
    git -C "${dir}" rev-list --count "${ref}..${default_ref}" 2>/dev/null || printf '0'
}

pad() {
    local width="${1}"
    if [ "${width}" -gt 0 ]; then
        printf '%*s' "${width}" ''
    fi
}

format_behind() {
    local behind="${1}"
    if [ "${behind}" -eq 0 ]; then
        pad "${behind_column_width}"
        return 0
    fi
    printf '%s↓%s%s' "${YELLOW}" "${behind}" "${RESET}"
    pad $((behind_column_width - 1 - ${#behind}))
}

branch_emphasis() {
    if [ "${1}" = "${current_branch}" ]; then
        printf '%s' "${BOLD}"
    fi
}

is_listed() {
    printf '%s\n' "${2}" | grep -qxF -- "${1}"
}

count_lines() {
    awk 'END { print NR }'
}

join_notes() {
    local joined=""
    local note
    for note in "$@"; do
        if [ -n "${note}" ]; then
            joined="${joined:+${joined}  }${note}"
        fi
    done
    printf '%s' "${joined}"
}

count_note() {
    local color="${1}"
    local mark="${2}"
    local count="${3}"
    if [ "${count}" -gt 0 ]; then
        printf '%s%s%s%s%s' "${BOLD}" "${color}" "${mark}" "${count}" "${RESET}"
    fi
}

dim_line() {
    local redim="${RESET}${DIM}"
    printf '%s%s%s' "${DIM}" "${1//"${RESET}"/${redim}}" "${RESET}"
}

render_branch_row() {
    local dir="${1}"
    local branch="${2}"
    local ref="${3}"
    local default_ref="${4}"
    local width="${5}"
    local location_mark="${6}"
    local actions="${7}"
    local notes="${8}"
    local behind
    behind=$(count_behind "${dir}" "${ref}" "${default_ref}")
    load_ci_state "${branch}"
    local row
    row="  ${location_mark} ${ci_mark}${ci_mark_padding} $(format_branch "${branch}" "$(branch_emphasis "${branch}")")$(pad $((width - ${#branch} + 2)))"
    row="${row}$(format_behind "${behind}") $(join_notes "${actions}" "${ci_label}" "${notes}")"
    row="${row%"${row##*[![:space:]]}"}"
    if [ -z "${actions}" ]; then
        row=$(dim_line "${row}")
    fi
    printf '%s\n' "${row}"
}

unpushed_branches() {
    local dir="${1}"
    local branch
    git -C "${dir}" for-each-ref --format='%(refname:short)' refs/heads/ | while IFS= read -r branch; do
        if [ -n "$(git -C "${dir}" rev-list --max-count=1 "refs/heads/${branch}" --not --remotes)" ]; then
            printf '%s\n' "${branch}"
        fi
    done
}

describe_divergence() {
    local dir="${1}"
    local ref="${2}"
    local target="${3}"
    local ahead behind
    read -r ahead behind < <(git -C "${dir}" rev-list --left-right --count "${ref}...${target}")
    printf '%s%s' "${unpushed_mark}" "${ahead}"
    if [ "${behind}" -gt 0 ]; then
        printf ' diverged'
    fi
}

describe_push_state() {
    local dir="${1}"
    local branch="${2}"
    local upstream
    upstream=$(git -C "${dir}" for-each-ref --format='%(upstream)' "refs/heads/${branch}")
    local target="${upstream:-refs/remotes/origin/${branch}}"
    if git -C "${dir}" show-ref --verify --quiet "${target}"; then
        describe_divergence "${dir}" "refs/heads/${branch}" "${target}"
        return 0
    fi
    printf '%s%s' "${unpushed_mark}" "$(git -C "${dir}" rev-list --count "refs/heads/${branch}" --not --remotes)"
    if [ -n "${upstream}" ]; then
        printf ' gone from origin'
    else
        printf ' not on origin'
    fi
}

push_note() {
    local dir="${1}"
    local branch="${2}"
    if [ -n "${branch}" ] && is_listed "${branch}" "${unpushed}"; then
        printf '%s%s%s' "${BOLD}${YELLOW}" "$(describe_push_state "${dir}" "${branch}")" "${RESET}"
    fi
}

linked_worktree_branches() {
    git -C "${1}" worktree list --porcelain | awk '
        /^worktree / { linked = count++ > 0 }
        linked && /^branch refs\/heads\// { print substr($0, 19) }'
}

checkout_of() {
    local dir="${1}"
    local branch="${2}"
    if [ "${branch}" = "${current_branch}" ]; then
        printf '%s' "${dir}"
    elif is_listed "${branch}" "${worktree_branches}"; then
        git -C "${dir}" wt path "${branch}" 2>/dev/null
    fi
}

count_uncommitted() {
    local changes
    changes=$(git -C "${1}" status --porcelain --untracked-files=all 2>/dev/null) || changes=""
    printf '%s' "${changes}" | count_lines
}

indent_details() {
    sed "s/^/${detail_indent}/"
}

render_unpushed_commits() {
    local dir="${1}"
    local branch="${2}"
    if [ -n "${branch}" ] && is_listed "${branch}" "${unpushed}"; then
        git -C "${dir}" log --pretty=tformat:'%h - %an, %ar: %s' "refs/heads/${branch}" --not --remotes | indent_details
    fi
}

render_changed_files() {
    git -c color.ui=always -C "${1}" status --short --untracked-files=all | indent_details
}

render_details() {
    local dir="${1}"
    local branch="${2}"
    local checkout="${3}"
    local uncommitted="${4}"
    render_unpushed_commits "${dir}" "${branch}"
    if [ "${uncommitted}" -gt 0 ]; then
        render_changed_files "${checkout}"
    fi
}

render_repo_details() {
    local dir="${1}"
    local branch="${2}"
    local uncommitted="${3}"
    local stashes="${4}"
    render_details "${dir}" "${branch}" "${dir}" "${uncommitted}"
    if [ "${stashes}" -gt 0 ]; then
        git -c color.ui=always -C "${dir}" stash list | indent_details
    fi
}

repo_link() {
    local dir="${1}"
    local path label
    path=$(git -C "${dir}" rev-parse --show-toplevel)
    label="${dir#"${scan_dir%/}"/}"
    if [ "${dir}" = "${scan_dir}" ]; then
        label="${path##*/}"
    fi
    hyperlink "file://${path}" "${YELLOW}${label}${RESET}"
}

repo_actions() {
    local dir="${1}"
    local branch="${2}"
    local uncommitted="${3}"
    local stashes="${4}"
    join_notes "$(push_note "${dir}" "${branch}")" \
        "$(count_note "${RED}" "${uncommitted_mark}" "${uncommitted}")" \
        "$(count_note "${CYAN}" "${stash_mark}" "${stashes}")"
}

render_repo_header() {
    local dir="${1}"
    local branch="${2}"
    local actions="${3}"
    local header
    header=$(repo_link "${dir}")
    load_ci_state "${branch}"
    if [ -n "${branch}" ]; then
        header="${header}  ${branch}"
    fi
    if [ -n "${ci_state}" ]; then
        header="${header} ${ci_mark}"
    fi
    local notes
    notes=$(join_notes "${ci_label}" "${actions}")
    header="${header}${notes:+  ${notes}}"
    if [ "${needs_action}" = false ]; then
        header=$(dim_line "${header}")
    fi
    printf '%s\n' "${header}"
}

render_local_branch() {
    local branch="${1}"
    local dir="${2}"
    local default_ref="${3}"
    local width="${4}"
    local checkout="" uncommitted=0 missing="" actions=""
    if checkout=$(checkout_of "${dir}" "${branch}"); then
        if [ -n "${checkout}" ]; then
            uncommitted=$(count_uncommitted "${checkout}")
        fi
    else
        missing="${CYAN}worktree missing here${RESET}"
    fi
    actions=$(join_notes "$(push_note "${dir}" "${branch}")" "$(count_note "${RED}" "${uncommitted_mark}" "${uncommitted}")")
    if [ -n "${actions}" ]; then
        needs_action=true
    fi
    render_branch_row "${dir}" "${branch}" "refs/heads/${branch}" "${default_ref}" "${width}" "${local_branch_mark}" \
        "${actions}" "${missing}"
    if [ "${verbose}" = true ]; then
        render_details "${dir}" "${branch}" "${checkout}" "${uncommitted}"
    fi
}

render_remote_branch() {
    local branch="${1}"
    local dir="${2}"
    local default_ref="${3}"
    local width="${4}"
    render_branch_row "${dir}" "${branch}" "refs/remotes/origin/${branch}" "${default_ref}" "${width}" "${remote_only_mark}" "" ""
}

render_rows() {
    local renderer="${1}"
    local branches="${2}"
    shift 2
    local branch
    while IFS= read -r branch; do
        if [ -n "${branch}" ]; then
            "${renderer}" "${branch}" "$@"
        fi
    done <<< "${branches}"
}

longest_name() {
    local width=0
    local name
    while IFS= read -r name; do
        if [ "${#name}" -gt "${width}" ]; then
            width=${#name}
        fi
    done
    printf '%s' "${width}"
}

local_branch_names() {
    git -C "${1}" for-each-ref --format='%(refname:short)' refs/heads/ | grep -Ev '^(main|master)$' || true
}

origin_branch_names() {
    git -C "${1}" for-each-ref --format='%(refname:short)' refs/remotes/origin/ \
        | grep -Ev '^origin$|origin/(HEAD|main|master)$' \
        | sed 's#^origin/##' || true
}

header_branch_of() {
    local default_ref="${1}"
    if [ -n "${default_ref}" ]; then
        printf '%s' "${default_ref#origin/}"
    elif [ "${current_branch}" != HEAD ]; then
        printf '%s' "${current_branch}"
    fi
}

fetch_branch_states() {
    local dir="${1}"
    local origin_branches="${2}"
    local branches="${3}"
    : > "${links_file}"
    : > "${ci_states_file}"
    if [ -n "${origin_branches}" ]; then
        printf '%s\n' "${origin_branches}" | build_branch_links "${dir}"
    fi
    if [ "${fast}" = false ]; then
        build_ci_states "${dir}" "${branches}"
    fi
}

render_repo() {
    local dir="${1}"
    local origin_branches="${2}"
    local local_branches="${3}"
    local remote_branches="${4}"
    local uncommitted="${5}"
    local stashes="${6}"
    local default_ref header_branch width actions
    default_ref=$(default_branch_ref "${dir}")
    header_branch=$(header_branch_of "${default_ref}")
    fetch_branch_states "${dir}" "${origin_branches}" "$(printf '%s\n' "${header_branch}" "${local_branches}" "${remote_branches}")"
    actions=$(repo_actions "${dir}" "${header_branch}" "${uncommitted}" "${stashes}")
    needs_action=false
    if [ -n "${actions}" ]; then
        needs_action=true
    fi
    width=$(printf '%s\n' "${local_branches}" "${remote_branches}" | longest_name)
    render_rows render_local_branch "${local_branches}" "${dir}" "${default_ref}" "${width}" > "${rows_file}"
    render_rows render_remote_branch "${remote_branches}" "${dir}" "${default_ref}" "${width}" >> "${rows_file}"
    render_repo_header "${dir}" "${header_branch}" "${actions}"
    if [ "${verbose}" = true ]; then
        render_repo_details "${dir}" "${header_branch}" "${uncommitted}" "${stashes}"
    fi
    cat "${rows_file}"
}

scan_repo() {
    local dir="${1}"
    printf '%s' "${dir}" > "${status_file}"
    current_branch=$(git -C "${dir}" rev-parse --abbrev-ref HEAD)
    unpushed=$(unpushed_branches "${dir}")
    worktree_branches=$(linked_worktree_branches "${dir}")
    local local_branches origin_branches remote_only uncommitted stashes
    local_branches=$(local_branch_names "${dir}")
    origin_branches=$(origin_branch_names "${dir}")
    remote_only=$(remote_only_branches "${dir}" "${origin_branches}")
    uncommitted=$(count_uncommitted "${dir}")
    stashes=$(git -C "${dir}" stash list | count_lines)
    if [ -z "${local_branches}${remote_only}${unpushed}" ] && [ "${uncommitted}" -eq 0 ] && [ "${stashes}" -eq 0 ]; then
        return 0
    fi
    if is_listed "${current_branch}" "${local_branches}"; then
        uncommitted=0
    fi
    render_repo "${dir}" "${origin_branches}" "${local_branches}" "${remote_only}" "${uncommitted}" "${stashes}" > "${block_file}"
    local target="${info_file}"
    if [ "${needs_action}" = true ]; then
        target="${action_file}"
    fi
    cat "${block_file}" >> "${target}"
}

is_ignored() {
    local dir="${1}"
    local pattern
    for pattern in "${ignore_dirs[@]}"; do
        if [[ "${dir}" =~ (^|/)${pattern}$ ]]; then
            return 0
        fi
    done
    return 1
}

scan_repos() {
    find "${scan_dir}" -mindepth 0 -maxdepth 3 -type d -or -type l | while read -r dir; do
        if [ -d "${dir}/.git" ] && ! is_ignored "${dir}"; then
            scan_repo "${dir}"
        fi
    done
}

spin() {
    local spinners='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0
    while kill -0 "${SCAN_PID}" 2>/dev/null; do
        local current
        current=$(cat "${status_file}" 2>/dev/null || echo "")
        printf "\033[2K\r  ${YELLOW}%s${RESET}  %s" "${spinners:$((i % 10)):1}" "${current}" >&2
        sleep 0.1
        i=$((i + 1))
    done
    printf "\r%-100s\r" "" >&2
}

scan_repos &
SCAN_PID=$!
spin
wait "${SCAN_PID}"

cat "${action_file}"
if [ -s "${action_file}" ] && [ -s "${info_file}" ]; then
    echo
fi
cat "${info_file}"

print_warnings "No pull request links, falling back to branch links:" "${pull_request_warnings_file}"
print_warnings "No CI status:" "${ci_warnings_file}"

echo
success "Done."

#!/bin/bash

set -euo pipefail

source "${CUSTOM_BIN_DIR}/prettyprint"

show_usage() {
    cat <<EOF
Usage: $(basename "${0}") [-f|--fast] [dir]

List the git repos under dir (default: \$WDIR) with uncommitted, unpushed or
stashed changes, and every other branch with its CI state and how far it is
behind the default branch.

Options:
  -f, --fast    skip the CI lookups
  -h, --help    show this help
EOF
}

fast=false
scan_dir=""
while [ $# -gt 0 ]; do
    case "${1}" in
        -h|--help) show_usage; exit 0 ;;
        -f|--fast) fast=true ;;
        -*) printf 'unknown option: %s\n' "${1}" >&2; show_usage >&2; exit 2 ;;
        *) scan_dir="${1}" ;;
    esac
    shift
done
scan_dir="${scan_dir:-${WDIR}}"

ignore_dirs=("dev")
bot_branch_pattern='^(renovate|dependabot|greenkeeper|snyk|whitesource-remediate|pyup)[/-]'
pull_request_cache_dir="${HOME}/.cache/gck"
pull_request_cache_minutes=10
behind_column_width=5
no_pipeline_mark="💤"
mkdir -p "${pull_request_cache_dir}"

output_file=$(mktemp)
branches_file=$(mktemp)
remote_branches_file=$(mktemp)
status_file=$(mktemp)
links_file=$(mktemp)
pull_requests_file=$(mktemp)
pull_request_warnings_file=$(mktemp)
fetch_error_file=$(mktemp)
ci_states_file=$(mktemp)
ci_errors_file=$(mktemp)
ci_warnings_file=$(mktemp)
trap 'rm -f "${output_file}" "${branches_file}" "${remote_branches_file}" "${status_file}" "${links_file}" "${pull_requests_file}" "${pull_request_warnings_file}" "${fetch_error_file}" "${ci_states_file}" "${ci_errors_file}" "${ci_warnings_file}"' EXIT

separator() {
    printf "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
}

dim_separator() {
    printf "${YELLOW}╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌${RESET}\n"
}

remote_slug() {
    local dir="${1}"
    local remote
    remote=$(git -C "${dir}" remote get-url origin 2>/dev/null) || return 0
    remote="${remote%.git}"
    case "${remote}" in
        *://*) remote="${remote#*://}" ;;
        *:*) remote="${remote%%:*}/${remote#*:}" ;;
        *) return 0 ;;
    esac
    printf '%s' "${remote#*@}"
}

tree_url_prefix() {
    local slug="${1}"
    case "${slug%%/*}" in
        *gitlab*) printf 'https://%s/-/tree/' "${slug}" ;;
        *) printf 'https://%s/tree/' "${slug}" ;;
    esac
}

add_warning() {
    local file="${1}"
    local message="${2}"
    if grep -qxF "${message}" "${file}"; then
        return 0
    fi
    printf '%s\n' "${message}" >> "${file}"
}

print_warnings() {
    local heading="${1}"
    local file="${2}"
    if [ ! -s "${file}" ]; then
        return 0
    fi
    echo
    error "${heading}"
    local warning
    while IFS= read -r warning; do
        substep_error "${warning}"
    done < "${file}"
}

fetch_pull_requests() {
    local slug="${1}"
    local cache_file
    cache_file="${pull_request_cache_dir}/$(printf '%s' "${slug}" | tr '/.' '__')"
    if [ -n "$(find "${cache_file}" -mmin "-${pull_request_cache_minutes}" 2>/dev/null)" ]; then
        cat "${cache_file}"
        return 0
    fi
    local client
    local client_command
    case "${slug%%/*}" in
        github.com)
            client="gh"
            client_command=(gh pr list --repo "${slug#*/}" --state open --limit 100
                --json "headRefName,url" --jq '.[] | "\(.headRefName)\t\(.url)"')
            ;;
        *)
            client="glab"
            client_command=(glab mr list --repo "https://${slug}" --per-page 100 --output json
                --jq '.[] | "\(.source_branch)\t\(.web_url)"')
            ;;
    esac
    if ! command -v "${client}" > /dev/null; then
        add_warning "${pull_request_warnings_file}" "${slug}: ${client} is not installed"
        return 0
    fi
    local pairs=""
    local status=0
    pairs=$("${client_command[@]}" 2> "${fetch_error_file}") || status=$?
    if [ "${status}" -ne 0 ]; then
        local reason
        reason=$(head -1 "${fetch_error_file}")
        if [ -z "${reason}" ]; then
            reason="${client} exited with status ${status}"
        fi
        add_warning "${pull_request_warnings_file}" "${slug}: ${reason}"
        return 0
    fi
    printf '%s\n' "${pairs}" | tee "${cache_file}"
}

build_branch_links() {
    local dir="${1}"
    local slug
    slug=$(remote_slug "${dir}")
    [ -n "${slug}" ] || return 0
    local prefix
    prefix=$(tree_url_prefix "${slug}")
    fetch_pull_requests "${slug}" > "${pull_requests_file}"
    local branch url
    while IFS= read -r branch; do
        [ -n "${branch}" ] || continue
        url=$(awk -F'\t' -v b="${branch}" '$1 == b { print $2; exit }' "${pull_requests_file}")
        [ -n "${url}" ] || url="${prefix}${branch}"
        printf '%s\t%s\n' "${branch}" "${url}"
    done >> "${links_file}"
}

format_branch() {
    local branch="${1}"
    local emphasis="${2:-}"
    local color=""
    if [[ "${branch}" =~ ${bot_branch_pattern} ]]; then
        color="${TURQUOISE}"
    fi
    local label="${emphasis}${color}${branch}${RESET}"
    local url
    url=$(awk -F'\t' -v b="${branch}" '$1 == b { print $2; exit }' "${links_file}")
    if [ -n "${url}" ]; then
        hyperlink "${url}" "${label}"
    else
        printf '%s' "${label}"
    fi
}

default_branch_ref() {
    local dir="${1}"
    local ref
    if ref=$(git -C "${dir}" symbolic-ref -q --short refs/remotes/origin/HEAD); then
        printf '%s' "${ref}"
        return 0
    fi
    for ref in origin/main origin/master; do
        if git -C "${dir}" show-ref --verify --quiet "refs/remotes/${ref}"; then
            printf '%s' "${ref}"
            return 0
        fi
    done
}

remote_only_branches() {
    local dir="${1}"
    local origin_branches="${2}"
    local branch
    while IFS= read -r branch; do
        if [ -n "${branch}" ] && ! git -C "${dir}" show-ref --verify --quiet "refs/heads/${branch}"; then
            printf '%s\n' "${branch}"
        fi
    done <<< "${origin_branches}"
}

build_ci_states() {
    local dir="${1}"
    local branches="${2}"
    local slug
    slug=$(remote_slug "${dir}")
    [ -n "${slug}" ] || return 0
    printf '%s\n' "${branches}" | python3 "${CUSTOM_BIN_DIR}/branch_ci.py" "${slug}" \
        > "${ci_states_file}" 2> "${ci_errors_file}" || true
    local warning
    while IFS= read -r warning; do
        add_warning "${ci_warnings_file}" "${slug}: ${warning}"
    done < "${ci_errors_file}"
}

load_ci_state() {
    local branch="${1}"
    local category url color
    ci_state=""
    ci_mark=" "
    ci_mark_padding=" "
    ci_label=""
    IFS=$'\037' read -r ci_state category url < <(awk -F'\t' -v b="${branch}" \
        'BEGIN { OFS = "\037" } $1 == b { print $2, $3, $4; exit }' "${ci_states_file}") || return 0
    case "${ci_state}" in
        none) ci_mark="${no_pipeline_mark}"; ci_mark_padding=""; return 0 ;;
        success) color="${GREEN}"; ci_mark="✓" ;;
        failed) color="${RED}"; ci_mark="✗"; ci_label="${category}" ;;
        *) color="${YELLOW}"; ci_mark="●"; ci_label="${ci_state}" ;;
    esac
    ci_mark=$(hyperlink "${url}" "${color}${ci_mark}${RESET}")
    if [ -n "${ci_label}" ]; then
        ci_label=$(hyperlink "${url}" "${color}${ci_label}${RESET}")
    fi
}

count_behind() {
    local dir="${1}"
    local ref="${2}"
    local default_ref="${3}"
    if [ -z "${default_ref}" ]; then
        printf '0'
        return 0
    fi
    git -C "${dir}" rev-list --count "${ref}..${default_ref}" 2>/dev/null || printf '0'
}

pad() {
    local width="${1}"
    if [ "${width}" -gt 0 ]; then
        printf '%*s' "${width}" ''
    fi
}

format_behind() {
    local behind="${1}"
    if [ "${behind}" -eq 0 ]; then
        pad "${behind_column_width}"
        return 0
    fi
    printf '%s↓%s%s' "${YELLOW}" "${behind}" "${RESET}"
    pad $((behind_column_width - 1 - ${#behind}))
}

branch_emphasis() {
    if [ "${1}" = "${current_branch}" ]; then
        printf '%s' "${BOLD}"
    fi
}

render_branch_row() {
    local dir="${1}"
    local branch="${2}"
    local ref="${3}"
    local default_ref="${4}"
    local width="${5}"
    local behind
    behind=$(count_behind "${dir}" "${ref}" "${default_ref}")
    load_ci_state "${branch}"
    local row
    row="  ${ci_mark}${ci_mark_padding} $(format_branch "${branch}" "$(branch_emphasis "${branch}")")$(pad $((width - ${#branch} + 2)))"
    row="${row}$(format_behind "${behind}") ${ci_label}"
    printf '%s\n' "${row%"${row##*[![:space:]]}"}"
}

render_repo_header() {
    local dir="${1}"
    local default_branch="${2}"
    local header="${YELLOW}${dir}${RESET}"
    load_ci_state "${default_branch}"
    if [ -n "${ci_state}" ]; then
        header="${header}  ${default_branch} ${ci_mark}"
    fi
    if [ -n "${ci_label}" ]; then
        header="${header} ${ci_label}"
    fi
    printf '%s\n' "${header}"
}

render_repo() {
    local dir="${1}"
    local ref_prefix="${2}"
    local default_ref="${3}"
    local branches="${4}"
    local width=0
    local branch
    while IFS= read -r branch; do
        if [ "${#branch}" -gt "${width}" ]; then
            width=${#branch}
        fi
    done <<< "${branches}"
    render_repo_header "${dir}" "${default_ref#origin/}"
    while IFS= read -r branch; do
        render_branch_row "${dir}" "${branch}" "${ref_prefix}${branch}" "${default_ref}" "${width}"
    done <<< "${branches}"
}

scan_repos() {
    find "${scan_dir}" -mindepth 0 -maxdepth 3 -type d -or -type l | while read -r dir; do
        skip=false
        for pattern in "${ignore_dirs[@]}"; do
            if [[ "${dir}" =~ (^|/)${pattern}$ ]]; then
                skip=true
                break
            fi
        done
        [ "${skip}" = true ] && continue
        if [ -d "${dir}/.git" ]; then
            printf '%s' "${dir}" > "${status_file}"
            current_branch=$(git -C "${dir}" rev-parse --abbrev-ref HEAD)
            shown=false
            if [[ "$(git -C "${dir}" status -s)" != "" ]]; then
                { separator; printf "${BOLD}${WHITE}%s${RESET} [git uncommitted changes]\n" "${dir}"; git -c color.ui=always -C "${dir}" status -s; } >> "${output_file}"
                shown=true
            fi
            if [[ "$(git -C "${dir}" log --branches --not --remotes)" != "" ]]; then
                { separator; printf "${BOLD}${WHITE}%s${RESET} [git unpushed changes]\n" "${dir}"; git -c color.ui=always -C "${dir}" log --pretty=format:"%h - %an, %ar: %s" --branches --not --remotes; printf '\n'; } >> "${output_file}"
                shown=true
            fi
            if [ "$(git -C "${dir}" stash list)" != "" ]; then
                { separator; printf "${BOLD}${WHITE}%s${RESET} [git stashed changes]\n" "${dir}"; git -c color.ui=always -C "${dir}" stash list; } >> "${output_file}"
                shown=true
            fi
            other_branches=$(git -C "${dir}" for-each-ref --format='%(refname:short)' refs/heads/ | grep -Ev '^(main|master)$' || true)
            origin_branches=$(git -C "${dir}" for-each-ref --format='%(refname:short)' refs/remotes/origin/ \
                | grep -Ev '^origin$|origin/(HEAD|main|master)$' \
                | sed 's#^origin/##' || true)
            remote_only=$(remote_only_branches "${dir}" "${origin_branches}")
            default_ref=$(default_branch_ref "${dir}")
            : > "${links_file}"
            : > "${ci_states_file}"
            if [ -n "${other_branches}${origin_branches}" ]; then
                printf '%s\n' "${origin_branches}" | build_branch_links "${dir}"
                if [ "${fast}" = false ]; then
                    build_ci_states "${dir}" "$(printf '%s\n' "${default_ref#origin/}" "${other_branches}" "${remote_only}")"
                fi
            fi
            if [ -n "${other_branches}" ]; then
                render_repo "${dir}" refs/heads/ "${default_ref}" "${other_branches}" >> "${branches_file}"
            fi
            if [ -n "${remote_only}" ]; then
                render_repo "${dir}" refs/remotes/origin/ "${default_ref}" "${remote_only}" >> "${remote_branches_file}"
            fi
        fi
    done
}

spin() {
    local spinners='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0
    while kill -0 "${SCAN_PID}" 2>/dev/null; do
        local current
        current=$(cat "${status_file}" 2>/dev/null || echo "")
        printf "\033[2K\r  ${YELLOW}%s${RESET}  %s" "${spinners:$((i % 10)):1}" "${current}" >&2
        sleep 0.1
        i=$((i + 1))
    done
    printf "\r%-100s\r" "" >&2
}

scan_repos &
SCAN_PID=$!
spin
wait "${SCAN_PID}"

cat "${output_file}"
[ -s "${output_file}" ] && separator

if [ -s "${branches_file}" ]; then
    echo
    dim_separator
    printf "${YELLOW}  other branches${RESET}\n"
    dim_separator
    cat "${branches_file}"
    dim_separator
fi

if [ -s "${remote_branches_file}" ]; then
    echo
    dim_separator
    printf "${YELLOW}  other remote branches${RESET}\n"
    dim_separator
    cat "${remote_branches_file}"
    dim_separator
fi

print_warnings "No pull request links, falling back to branch links:" "${pull_request_warnings_file}"
print_warnings "No CI status:" "${ci_warnings_file}"

echo
success "Done."

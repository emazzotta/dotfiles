#!/bin/bash
set -uo pipefail

# shellcheck source=telegramlib.sh
source "$(dirname "${BASH_SOURCE[0]}")/telegramlib.sh"

telegram_usage_guard "<message> [user] [bot key]" "$@"
telegram_target "${2:-}" "${3:-}" || exit 1

echo "Sending message to ${TELEGRAM_CHAT}..."
http --body "${TELEGRAM_URL}/sendMessage" chat_id=="${TELEGRAM_CHAT}" text=="${1}"

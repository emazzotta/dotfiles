#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/shelllog.sh"

show_usage() {
    cat << EOF
Usage: $(basename "$0") [-o OUTPUT_DIR] [-h] [archive-file]

Extracts a password-protected 7z archive using \$PASSWORD_ZIPS.
When the stored password fails, retries other spellings of it (NFD, NFC,
legacy code pages, lossy ASCII) with 7zz, then Keka, then the 7z wrapper.

Options:
  -o OUTPUT_DIR  Extract to this directory (skips destination prompt)
  -h             Show this help

Archive resolution (when <archive-file> is omitted):
  1. One *.7z in cwd         -> extract that one
  2. Several                 -> pick via pickfile
  3. None                    -> error

Destination resolution (when -o is omitted):
  1. Archive is in \$DESKDIR  -> extract to \$DESKDIR
  2. Otherwise               -> prompt via gum (archive dir / cwd / \$DESKDIR)

Environment:
  DESKDIR          Desktop directory used as default destination
  PASSWORD_ZIPS    Archive password (loaded via envify)
  GLOBAL_ENV_FILE  Optional env file sourced before extraction

Examples:
  $(basename "$0")
  $(basename "$0") archive.7z
  $(basename "$0") -o /tmp/out archive.7z
  $(basename "$0") /path/to/archive.7z
EOF
}

readonly HEADER_PROBE_PASSWORD="pwuncompress-header-probe"
readonly KEKA_CLI="${KEKA_CLI:-/Applications/Keka.app/Contents/MacOS/Keka}"

find_backends() {
    BACKENDS=()
    if command -v 7zz >/dev/null 2>&1; then
        BACKENDS+=(7zz)
    fi
    if [ -x "$KEKA_CLI" ]; then
        BACKENDS+=(keka)
    fi
    if command -v 7z >/dev/null 2>&1; then
        BACKENDS+=(7z)
    fi
}

run_backend() {
    local backend="$1"
    shift
    if [ "$backend" = keka ]; then
        "$KEKA_CLI" --cli 7zz "$@"
    else
        "$backend" "$@"
    fi
}

load_password_spellings() {
    local label value count=0
    SPELLING_LABELS=()
    SPELLING_VALUES=()
    while IFS= read -r -d '' label && IFS= read -r -d '' value; do
        SPELLING_LABELS+=("$label")
        SPELLING_VALUES+=("$value")
        count=$((count + 1))
    done < <(printf '%s' "$PASSWORD_ZIPS" | python3 -I "$SCRIPT_DIR/pwvariants.py")
    if [ "$count" -eq 0 ]; then
        SPELLING_LABELS=("as stored")
        SPELLING_VALUES=("$PASSWORD_ZIPS")
    fi
}

headers_encrypted() {
    ! run_backend "$1" l -p"$HEADER_PROBE_PASSWORD" "$ARCHIVE" </dev/null >/dev/null 2>&1
}

find_spelling_for() {
    local backend="$1" check=t i=0
    if headers_encrypted "$backend"; then
        check=l
    fi
    while [ "$i" -lt "${#SPELLING_VALUES[@]}" ]; do
        if run_backend "$backend" "$check" -p"${SPELLING_VALUES[$i]}" "$ARCHIVE" </dev/null >/dev/null 2>&1; then
            echo "$i"
            return 0
        fi
        i=$((i + 1))
    done
    return 1
}

find_match() {
    local backend index
    for backend in "${BACKENDS[@]}"; do
        if index=$(find_spelling_for "$backend"); then
            MATCH_BACKEND="$backend"
            MATCH_INDEX="$index"
            return 0
        fi
    done
    return 1
}

OUTPUT_DIR=""
ARCHIVE=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            show_usage
            exit 0
            ;;
        -o)
            if [ -z "${2:-}" ]; then
                error "-o requires a directory argument"
                exit 1
            fi
            OUTPUT_DIR="$2"
            shift 2
            ;;
        *)
            if [ -n "$ARCHIVE" ]; then
                error "Unexpected extra argument: $1"
                exit 1
            fi
            ARCHIVE="$1"
            shift
            ;;
    esac
done

if [ -z "$ARCHIVE" ]; then
    ARCHIVE="$(pickfile --header "Select archive:" 7z)" || exit 1
fi

if [ ! -f "$ARCHIVE" ]; then
    error "Archive not found: $ARCHIVE"
    exit 1
fi

find_backends
if [ -z "${BACKENDS[*]:-}" ]; then
    error "No 7-Zip found. Install it with: brew install sevenzip"
    exit 1
fi

if [ -n "${GLOBAL_ENV_FILE:-}" ] && [ -f "$GLOBAL_ENV_FILE" ]; then
    info "Loading environment from $GLOBAL_ENV_FILE"
    source "$GLOBAL_ENV_FILE"
fi

if [ -z "${DESKDIR:-}" ]; then
    error "DESKDIR environment variable not set"
    exit 1
fi

ARCHIVE_DIR="$(cd "$(dirname "$ARCHIVE")" && pwd)"
DESKDIR_ABS="$(cd "$DESKDIR" && pwd)"

if [ -n "$OUTPUT_DIR" ]; then
    DEST="$OUTPUT_DIR"
elif [ "$ARCHIVE_DIR" = "$DESKDIR_ABS" ]; then
    DEST="$DESKDIR"
else
    CWD="$(pwd)"
    if ! command -v gum >/dev/null 2>&1; then
        error "gum not found; pass -o OUTPUT_DIR explicitly"
        exit 1
    fi
    options=("Archive directory ($ARCHIVE_DIR)")
    [ "$CWD" != "$ARCHIVE_DIR" ] && options+=("Current directory ($CWD)")
    [ "$DESKDIR_ABS" != "$ARCHIVE_DIR" ] && [ "$DESKDIR_ABS" != "$CWD" ] && options+=("Desktop ($DESKDIR)")
    choice=$(gum choose --header "Extract destination:" "${options[@]}")
    case "$choice" in
        "Archive directory"*) DEST="$ARCHIVE_DIR" ;;
        "Current directory"*) DEST="$CWD" ;;
        "Desktop"*) DEST="$DESKDIR" ;;
        *)
            error "No destination selected"
            exit 1
            ;;
    esac
fi

mkdir -p "$DEST"

source envify PASSWORD_ZIPS
if [ -z "${PASSWORD_ZIPS:-}" ]; then
    error "PASSWORD_ZIPS environment variable not set"
    exit 1
fi

log "Extracting archive: $ARCHIVE"
log "Destination: $DEST"

load_password_spellings
if ! find_match; then
    error "No spelling of PASSWORD_ZIPS opens $ARCHIVE (tried ${#SPELLING_VALUES[@]} spellings with: ${BACKENDS[*]})"
    exit 1
fi
if [ "$MATCH_INDEX" -gt 0 ]; then
    warn "Stored password failed; opened with its ${SPELLING_LABELS[$MATCH_INDEX]} spelling via $MATCH_BACKEND"
fi

if run_backend "$MATCH_BACKEND" x "$ARCHIVE" -o"$DEST" -p"${SPELLING_VALUES[$MATCH_INDEX]}"; then
    success "Archive extracted successfully"
else
    error "Extraction failed"
    exit 1
fi

#!/usr/bin/env python3
from __future__ import annotations

import argparse
import subprocess
import time
from pathlib import Path
import sys

import medialib
from medialib import OutputNaming
from scriptlog import Logger

logger = Logger()


DEFAULT_SUFFIX = "_boosted"
DEFAULT_VOLUME = 2.0


def boost_one(input_file: Path, volume: float, suffix: str, output_dir: Path | None, delete_original: bool, file_num: int, total_files: int) -> Path | None:
    output_file = medialib.resolve_output_path(
        input_file, output_dir,
        OutputNaming(extension=input_file.suffix, name_suffix=suffix, conflict_suffix=suffix))

    cmd = [
        "ffmpeg",
        "-i", str(input_file),
        "-af", f"volume={volume}",
        "-y", str(output_file),
    ]

    logger.log(f"\n[{file_num}/{total_files}] Boosting: {input_file.name} -> {output_file.name}")
    print()

    start_time = time.time()
    try:
        subprocess.run(cmd, check=True)
        elapsed = time.time() - start_time
        print()
        logger.success(f"Boosted in {medialib.format_time(elapsed)}: {input_file.name} -> {output_file.name}")
        if delete_original:
            input_file.unlink(missing_ok=True)
        return output_file
    except subprocess.CalledProcessError:
        print()
        logger.error(f"Failed: {input_file.name}")
        return None


def main():
    p = argparse.ArgumentParser(description="Boost volume of audio files")
    p.add_argument("-i", "--input", required=True, nargs="+", help="Audio files or directories")
    p.add_argument("-v", "--volume", type=float, default=DEFAULT_VOLUME, help="Volume multiplier (default: 2.0)")
    p.add_argument("-o", "--output-path", help="Output directory")
    p.add_argument("-d", "--delete", action="store_true", help="Delete original after processing")
    p.add_argument("-s", "--suffix", default=DEFAULT_SUFFIX, help="Suffix to append before extension (default: _boosted)")
    args = p.parse_args()

    sources = [Path(i).expanduser().resolve() for i in args.input]
    out_dir = Path(args.output_path).expanduser().resolve() if args.output_path else None
    if out_dir:
        out_dir.mkdir(parents=True, exist_ok=True)

    inputs = medialib.collect_inputs(sources, medialib.AUDIO_EXTS)
    if not inputs:
        logger.error("No audio files found")
        sys.exit(1)

    logger.log(f"Found {len(inputs)} audio file(s) to boost at {args.volume}x volume")

    results = []
    failed = 0
    batch_start_time = time.time()
    for idx, f in enumerate(inputs, 1):
        result = boost_one(f, args.volume, args.suffix, out_dir, args.delete, idx, len(inputs))
        if result:
            results.append(result)
        else:
            failed += 1

    batch_elapsed = time.time() - batch_start_time
    print()
    logger.log(f"Summary: {len(results)} succeeded, {failed} failed, {len(inputs)} total in {medialib.format_time(batch_elapsed)}")


if __name__ == "__main__":
    main()

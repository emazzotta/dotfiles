#!/usr/bin/env python3
from __future__ import annotations

import argparse
from functools import partial
from pathlib import Path

import medialib
from medialib import OutputNaming



DEFAULT_SUFFIX = "_boosted"
DEFAULT_VOLUME = 2.0


def plan_boost(input_file: Path, output_dir: Path | None, volume: float, suffix: str) -> medialib.FfmpegJob:
    output_file = medialib.resolve_output_path(
        input_file, output_dir,
        OutputNaming(extension=input_file.suffix, name_suffix=suffix, conflict_suffix=suffix))

    cmd = [
        "ffmpeg",
        "-i", str(input_file),
        "-af", f"volume={volume}",
        *medialib.LOSSY_AUDIO_QUALITY_ARGS.get(input_file.suffix.lstrip(".").lower(), []),
        "-y", str(output_file),
    ]
    return medialib.FfmpegJob(cmd, output_file)


def main():
    p = argparse.ArgumentParser(description="Boost volume of audio files")
    p.add_argument("-i", "--input", nargs="+", help="Audio files or directories (default: pick from the current directory)")
    p.add_argument("-v", "--volume", type=float, default=DEFAULT_VOLUME, help="Volume multiplier (default: 2.0)")
    p.add_argument("-o", "--output-path", help="Output directory")
    p.add_argument("-d", "--delete", action="store_true", help="Delete original after processing")
    p.add_argument("-s", "--suffix", default=DEFAULT_SUFFIX, help="Suffix to append before extension (default: _boosted)")
    args = p.parse_args()

    spec = medialib.BatchSpec(
        media=medialib.AUDIO, task=f"boost at {args.volume}x volume", doing="Boosting", done="Boosted",
        plan=partial(plan_boost, volume=args.volume, suffix=args.suffix))
    medialib.run_batch(spec, args.input, args.output_path, args.delete)


if __name__ == "__main__":
    main()

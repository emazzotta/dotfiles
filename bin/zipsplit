#!/bin/bash

if test "${1}"; then
    amount="${1}"
    if ! [[ "${amount}" =~ ^[1-9][0-9]*$ ]]; then
        echo "usage: $(basename "${0}") <amount of files>" >&2
        exit 1
    fi
    files=()
    while IFS= read -r name; do
        files+=("${name}")
    done < <(ls -rt)
    for ((i = 0; i < ${#files[@]}; i += amount)); do
        zip -r "${i}.zip" "${files[@]:i:amount}"
    done
else
    echo "usage: $(basename "${0}") <amount of files>"
fi

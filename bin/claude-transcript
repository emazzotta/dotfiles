#!/bin/bash
# claude-transcript - render a Claude Code session's JSONL to one self-contained
# HTML page and publish it to the file-server. Prints the public URL.
#
# Four views of a session:
#   chat     (default) the conversation as the web-terminal's chat shows it, rendered
#            by the web-terminal checkout's own code (bun scripts/share.ts)
#   text     (--text-only) the same without tool steps: prompts and replies only
#   message  (--message ID) one prompt or reply of it, in the same style
#   insight  (--insight) vibe-replay's interactive replay: playback, thinking,
#            diffs, token and cost charts
#
# Runs where ~/.claude/projects lives (the dev container, the devbox; the
# web-terminal's share button runs it on the devbox over SSH). Upload goes through
# `fileserver upload`: over the keyguard bridge to the Mac in the dev container,
# with the pod's ServiceAccount on the devbox.
#
# Re-publishing a session or message in the same view reuses the name it already
# has on the server (date included), so the URL you shared once keeps working and
# shows the new content.
#
# Usage:
#   claude-transcript [--title "<TITLE>"] <SESSION_ID>
#                                    render that session (id from the caller's
#                                    scratchpad path: .../-workspace/<id>/...)
#   claude-transcript [--title "<TITLE>"] --latest
#                                    render the most recently updated session
#   --title TITLE                    page title; without one, the session's own
#   --message ID                     render only that prompt or reply
#   --text-only                      leave out the tool steps and their output
#   --insight                        render the vibe-replay instead of the chat
#   --allow-secrets                  publish even when the render flags secrets
set -euo pipefail

readonly projects="${HOME}/.claude/projects"
# /share and /downloads both reach the same file-server (nginx rewrites /share/
# onto /downloads/), so old /downloads links stay valid; /share is the one to hand out.
readonly base_url="${FILESERVER_PUBLIC_BASE:-https://emanuelemazzotta.com/share}"
readonly stamp_pattern='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z'
# scripts/share.ts exits with this when it wrote nothing because of a possible secret.
readonly chat_secrets_status=3

work_dir=""
# chat, text, message or insight; set once from the flags, by pick_view.
view=chat

error() { echo "claude-transcript: $*" >&2; }

cleanup() {
    if [ -n "$work_dir" ]; then
        /bin/rm -rf "$work_dir"
    fi
    return 0
}

show_usage() {
    cat <<EOF
Usage: claude-transcript [--title "<TITLE>"] [--text-only | --message ID | --insight] <SESSION_ID | --latest>

Render a Claude Code session into one HTML page and publish it to the
file-server, printing the public URL. By default the page shows the
conversation as the web-terminal's chat does.

  SESSION_ID       UUID of the session (the id in your scratchpad path)
  --latest         use the most recently updated session JSONL
  --title TITLE    page title (browser tab + page header). Without it the
                   page takes the title Claude Code gave the session;
                   --insight needs one
  --text-only      leave out the tool steps and their output: only the
                   prompts and the replies, the ones between steps included
  --message ID     publish only that prompt or reply (its id in the chat),
                   as its own page
  --insight        render vibe-replay's interactive replay instead, with
                   thinking, diffs, and token and cost charts
  --allow-secrets  publish even when the render flags possible secrets

The chat view is built by the web-terminal checkout: \$WEB_TERMINAL_DIR, else
~/Projects/private/web-terminal, else /workspace/code/private/web-terminal.
Its dependencies are installed there first (bun install --frozen-lockfile).

Re-publishing a session overwrites the file it already has on the server in
that view, so its URL (timestamp included) stays valid.
EOF
}

find_session_jsonl() {
    find "$projects" -maxdepth 2 -name "${1}.jsonl" -not -path '*/subagents/*' 2>/dev/null | head -1
}

find_latest_jsonl() {
    find "$projects" -maxdepth 2 -name '*.jsonl' -not -path '*/subagents/*' -printf '%T@ %p\n' 2>/dev/null \
        | sort -rn | head -1 | cut -d' ' -f2-
}

# The file name prefix of a view. Insight keeps the prefix every transcript had
# before the chat view existed, so re-publishing one of those finds its URL.
view_prefix() {
    case "$1" in
        chat) printf 'claude-chat' ;;
        text) printf 'claude-text' ;;
        message) printf 'claude-message' ;;
        insight) printf 'claude-transcript' ;;
    esac
}

# An explicit WEB_TERMINAL_DIR is the only candidate, so a wrong one fails
# instead of quietly rendering from another checkout.
find_web_terminal() {
    local dir candidates=("${HOME}/Projects/private/web-terminal" /workspace/code/private/web-terminal)
    if [ -n "${WEB_TERMINAL_DIR:-}" ]; then
        candidates=("$WEB_TERMINAL_DIR")
    fi
    for dir in "${candidates[@]}"; do
        if [ -f "${dir}/scripts/share.ts" ]; then
            printf '%s' "$dir"
            return 0
        fi
    done
    return 1
}

# The published name of an earlier run for this session, if any. Reusing it keeps
# a shared URL alive; a miss (or an unreachable server) just mints a fresh name.
# KEY is the session id, or the message id for a message page; both hold only
# characters that need no escaping in the pattern.
find_published_name() {
    local prefix="$1" key="$2"
    fileserver list 2>/dev/null \
        | grep -oE "${prefix}-${stamp_pattern}-${key}\.html" \
        | head -1 || true
}

resolve_name() {
    local prefix="$1" key="$2" published
    published=$(find_published_name "$prefix" "$key")
    if [ -n "$published" ]; then
        error "re-publishing over ${published}"
        printf '%s' "$published"
    else
        printf '%s-%s-%s.html' "$prefix" "$(date -u +%Y-%m-%dT%H-%M-%SZ)" "$key"
    fi
}

refuse_secrets() {
    error "flagged possible secrets - not publishing. Check them, then re-run with --allow-secrets"
    return 1
}

# Runs a command with its output on stderr and saved to LOG, so that a failure
# can be summed up from LOG afterwards.
run_logged() {
    local log="$1" status=0
    shift
    "$@" >"$log" 2>&1 || status=$?
    cat "$log" >&2
    return "$status"
}

# Why a bun run failed, from its LOG. Bun reports an uncaught error as a source
# excerpt, an "error: ..." line and a stack, then its version; the share script
# reports its own failures as one plain line. The web-terminal's share sheet
# shows only the last line of stderr, which is where this reason goes.
failure_reason() {
    local log="$1" reason
    reason=$(grep -m1 '^error: ' "$log" || true)
    if [ -z "$reason" ]; then
        reason=$(grep -v -e '^Bun v[0-9]' -e '^[[:space:]]*$' "$log" | tail -1 || true)
    fi
    printf '%s' "${reason#error: }"
}

# The checkout is a working copy: a fresh clone has no node_modules and a pull
# can change the lockfile. With both current, the install is a no-op.
install_web_terminal_deps() {
    local web_terminal="$1" log="${work_dir}/install.log" reason
    if ! (cd "$web_terminal" && run_logged "$log" bun install --frozen-lockfile); then
        reason=$(failure_reason "$log")
        error "could not install the web-terminal's dependencies in ${web_terminal}${reason:+: ${reason}}"
        return 1
    fi
}

# The web-terminal builds the page from its own chat code, so a share looks like
# the chat at the checkout's commit. It prints each finding and writes nothing
# when it sees what looks like a credential. Further arguments are its options.
render_chat() {
    local jsonl="$1" out="$2" log="${work_dir}/share.log" web_terminal status=0 reason=""
    shift 2
    if ! web_terminal=$(find_web_terminal); then
        error "no web-terminal checkout with scripts/share.ts; set WEB_TERMINAL_DIR"
        return 1
    fi
    install_web_terminal_deps "$web_terminal" || return 1
    run_logged "$log" bun "${web_terminal}/scripts/share.ts" "$@" "$jsonl" "$out" || status=$?
    if [ "$status" -eq "$chat_secrets_status" ]; then
        refuse_secrets
    elif [ "$status" -ne 0 ] || [ ! -f "$out" ]; then
        if [ "$status" -ne 0 ]; then
            reason=$(failure_reason "$log")
        fi
        error "the web-terminal rendered nothing for ${jsonl##*/}${reason:+: ${reason}}"
        return 1
    fi
}

# vibe-replay writes the replay before it offers its interactive share menu and
# has no generate-and-stop flag; closing stdin drops it out of that menu with the
# file already written, so the path it printed - not its exit status - is what
# says whether the render worked.
render_replay() {
    local jsonl="$1" title="$2" out="$3" log="$4" generated
    vibe-replay --session "$jsonl" --title "$title" </dev/null >"$log" 2>&1 || true

    generated=$(grep -oE '/[^ ]+/index\.html' "$log" | head -1 || true)
    if [ -z "$generated" ] || [ ! -f "$generated" ]; then
        error "vibe-replay rendered nothing for ${jsonl}"
        cat "$log" >&2
        return 1
    fi
    /bin/cp "$generated" "$out"
}

# vibe-replay scans the replay for credentials but only stops on findings in the
# interactive mode this never reaches, so the refusal to publish lives here.
check_replay_secrets() {
    local log="$1" allow="$2"
    grep -q 'potential secret' "$log" || return 0
    if [ "$allow" = true ]; then
        error "publishing despite flagged secrets"
        return 0
    fi
    sed -n '/potential secret/,$p' "$log" | head -20 >&2
    refuse_secrets
}

# The view flags pick one view each; a second one is a mistake, not an override.
pick_view() {
    if [ "$view" != chat ]; then
        error "--text-only, --message and --insight do not mix"
        exit 2
    fi
    view="$1"
}

main() {
    local title="" selector="" allow_secrets=false item=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h | --help) show_usage; exit 0 ;;
            --title)
                title="${2:-}"
                [ -n "$title" ] || { error "--title needs a value"; exit 2; }
                shift 2
                ;;
            --message)
                item="${2:-}"
                [[ "$item" =~ ^[A-Za-z0-9:_-]+$ ]] || { error "--message needs a message id"; exit 2; }
                pick_view message
                shift 2
                ;;
            --text-only) pick_view text; shift ;;
            --insight) pick_view insight; shift ;;
            --allow-secrets) allow_secrets=true; shift ;;
            --latest) selector="$1"; shift ;;
            -*) error "unknown option: $1"; show_usage >&2; exit 2 ;;
            *) selector="$1"; shift ;;
        esac
    done
    [ -n "$selector" ] || { show_usage >&2; exit 2; }
    if [ -z "$title" ] && [ "$view" = insight ]; then
        error "--insight needs --title"
        show_usage >&2
        exit 2
    fi

    local renderer=bun cmd
    if [ "$view" = insight ]; then
        renderer=vibe-replay
    fi
    for cmd in "$renderer" fileserver; do
        command -v "$cmd" >/dev/null 2>&1 || { error "missing required command: ${cmd}"; exit 1; }
    done

    local jsonl id
    if [ "$selector" = "--latest" ]; then
        jsonl=$(find_latest_jsonl)
        [ -n "$jsonl" ] || { error "no session transcripts under ${projects}"; exit 1; }
        id=$(basename "$jsonl" .jsonl)
    else
        id="$selector"
        jsonl=$(find_session_jsonl "$id")
        [ -n "$jsonl" ] || { error "no transcript for session ${id} under ${projects}"; exit 1; }
    fi

    # Render and check before anything reaches the server or the shared staging dir.
    work_dir=$(mktemp -d)
    trap cleanup EXIT
    local page="${work_dir}/page.html"
    local key="$id" options=()
    if [ -n "$title" ]; then
        options+=(--title "$title")
    fi
    if [ "$allow_secrets" = true ]; then
        options+=(--allow-secrets)
    fi
    if [ "$view" = message ]; then
        key="${item//:/-}"
        options+=(--item "$item")
    elif [ "$view" = text ]; then
        options+=(--text-only)
    fi
    if [ "$view" = insight ]; then
        render_replay "$jsonl" "$title" "$page" "${work_dir}/render.log"
        check_replay_secrets "${work_dir}/render.log" "$allow_secrets"
    else
        render_chat "$jsonl" "$page" ${options[@]+"${options[@]}"}
    fi

    local name
    name=$(resolve_name "$(view_prefix "$view")" "$key")
    /bin/cp "$page" "${work_dir}/${name}"
    # In the dev container fileserver stages the file for the Mac itself; progress -> stderr.
    fileserver upload "${work_dir}/${name}" >&2

    printf '%s/%s\n' "$base_url" "$name"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

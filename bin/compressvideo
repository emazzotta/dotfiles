#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from collections import Counter
from dataclasses import dataclass
from enum import Enum, auto
from pathlib import Path
from typing import NoReturn

from scriptlog import Logger

logger = Logger()

VALID_PRESETS = ("ultrafast", "superfast", "veryfast", "faster", "fast",
                 "medium", "slow", "slower", "veryslow", "placebo")
VIDEO_EXTENSIONS = ("mp4", "m4v", "mov", "mkv", "avi", "webm", "mpg", "mpeg",
                    "wmv", "flv", "3gp", "mts", "m2ts")
SKIP_NAME_TOKEN = "compressed"
OUTPUT_SUFFIX = "_compressed.mp4"
DEFAULT_MAX_DEPTH = 5
DEFAULT_CRF = {"h264": 23, "h265": 28, "av1": 32}
HARDWARE_QUALITY = 55
DOWNSCALE_HINT_HEIGHT = 1080
SCALE_ALIASES = {"2160p": 2160, "4k": 2160, "uhd": 2160, "1440p": 1440, "2k": 1440,
                 "1080p": 1080, "fhd": 1080, "720p": 720, "hd": 720, "480p": 480, "360p": 360}
VIDEOTOOLBOX_ENCODERS = {"h264": "h264_videotoolbox", "h265": "hevc_videotoolbox"}
HDR_TRANSFERS = ("smpte2084", "arib-std-b67")
UNSET_METADATA = ("", "unknown", "N/A")
TONEMAP_FILTER = ("zscale=t=linear:npl=100,format=gbrpf32le,zscale=p=bt709,"
                  "tonemap=tonemap=hable:desat=0,zscale=t=bt709:m=bt709:r=tv,format=yuv420p")
PROBE_FIELDS = "pix_fmt,color_transfer,color_primaries,color_space,height,r_frame_rate"
EXIT_USAGE = 2
EXIT_INTERRUPTED = 130


class Outcome(Enum):
    COMPRESSED = auto()
    SKIPPED = auto()
    FAILED = auto()


@dataclass(frozen=True)
class SourceInfo:
    pix_fmt: str = ""
    transfer: str = ""
    primaries: str = ""
    space: str = ""
    height: int | None = None
    frame_rate: str = ""

    @classmethod
    def from_stream(cls, stream: dict) -> "SourceInfo":
        height = str(stream.get("height", ""))
        return cls(
            pix_fmt=str(stream.get("pix_fmt", "")),
            transfer=str(stream.get("color_transfer", "")),
            primaries=str(stream.get("color_primaries", "")),
            space=str(stream.get("color_space", "")),
            height=int(height) if height.isdigit() else None,
            frame_rate=str(stream.get("r_frame_rate", "")),
        )

    @property
    def is_hdr(self) -> bool:
        return self.transfer in HDR_TRANSFERS

    @property
    def is_10bit(self) -> bool:
        return self.pix_fmt.endswith(("10le", "10be")) or self.pix_fmt.startswith("p010")

    @property
    def frame_rate_fraction(self) -> tuple[int, int] | None:
        numerator, _, denominator = self.frame_rate.partition("/")
        if not (numerator.isdigit() and denominator.isdigit()):
            return None
        if int(numerator) == 0 or int(denominator) == 0:
            return None
        return int(numerator), int(denominator)


@dataclass(frozen=True)
class EncodeSettings:
    codec: str
    quality: int
    preset: str
    scale_height: int | None
    fps_target: str | None
    fps_half: bool
    tonemap: bool
    copy_audio: bool
    hardware_encoder: str | None
    av1_encoder: str | None


def fail(message: str) -> NoReturn:
    logger.error(message)
    sys.exit(EXIT_USAGE)


def fmt_size(num_bytes: int) -> str:
    size = float(num_bytes)
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024:
            return f"{size:.1f} {unit}"
        size /= 1024
    return f"{size:.1f} TB"


def size_delta(before: int, after: int) -> str:
    if before <= 0:
        return "0.0% smaller"
    if after > before:
        return f"{(after / before - 1) * 100:.1f}% bigger"
    return f"{(1 - after / before) * 100:.1f}% smaller"


def parse_scale(value: str) -> int:
    height = SCALE_ALIASES.get(value.lower())
    if height:
        return height
    if value.isdigit() and int(value) > 0:
        return int(value)
    raise argparse.ArgumentTypeError(
        f"invalid scale '{value}' (use 2160p/1440p/1080p/720p/480p or a height in px)")


def parse_fps(value: str) -> str:
    try:
        if float(value) > 0:
            return value
    except ValueError:
        pass
    raise argparse.ArgumentTypeError(
        f"invalid fps '{value}' (use a positive number like 24, 25, 30)")


def parse_max_depth(value: str) -> int:
    if value.isdigit() and int(value) > 0:
        return int(value)
    raise argparse.ArgumentTypeError(f"invalid max depth '{value}' (use a positive integer)")


def is_compressible_video(path: Path) -> bool:
    return (path.suffix.lower().lstrip(".") in VIDEO_EXTENSIONS
            and SKIP_NAME_TOKEN not in path.name.lower())


def find_video_files(directory: Path, max_depth: int = DEFAULT_MAX_DEPTH) -> list[Path]:
    matches: list[Path] = []
    for current, subdirectories, filenames in os.walk(directory):
        if len(Path(current).relative_to(directory).parts) >= max_depth - 1:
            subdirectories.clear()
        matches.extend(path for path in (Path(current) / name for name in filenames)
                       if is_compressible_video(path))
    return sorted(matches)


def output_file_for(input_file: Path) -> Path:
    return input_file.with_name(input_file.stem + OUTPUT_SUFFIX)


def available_encoders() -> set[str]:
    result = subprocess.run(["ffmpeg", "-hide_banner", "-encoders"],
                            capture_output=True, text=True)
    return {parts[1] for parts in (line.split() for line in result.stdout.splitlines())
            if len(parts) > 1}


def supports_zscale() -> bool:
    result = subprocess.run(["ffmpeg", "-hide_banner", "-filters"],
                            capture_output=True, text=True)
    return "zscale" in result.stdout


def select_av1_encoder(encoders: set[str]) -> str:
    if "libsvtav1" in encoders:
        return "libsvtav1"
    logger.warn("libsvtav1 not found; falling back to the much slower libaom-av1")
    return "libaom-av1"


def resolve_hardware_encoder(codec: str, preference: str, encoders: set[str]) -> str | None:
    if preference == "off":
        return None
    if codec == "av1":
        if preference == "on":
            fail("hardware av1 encode is unavailable via videotoolbox; drop --hw or pick h264/h265")
        return None
    encoder = VIDEOTOOLBOX_ENCODERS[codec]
    if encoder in encoders:
        return encoder
    if preference == "on":
        fail(f"hardware encode requested but '{encoder}' is unavailable in this ffmpeg build (drop --hw)")
    return None


def probe_source(input_file: Path) -> SourceInfo:
    result = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "v:0",
         "-show_entries", f"stream={PROBE_FIELDS}", "-of", "json", str(input_file)],
        capture_output=True, text=True,
    )
    try:
        streams = json.loads(result.stdout).get("streams", [])
    except json.JSONDecodeError:
        streams = []
    return SourceInfo.from_stream(streams[0]) if streams else SourceInfo()


def resolve_fps(settings: EncodeSettings, source: SourceInfo) -> str | None:
    if not settings.fps_half:
        return settings.fps_target
    fraction = source.frame_rate_fraction
    if fraction is None:
        raise ValueError("--fps-half needs a detectable source frame rate; "
                         f"ffprobe reported '{source.frame_rate or '?'}'")
    numerator, denominator = fraction
    return f"{numerator}/{denominator * 2}"


def build_video_filter(settings: EncodeSettings, source: SourceInfo) -> str | None:
    filters = []
    if settings.tonemap:
        filters.append(TONEMAP_FILTER)
    fps = resolve_fps(settings, source)
    if fps:
        filters.append(f"fps={fps}")
    if settings.scale_height:
        filters.append(rf"scale=-2:min(ih\,{settings.scale_height})")
    return ",".join(filters) if filters else None


def build_encoder_args(settings: EncodeSettings) -> list[str]:
    quality = str(settings.quality)
    if settings.hardware_encoder:
        args = ["-c:v", settings.hardware_encoder, "-q:v", quality]
        return args + ["-tag:v", "hvc1"] if settings.codec == "h265" else args
    if settings.codec == "h264":
        return ["-c:v", "libx264", "-preset", settings.preset, "-crf", quality]
    if settings.codec == "h265":
        return ["-c:v", "libx265", "-preset", settings.preset, "-crf", quality, "-tag:v", "hvc1"]
    if settings.av1_encoder == "libsvtav1":
        return ["-c:v", "libsvtav1", "-crf", quality, "-preset", "6"]
    return ["-c:v", "libaom-av1", "-crf", quality, "-b:v", "0", "-cpu-used", "4", "-row-mt", "1"]


def build_color_args(settings: EncodeSettings, source: SourceInfo) -> list[str]:
    if settings.tonemap:
        return ["-color_primaries", "bt709", "-color_trc", "bt709", "-colorspace", "bt709"]
    if settings.hardware_encoder:
        return []
    if settings.codec == "h264":
        return ["-pix_fmt", "yuv420p"]
    if not (source.is_10bit or source.is_hdr):
        return []
    args = ["-pix_fmt", "yuv420p10le"]
    for flag, value in (("-color_primaries", source.primaries),
                        ("-color_trc", source.transfer),
                        ("-colorspace", source.space)):
        if value not in UNSET_METADATA:
            args += [flag, value]
    return args


def build_command(settings: EncodeSettings, source: SourceInfo,
                  input_file: Path, output_file: Path) -> list[str]:
    command = ["ffmpeg", "-hide_banner", "-y", "-i", str(input_file)]
    video_filter = build_video_filter(settings, source)
    if video_filter:
        command += ["-vf", video_filter]
    command += build_encoder_args(settings)
    command += build_color_args(settings, source)
    command += ["-c:a", "copy"] if settings.copy_audio else ["-c:a", "aac", "-b:a", "128k"]
    return command + ["-movflags", "+faststart", str(output_file)]


def warn_hdr(settings: EncodeSettings, source: SourceInfo) -> None:
    if not source.is_hdr or settings.tonemap:
        return
    if settings.codec == "h264":
        logger.warn("source is HDR but h264 carries HDR poorly; colours may wash out. "
                    "Consider --tonemap or -c h265.")
    elif settings.hardware_encoder:
        logger.warn("hardware encode may not preserve HDR metadata cleanly; "
                    "consider software or --tonemap.")


def hint_downscale(settings: EncodeSettings, source: SourceInfo) -> None:
    if not source.height or source.height <= DOWNSCALE_HINT_HEIGHT:
        return
    if settings.scale_height and settings.scale_height <= DOWNSCALE_HINT_HEIGHT:
        return
    logger.info(f"source is {source.height}p; add --scale {DOWNSCALE_HINT_HEIGHT}p "
                "to shrink the file and encode faster")


def remove_partial(output_file: Path) -> None:
    if output_file.exists():
        output_file.unlink()
        logger.warn(f"removed incomplete output '{output_file}'")


def report_result(input_file: Path, output_file: Path, rm_original: bool) -> None:
    before = input_file.stat().st_size
    after = output_file.stat().st_size
    logger.success(f"done: {fmt_size(before)} -> {fmt_size(after)} ({size_delta(before, after)})")
    if rm_original:
        input_file.unlink()
        logger.log(f"removed original '{input_file}'")


def run_ffmpeg(command: list[str], input_file: Path, output_file: Path, rm_original: bool) -> Outcome:
    logger.log(f"compressing '{input_file}' -> '{output_file}'")
    try:
        returncode = subprocess.run(command).returncode
    except KeyboardInterrupt:
        remove_partial(output_file)
        raise
    if returncode != 0:
        remove_partial(output_file)
        logger.error(f"ffmpeg failed (exit {returncode}) for '{input_file}'")
        return Outcome.FAILED
    report_result(input_file, output_file, rm_original)
    return Outcome.COMPRESSED


def log_encode_plan(settings: EncodeSettings, source: SourceInfo, fps: str | None) -> None:
    logger.log(f"codec={settings.codec} quality={settings.quality} preset={settings.preset} "
               f"scale={settings.scale_height or 'none'} fps={fps or 'source'} "
               f"hw={'yes' if settings.hardware_encoder else 'no'} "
               f"tonemap={'yes' if settings.tonemap else 'no'} "
               f"hdr={'yes' if source.is_hdr else 'no'}")


def compress_file(input_file: Path, settings: EncodeSettings,
                  dry_run: bool, rm_original: bool) -> Outcome:
    output_file = output_file_for(input_file)
    if output_file.exists():
        logger.warn(f"skipping '{input_file}': '{output_file}' already exists")
        return Outcome.SKIPPED

    source = probe_source(input_file)
    try:
        fps = resolve_fps(settings, source)
        command = build_command(settings, source, input_file, output_file)
    except ValueError as error:
        logger.error(f"{error} for '{input_file}'")
        return Outcome.FAILED

    warn_hdr(settings, source)
    hint_downscale(settings, source)

    if dry_run:
        logger.info("dry run - would execute:")
        print(" ".join(command))
        return Outcome.COMPRESSED

    log_encode_plan(settings, source, fps)
    return run_ffmpeg(command, input_file, output_file, rm_original)


def create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="compressvideo",
        usage="compressvideo [options] <video_file>\n"
              "       compressvideo -r [options] [directory]",
        description="Compress (and optionally rescale) a video with ffmpeg. Default: h265; "
                    "hardware encode (videotoolbox) when available, else software preset medium.",
    )
    parser.add_argument("path", nargs="?",
                        help="Video file, or the directory to search when -r is given.")
    parser.add_argument("-c", "--codec", choices=("h264", "h265", "av1"), default="h265",
                        help="Video codec (default: h265).")
    parser.add_argument("-q", "--quality", type=int, metavar="N",
                        help="CRF for software encode, lower = better and bigger "
                             "(defaults: h264 23, h265 28, av1 32). With hardware encode this is "
                             "the videotoolbox q:v, higher = better (default 55).")
    parser.add_argument("-p", "--preset", choices=VALID_PRESETS, default="medium", metavar="NAME",
                        help="x264/x265 preset ultrafast..placebo (default: medium). "
                             "Ignored for av1 and hardware encode.")
    parser.add_argument("-s", "--scale", type=parse_scale, dest="scale_height", metavar="HEIGHT",
                        help="Downscale to a max height: 2160p, 1440p, 1080p, 720p, 480p, 360p "
                             "or a height in px (never upscales).")

    add_frame_rate_options(parser)
    add_encoder_options(parser)
    add_batch_options(parser)
    return parser


def add_frame_rate_options(parser: argparse.ArgumentParser) -> None:
    frame_rate = parser.add_mutually_exclusive_group()
    frame_rate.add_argument("--fps", type=parse_fps, dest="fps_target", metavar="N",
                            help="Re-time to N fps by dropping or duplicating frames "
                                 "(e.g. 24, 25, 30).")
    frame_rate.add_argument("--fps-half", action="store_true",
                            help="Halve the frame rate: exact 2:1 frame drop, no blending "
                                 "(60 to 30, 30 to 15).")


def add_encoder_options(parser: argparse.ArgumentParser) -> None:
    encoder = parser.add_mutually_exclusive_group()
    encoder.add_argument("--hw", dest="hardware", action="store_const", const="on",
                         help="Force hardware encode (videotoolbox); fails if unavailable. "
                              "Auto-selected when available.")
    encoder.add_argument("--sw", dest="hardware", action="store_const", const="off",
                         help="Force software encode, disabling the automatic hardware path.")
    encoder.add_argument("--no-hw", dest="hardware", action="store_const", const="off",
                         help=argparse.SUPPRESS)
    parser.set_defaults(hardware="auto")

    parser.add_argument("--tonemap", action="store_true",
                        help="Tonemap HDR (HLG/PQ) footage to SDR Rec.709.")
    parser.add_argument("--copy-audio", action="store_true",
                        help="Copy the audio stream instead of re-encoding to AAC 128k.")
    parser.add_argument("--just-preview-compatible", action="store_true",
                        help="Force h264 8-bit for macOS Quicktime/Preview compatibility.")


def add_batch_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--rm-original", action="store_true",
                        help="Delete the source file after a successful compress.")
    parser.add_argument("-r", "--recursive", action="store_true",
                        help="Compress every video below the given directory "
                             f"({', '.join(VIDEO_EXTENSIONS)}), defaulting to the current one. "
                             f"Names containing '{SKIP_NAME_TOKEN}' are skipped.")
    parser.add_argument("--max-depth", type=parse_max_depth, default=DEFAULT_MAX_DEPTH, metavar="N",
                        help=f"Search depth for -r (default: {DEFAULT_MAX_DEPTH}).")
    parser.add_argument("--dry-run", action="store_true",
                        help="Print the ffmpeg command without running it.")


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = create_parser()
    args = parser.parse_args(argv)
    if not args.recursive and args.path is None:
        parser.error("a video file is required (pass -r to compress a directory)")
    if args.just_preview_compatible:
        args.codec = "h264"
        args.hardware = "off"
        args.tonemap = False
    return args


def build_settings(args: argparse.Namespace, encoders: set[str]) -> EncodeSettings:
    hardware_encoder = resolve_hardware_encoder(args.codec, args.hardware, encoders)
    if hardware_encoder:
        logger.info(f"hardware encoding via {hardware_encoder} (pass --sw to force software)")
    return EncodeSettings(
        codec=args.codec,
        quality=args.quality if args.quality is not None
        else (HARDWARE_QUALITY if hardware_encoder else DEFAULT_CRF[args.codec]),
        preset=args.preset,
        scale_height=args.scale_height,
        fps_target=args.fps_target,
        fps_half=args.fps_half,
        tonemap=args.tonemap,
        copy_audio=args.copy_audio,
        hardware_encoder=hardware_encoder,
        av1_encoder=select_av1_encoder(encoders) if args.codec == "av1" and not hardware_encoder
        else None,
    )


def resolve_targets(args: argparse.Namespace) -> list[Path]:
    if args.recursive:
        directory = Path(args.path) if args.path else Path(".")
        if not directory.is_dir():
            fail(f"not a directory: '{directory}'")
        targets = find_video_files(directory, args.max_depth)
        if not targets:
            logger.warn(f"no videos found below '{directory}' within depth {args.max_depth}")
        else:
            logger.log(f"found {len(targets)} video file(s) below '{directory}'")
        return targets

    input_file = Path(args.path)
    if input_file.is_dir():
        fail(f"'{input_file}' is a directory; pass -r to compress the videos below it")
    if not input_file.is_file():
        fail(f"input file not found: '{input_file}'")
    output_file = output_file_for(input_file)
    if output_file.exists():
        fail(f"output already exists: '{output_file}'")
    return [input_file]


def require_commands(*commands: str) -> None:
    missing = [command for command in commands if shutil.which(command) is None]
    if missing:
        fail(f"missing required command(s): {' '.join(missing)}")


def print_summary(stats: Counter[Outcome], total: int) -> None:
    logger.log(f"compressed {stats[Outcome.COMPRESSED]}, skipped {stats[Outcome.SKIPPED]}, "
               f"failed {stats[Outcome.FAILED]} of {total} file(s)")


def compress_all(targets: list[Path], settings: EncodeSettings,
                 args: argparse.Namespace, stats: Counter[Outcome]) -> None:
    for index, input_file in enumerate(targets, start=1):
        if args.recursive:
            logger.log(f"[{index}/{len(targets)}] {input_file}")
        stats[compress_file(input_file, settings, args.dry_run, args.rm_original)] += 1


def main() -> None:
    # Keep our progress lines interleaved with ffmpeg's own output when piped.
    sys.stdout.reconfigure(line_buffering=True)
    args = parse_args()
    require_commands("ffmpeg", "ffprobe")
    settings = build_settings(args, available_encoders())
    if settings.tonemap and not supports_zscale():
        fail("--tonemap needs an ffmpeg built with zscale (libzimg); this build lacks it")

    targets = resolve_targets(args)
    stats: Counter[Outcome] = Counter()
    try:
        compress_all(targets, settings, args, stats)
    except KeyboardInterrupt:
        print()
        logger.warn("interrupted")
        print_summary(stats, len(targets))
        sys.exit(EXIT_INTERRUPTED)

    if args.recursive and targets:
        print_summary(stats, len(targets))
    sys.exit(1 if stats[Outcome.FAILED] else 0)


if __name__ == "__main__":
    main()

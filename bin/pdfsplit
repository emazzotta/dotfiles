#!/bin/bash

if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
  echo "Usage: $(basename "$0") [file.pdf]"
  exit 0
fi

pdf="${1:-$(pickfile pdf)}"
[ -n "$pdf" ] || exit 1

if [ ! -f "$pdf" ]; then
  echo "Error: File '$pdf' not found."
  exit 1
fi

pages=$(pdfinfo "$pdf" | grep 'Pages' | awk '{print $2}')

if ! [[ $pages =~ ^[0-9]+$ ]]; then
  echo "Error: Failed to determine the number of pages in '$pdf'."
  exit 1
fi

counter=1
while [ $counter -le $pages ]; do
  name="$(echo "$pdf" | sed 's/.pdf$//')_${counter}.pdf"
  echo "Creating page [${counter}] with name [${name}]"
  gs -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -sOutputFile="${name}" -dFirstPage=${counter} -dLastPage=${counter} "$pdf" >/dev/null 2>&1
  counter=$((counter + 1))
done

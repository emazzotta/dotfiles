#!/bin/bash
if test "${ZSH_VERSION}"; then
    autoload bashcompinit
    bashcompinit
    autoload -U add-zsh-hook
    compdef _git gco=git-checkout
    compdef sshrc=ssh
    compdef o=open 2>/dev/null
    compdef y=yarn 2>/dev/null
    _confirm_command() { _arguments '1:prompt: ' '*:::command:_normal'; }
    compdef _confirm_command confirm
    # Drop the cached dcp container pick on every new prompt (after Enter or
    # Ctrl-C), so each dcp invocation forces a fresh pick if ambiguous.
    _dcp_clear_picked() { rm -f "/tmp/.dcp_picked_$$"; }
    add-zsh-hook precmd _dcp_clear_picked
fi
# zsh's bashcompinit runs completion functions under `emulate -L sh` with a
# restricted PATH, so plain command names ("docker", "picker") fail to resolve
# inside _dcp. Snapshot the real PATH and the absolute docker binary at source
# time and reuse them from the completion functions.
_DCP_PATH="$PATH"
if command -v docker >/dev/null 2>&1; then
    _DCP_DOCKER=$(command -v docker)
elif [ -x /usr/local/bin/docker ]; then
    _DCP_DOCKER=/usr/local/bin/docker
elif [ -x /opt/homebrew/bin/docker ]; then
    _DCP_DOCKER=/opt/homebrew/bin/docker
else
    _DCP_DOCKER=docker
fi
export _DCP_PATH _DCP_DOCKER
_agrep()
{
  local _rcd
  _rcd="${HOME}/.bashrc.d"
  [ -d "${_rcd}" ] || _rcd="${HOME}/dotfiles/bash/.bashrc.d"
  _agrep_commands=$(ls ${CUSTOM_BIN_DIR})
  if [ -d "${_rcd}" ]; then
    _agrep_commands+=$(grep -hEo '^(alias ).*' "${_rcd}"/[0-9]*.sh 2>/dev/null | sed 's/=.*$//g' | sed 's/alias //g')
    _agrep_commands+=$(grep -hEo '^(export ).*' "${_rcd}"/[0-9]*.sh 2>/dev/null | sed 's/=.*$//g' | sed 's/export //g')
  fi
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  COMPREPLY=($(compgen -W "${_agrep_commands}" -- ${cur}))
}
_kubeconf()
{
  _kubeconf_options=$(ls ${KUBE_DIR} | grep kubeconfig.yaml | sed 's/-kubeconfig.yaml//g')
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  COMPREPLY=($(compgen -W "${_kubeconf_options}" -- ${cur}))
}
_bundleid()
{
  while IFS= read -r line; do
    COMPREPLY+=("$line")
  done < <(find /Applications -mindepth 1 -maxdepth 1 -type d -print | sed 's/\/Applications\///g' | sed 's/ /\\ /g')
}
_ef()
{
  _ef_commands=$(ls ${CUSTOM_BIN_DIR})
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  COMPREPLY=($(compgen -W "${_ef_commands}" -- ${cur}))
}
_repo() {
  _repo_commands=""
  for dir in $(find "${WDIR}" -mindepth 2 -maxdepth 2 -type d); do
    _repo_commands+="$(basename ${dir}) "
  done
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  COMPREPLY=($(compgen -W "${_repo_commands}" -- ${cur}))
}
_cl()
{
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  if [[ -z "${_CL_OPTS_CACHE}" ]]; then
    _CL_OPTS_CACHE=$(cl --help 2>/dev/null | grep -oE -- '(^|[[:space:],])-{1,2}[a-zA-Z][a-zA-Z0-9-]*' | tr -d ' ,' | sort -u | tr '\n' ' ')
  fi
  case "${prev}" in
    -f|--file|-p|--path) return 0 ;;
  esac
  if [[ "${cur}" == -* ]]; then
    COMPREPLY=($(compgen -W "${_CL_OPTS_CACHE}" -- "${cur}"))
  fi
}
_ags()
{
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  if [[ -z "${_AGS_OPTS_CACHE}" ]]; then
    _AGS_OPTS_CACHE=$(ags --help 2>/dev/null | grep -oE -- '(^|[[:space:],])-{1,2}[a-zA-Z][a-zA-Z0-9-]*' | tr -d ' ,' | sort -u | tr '\n' ' ')
  fi
  case "${prev}" in
    -p|--path|-r|--file-regex|-x|--exclude|--exclude-content) return 0 ;;
  esac
  if [[ "${cur}" == -* ]]; then
    COMPREPLY=($(compgen -W "${_AGS_OPTS_CACHE}" -- "${cur}"))
    return 0
  fi
}
_fileserver_remote_files()
{
  # Non-interactive exec, bounded so an unreachable cluster can't hang the shell.
  kubectl --request-timeout=5s -n personal-homepage \
    exec deployment/personal-homepage-file-server \
    -- /bin/sh -c 'cd /usr/share/caddy && ls -1' 2>/dev/null
}
_fileserver_canonical()
{
  awk -v word="$1" '{for (i = 1; i <= NF; i++) if ($i == word) { print $1; exit }}' \
    <<< "${_FILESERVER_SUBCOMMANDS}"
}
_fileserver()
{
  local cur invoked canonical
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"

  # One line per subcommand: canonical name first, then its aliases.
  if [[ -z "${_FILESERVER_SUBCOMMANDS}" ]]; then
    _FILESERVER_SUBCOMMANDS=$(fileserver --complete subcommands 2>/dev/null)
  fi

  # The shell aliases are named f<subcommand>, so dropping the leading f yields
  # the subcommand they bind. Anything else completes as bare `fileserver`.
  invoked="${COMP_WORDS[0]##*/}"
  canonical=$(_fileserver_canonical "${invoked#f}")
  if [[ -z "${canonical}" ]]; then
    if [[ ${COMP_CWORD} -eq 1 ]]; then
      COMPREPLY=($(compgen -W "${_FILESERVER_SUBCOMMANDS} -h --help" -- "${cur}"))
      return 0
    fi
    canonical=$(_fileserver_canonical "${COMP_WORDS[1]}")
  fi

  # upload takes local files, which -o default leaves to the shell.
  case "${canonical}" in
    remove|download) _reply_matching < <(_fileserver_remote_files) ;;
  esac
}
_make_targets()
{
  local cur makefile
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  for makefile in Makefile makefile GNUmakefile; do
    if [[ -f "${makefile}" ]]; then
      local targets
      targets=$(grep -E '^[a-zA-Z0-9_.-]+:' "${makefile}" | grep -v '^\.PHONY' | sed 's/:.*//' | sort -u)
      COMPREPLY=($(compgen -W "${targets}" -- "${cur}"))
      return 0
    fi
  done
}
_envify()
{
  local cur prev _py
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  _py="${DOTFILESPATH:-$HOME/dotfiles}/bin/envify.py"

  if [[ -z "${_ENVIFY_OPTS_CACHE}" ]]; then
    _ENVIFY_OPTS_CACHE=$(python3 "$_py" --help 2>/dev/null \
      | grep -oE -- '(^|[[:space:],])-{1,2}[a-zA-Z][a-zA-Z0-9-]*' \
      | tr -d ' ,' | sort -u | tr '\n' ' ')
  fi

  if [[ "$cur" == -* ]]; then
    COMPREPLY=($(compgen -W "${_ENVIFY_OPTS_CACHE}" -- "$cur"))
    return 0
  fi

  local _ttl="${ENVIFY_COMPLETION_TTL:-3600}"
  local _now _mtime
  _now=$(date +%s)
  mkdir -p "${HOME}/.cache"

  if [[ "$prev" == "--bridge" ]]; then
    local _bcache="${HOME}/.cache/envify-bridge-endpoints"
    _mtime=$(date -r "$_bcache" +%s 2>/dev/null || echo 0)
    if (( _now - _mtime >= _ttl )); then
      python3 "$_py" --bridge-list 2>/dev/null \
        | python3 -c "import sys,json; print('\n'.join(e['name'] for e in json.load(sys.stdin)))" \
        > "$_bcache" 2>/dev/null || true
    fi
    [[ -f "$_bcache" ]] && COMPREPLY=($(compgen -W "$(cat "$_bcache")" -- "$cur"))
    return 0
  fi

  local _cache="${HOME}/.cache/envify-keys"
  _mtime=$(date -r "$_cache" +%s 2>/dev/null || echo 0)
  if (( _now - _mtime >= _ttl )); then
    python3 "$_py" --list > "$_cache" 2>/dev/null || true
  fi

  [[ -f "$_cache" ]] && COMPREPLY=($(compgen -W "$(cat "$_cache")" -- "$cur"))
}
# Names live in this shell process and nowhere else. The store salts its
# filenames precisely so a copy of it reveals no variable names; a plaintext
# cache under ~/.cache would have handed them over for a plain file read.
# Cost of that choice: one fingerprint per shell, on the first TAB.
_keyguard_complete_existing_keys()
{
  if [[ -z "${_KEYGUARD_KEYS}" ]]; then
    _KEYGUARD_KEYS=$(keyguard list 2>/dev/null | tr '\n' ' ')
    [[ -z "${_KEYGUARD_KEYS}" ]] && return 0
  fi
  COMPREPLY=($(compgen -W "${_KEYGUARD_KEYS}" -- "$cur"))
}

_keyguard()
{
  local cur prev cmd
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  cmd="${COMP_WORDS[1]}"

  # keyguard owns both lists; --complete reads neither the store nor the
  # Keychain, so TAB never prompts for a fingerprint.
  if [[ -z "${_KEYGUARD_COMMANDS}" ]]; then
    _KEYGUARD_COMMANDS=$(keyguard --complete commands 2>/dev/null | tr '\n' ' ')
  fi

  if [[ ${COMP_CWORD} -eq 1 ]]; then
    COMPREPLY=($(compgen -W "${_KEYGUARD_COMMANDS}" -- "${cur}"))
    return 0
  fi

  case "${prev}" in
    --cache-duration)
      return 0
      ;;
    --bridge-endpoint)
      local _bcache="${HOME}/.cache/envify-bridge-endpoints"
      [[ -f "$_bcache" ]] && COMPREPLY=($(compgen -W "$(cat "$_bcache")" -- "${cur}"))
      return 0
      ;;
  esac

  if [[ "${cur}" == -* ]]; then
    if [[ "${_KEYGUARD_FLAGS_FOR}" != "${cmd}" ]]; then
      _KEYGUARD_FLAGS_FOR="${cmd}"
      _KEYGUARD_FLAGS=$(keyguard --complete flags "${cmd}" 2>/dev/null | tr '\n' ' ')
    fi
    COMPREPLY=($(compgen -W "${_KEYGUARD_FLAGS}" -- "${cur}"))
    return 0
  fi

  case "${cmd}" in
    get)
      _keyguard_complete_existing_keys
      ;;
    set|delete|rm)
      # One key, then a value or nothing - never complete a key where a secret goes.
      [[ ${COMP_CWORD} -eq 2 ]] && _keyguard_complete_existing_keys
      ;;
    mv|rename)
      [[ ${COMP_CWORD} -eq 2 || ${COMP_CWORD} -eq 3 ]] && _keyguard_complete_existing_keys
      ;;
    import)
      # Listed here, not left to -o default, which would offer files where set expects a secret.
      [[ ${COMP_CWORD} -eq 2 ]] && _reply_lines < <(compgen -f -- "${cur}")
      ;;
  esac
  return 0
}

_dcp_running_containers() { "${_DCP_DOCKER:-docker}" ps --format '{{.Names}}' 2>/dev/null; }

# Token under the cursor, treating ':' as part of the word so leading-colon
# and 'name:path' forms come through whole (bash splits on ':', zsh doesn't).
_dcp_realword()
{
  local line="${COMP_LINE}" point="${COMP_POINT}" start="${COMP_POINT}" ch
  while (( start > 0 )); do
    ch="${line:$((start - 1)):1}"
    [[ "$ch" == " " || "$ch" == $'\t' ]] && break
    start=$(( start - 1 ))
  done
  printf '%s' "${line:$start:$((point - start))}"
}

# Resolve the container to use: -c flag, $DCP_CONTAINER, cached pick, single
# running container, otherwise pop fzf to force a pick (cached per command
# line via a tempfile that the precmd hook clears).
_dcp_selected_container()
{
  local prev_w="" word
  for word in "${COMP_WORDS[@]}"; do
    if [[ "$prev_w" == "-c" ]]; then printf '%s' "$word"; return 0; fi
    prev_w="$word"
  done

  if [[ -n "${DCP_CONTAINER:-}" ]]; then
    printf '%s' "$DCP_CONTAINER"
    return 0
  fi

  local cache="/tmp/.dcp_picked_$$" cached=""
  [[ -r "$cache" ]] && read -r cached < "$cache"
  if [[ -n "$cached" ]] && "${_DCP_DOCKER:-docker}" inspect "$cached" >/dev/null 2>&1; then
    printf '%s' "$cached"
    return 0
  fi
  rm -f "$cache"

  local running line count=0 only=""
  running="$(_dcp_running_containers)"
  [[ -z "$running" ]] && return 1
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    count=$((count + 1)); only="$line"
  done <<< "$running"
  if [[ "$count" -eq 1 ]]; then printf '%s' "$only"; return 0; fi

  # Multi-container: force a pick. Set PATH inline so picker and its fzf/gum
  # subprocess inherit the real PATH (local PATH doesn't reach children).
  PATH="${_DCP_PATH:-$PATH}" command -v picker >/dev/null 2>&1 || return 1
  local choices selected picked rest
  choices=$("${_DCP_DOCKER:-docker}" ps --format '{{.Names}}\t{{.Image}}\t{{.Status}}' 2>/dev/null)
  selected=$(printf '%s\n' "$choices" | PATH="${_DCP_PATH:-$PATH}" picker --header "dcp: pick a container") || return 1
  [[ -z "$selected" ]] && return 1
  read -r picked rest <<< "$selected"
  printf '%s\n' "$picked" > "$cache"
  printf '%s' "$picked"
}

# List container-side entries matching path prefix $2 inside container $1.
# Directories are suffixed with '/'. Dot-entries (., ..) are skipped.
_dcp_container_list()
{
  "${_DCP_DOCKER:-docker}" exec "$1" sh -c '
    p="$1"
    [ -z "$p" ] && p="/"
    case "$p" in
      */)  dir="$p";       base="";;
      */*) dir="${p%/*}/"; base="${p##*/}";;
      *)   dir="";         base="$p";;
    esac
    cd_dir="${dir:-.}"
    [ -d "$cd_dir" ] || exit 0
    for e in "$cd_dir"/"${base}"*; do
      [ -e "$e" ] || continue
      name="${e##*/}"
      case "$name" in .|..) continue;; esac
      if [ -d "$e" ]; then
        printf "%s%s/\n" "$dir" "$name"
      else
        printf "%s%s\n" "$dir" "$name"
      fi
    done
  ' _ "$2" 2>/dev/null
}

_dcp()
{
  local PATH="${_DCP_PATH:-$PATH}"
  local cur prev realword
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  realword="$(_dcp_realword)"

  if [[ "$prev" == "-c" ]]; then
    COMPREPLY=($(compgen -W "$(_dcp_running_containers)" -- "$cur"))
    return 0
  fi

  if [[ "$cur" == -* ]]; then
    COMPREPLY=($(compgen -W "-c -f --force -n --no-clobber -h --help" -- "$cur"))
    return 0
  fi

  # Container-side path: leading ':' (auto/pick a container) or 'name:path'.
  if [[ "$realword" == *:* ]]; then
    local container path intended_prefix
    if [[ "$realword" == :* ]]; then
      container="$(_dcp_selected_container)" || return 0
      intended_prefix=":"
      path="${realword#:}"
    else
      container="${realword%%:*}"
      intended_prefix="${container}:"
      path="${realword#*:}"
    fi

    # Each candidate must start with cur so the shell's prefix filter accepts
    # it. cur differs by shell (bash splits on ':', zsh keeps it), so strip
    # whatever sits before cur in realword from the intended full path.
    local fixed="${realword%"$cur"}"
    local entries entry intended
    entries=$(_dcp_container_list "$container" "$path")
    while IFS= read -r entry; do
      [[ -z "$entry" ]] && continue
      intended="${intended_prefix}${entry}"
      COMPREPLY+=("${intended#"$fixed"}")
    done <<< "$entries"

    if [[ ${#COMPREPLY[@]} -eq 1 && "${COMPREPLY[0]}" == */ ]]; then
      compopt -o nospace 2>/dev/null
    fi
  fi
  # A host path is left to -o default.
}
_captions()
{
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  case "${prev}" in
    --model)
      [[ -z "${_CAPTIONS_MODELS}" ]] && _CAPTIONS_MODELS=$(captions --complete models 2>/dev/null | tr '\n' ' ')
      COMPREPLY=($(compgen -W "${_CAPTIONS_MODELS}" -- "${cur}")); return 0 ;;
    --lang)
      [[ -z "${_CAPTIONS_LANGS}" ]] && _CAPTIONS_LANGS=$(captions --complete langs 2>/dev/null | tr '\n' ' ')
      COMPREPLY=($(compgen -W "${_CAPTIONS_LANGS}" -- "${cur}")); return 0 ;;
    --alignment)
      [[ -z "${_CAPTIONS_ALIGN}" ]] && _CAPTIONS_ALIGN=$(captions --complete alignment 2>/dev/null | tr '\n' ' ')
      COMPREPLY=($(compgen -W "${_CAPTIONS_ALIGN}" -- "${cur}")); return 0 ;;
    --mode)
      [[ -z "${_CAPTIONS_MODES}" ]] && _CAPTIONS_MODES=$(captions --complete modes 2>/dev/null | tr '\n' ' ')
      COMPREPLY=($(compgen -W "${_CAPTIONS_MODES}" -- "${cur}")); return 0 ;;
    --font)
      [[ -z "${_CAPTIONS_FONTS}" ]] && _CAPTIONS_FONTS=$(captions --complete fonts 2>/dev/null | tr '\n' ' ')
      COMPREPLY=($(compgen -W "${_CAPTIONS_FONTS}" -- "${cur}")); return 0 ;;
    -o|--output|--highlight|--words|--gap|--scale|--position|--pop) return 0 ;;
  esac
  if [[ -z "${_CAPTIONS_OPTS_CACHE}" ]]; then
    _CAPTIONS_OPTS_CACHE=$(captions --help 2>/dev/null | grep -oE -- '(^|[[:space:],])-{1,2}[a-zA-Z][a-zA-Z0-9-]*' | tr -d ' ,' | sort -u | tr '\n' ' ')
  fi
  if [[ "${cur}" == -* ]]; then
    COMPREPLY=($(compgen -W "${_CAPTIONS_OPTS_CACHE}" -- "${cur}"))
  fi
}
_timemachine_opts()
{
  local sub cached
  sub="${1}"
  cached=$(printf '%s\n' "${_TIMEMACHINE_OPTS_CACHE}" | sed -n "s/^${sub}://p")
  if [[ -z "${cached}" ]]; then
    cached=$(timemachine "${sub}" --help 2>/dev/null | grep -oE -- '(^|[[:space:],])-{1,2}[a-zA-Z][a-zA-Z0-9-]*' | tr -d ' ,' | sort -u | tr '\n' ' ')
    _TIMEMACHINE_OPTS_CACHE="${_TIMEMACHINE_OPTS_CACHE}
${sub}:${cached}"
  fi
  printf '%s' "${cached}"
}
_timemachine()
{
  local cur prev sub
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  sub="${COMP_WORDS[1]}"
  if [[ "${COMP_CWORD}" -eq 1 ]]; then
    if [[ -z "${_TIMEMACHINE_COMMANDS}" ]]; then
      _TIMEMACHINE_COMMANDS=$(timemachine --help 2>/dev/null | sed -n 's/^ *{\(.*\)}$/\1/p' | tr ',' ' ')
    fi
    COMPREPLY=($(compgen -W "${_TIMEMACHINE_COMMANDS} --help" -- "${cur}"))
    return 0
  fi
  case "${prev}" in
    --keep|--format) return 0 ;;
  esac
  if [[ "${cur}" == -* ]]; then
    COMPREPLY=($(compgen -W "$(_timemachine_opts "${sub}")" -- "${cur}"))
    return 0
  fi
  case "${sub}" in
    prune|reset)
      if [[ -z "${_TIMEMACHINE_DESTINATIONS}" ]]; then
        _TIMEMACHINE_DESTINATIONS=$(timemachine --complete destinations 2>/dev/null)
      fi
      _reply_matching <<< "${_TIMEMACHINE_DESTINATIONS}" ;;
  esac
}
# Unregistered on purpose: git's bash completion and Homebrew's zsh _git call _git_wt, zsh's own _git calls _git-wt.
# shellcheck disable=SC2154
_git_wt()
{
  __gitcomp_nl "$(__git wt --complete "${words[@]:$((__git_cmd_idx + 1)):$((cword - __git_cmd_idx - 1))}")"
}
_git-wt()
{
  local -a candidates
  local candidate
  while IFS= read -r candidate; do
    candidates+=("${candidate}")
  done < <(git wt --complete "${words[@]:1:$((CURRENT - 2))}" 2>/dev/null)
  compadd -- "${candidates[@]}"
}
_reply_lines()
{
  local line
  while IFS= read -r line; do
    [[ -n "${line}" ]] && COMPREPLY+=("${line}")
  done
}
_help_parse()
{
  awk -v cmd="$1" '
    function remember(flag, choices) {
      if (!(flag in seen)) order[++count] = flag
      if (!(flag in seen) || choices != "") seen[flag] = choices
    }
    function scan(text,    flag, choices) {
      text = " " text
      while (match(text, /[ \t,(|[][-][-]?[A-Za-z][A-Za-z0-9_-]*/)) {
        flag = substr(text, RSTART + 1, RLENGTH - 1)
        text = substr(text, RSTART + RLENGTH)
        choices = ""
        if (match(text, /^[ =][{][^}]*[}]/)) {
          choices = substr(text, 3, RLENGTH - 3)
          gsub(/,/, " ", choices)
        }
        remember(flag, choices)
      }
    }
    {
      gsub(/\033\[[0-9;]*m/, "")
      if (match($0, /^[ \t]*[{][^}]*[}]/)) {
        group = substr($0, RSTART, RLENGTH)
        sub(/^[ \t]*[{]/, "", group)
        sub(/[}]$/, "", group)
        gsub(/,/, " ", group)
        remember("@", group)
      }
      if ($0 ~ /^[ \t]*-[-]?[A-Za-z]/) {
        spec = $0
        sub(/^[ \t]+/, "", spec)
        if (match(spec, /  |\t/)) spec = substr(spec, 1, RSTART - 1)
        scan(spec)
      }
      rest = $0
      while (match(rest, /[[][^]]*[]]/)) {
        group = substr(rest, RSTART + 1, RLENGTH - 2)
        rest = substr(rest, RSTART + RLENGTH)
        scan(group)
      }
    }
    END {
      print cmd "\t"
      for (i = 1; i <= count; i++) print cmd "\t" order[i] "\t" seen[order[i]]
    }'
}
_help_table()
{
  local key="$*"
  if ! printf '%s\n' "${_HELP_TABLE}" | awk -F'\t' -v c="${key}" '$1 == c { found = 1 } END { exit !found }'; then
    _HELP_TABLE="${_HELP_TABLE}
$("$@" --help </dev/null 2>&1 | _help_parse "${key}")"
  fi
}
_complete_help()
{
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" rows choices
  [[ $# -gt 0 ]] || set -- "${COMP_WORDS[0]}"
  _help_table "$@"
  rows=$(printf '%s\n' "${_HELP_TABLE}" | awk -F'\t' -v c="$*" '$1 == c && $2 != "" && $2 != "@"')
  choices=$(printf '%s\n' "${rows}" | awk -F'\t' -v f="${prev}" '$2 == f { print $3; exit }')
  if [[ -n "${choices}" ]]; then
    _reply_lines < <(compgen -W "${choices}" -- "${cur}")
    return 0
  fi
  [[ "${cur}" == -* ]] || return 1
  _reply_lines < <(compgen -W "$(printf '%s\n' "${rows}" | cut -f2)" -- "${cur}")
}
_complete_help_flags()
{
  COMPREPLY=()
  _complete_help
}
_complete_nothing()
{
  COMPREPLY=()
}
_reply_matching()
{
  # Compare without backslash escapes, so a typed name with spaces still matches.
  local cur="${COMP_WORDS[COMP_CWORD]//\\/}" line
  while IFS= read -r line; do
    [[ -n "${line}" && "${line}" == "${cur}"* ]] && COMPREPLY+=("${line}")
  done
}
_wleorun()
{
  COMPREPLY=()
  _complete_help leorun
}
_gretag()
{
  COMPREPLY=()
  [[ ${COMP_CWORD} -eq 1 ]] && _reply_matching < <(git tag -l 2>/dev/null)
}
_git_squash_commits_x_y()
{
  COMPREPLY=()
  case "${COMP_CWORD}" in
    1) _reply_matching < <(git for-each-ref --format='%(refname:lstrip=2)' refs/heads 2>/dev/null) ;;
    2|3) _reply_matching < <(git log --format=%h -n 50 "${COMP_WORDS[1]}" -- 2>/dev/null) ;;
  esac
}
_gunstage()
{

_gpg_key_emails()
{
  gpg "$1" --with-colons 2>/dev/null \
    | awk -F: '$1 == "uid" && match($10, /<[^>]+>/) { print substr($10, RSTART + 1, RLENGTH - 2) }' \
    | sort -u
}
_gpgpub()
{
  COMPREPLY=()
  [[ ${COMP_CWORD} -eq 1 ]] && _reply_matching < <(_gpg_key_emails --list-keys)
}
_gpgencrypt()
{
  COMPREPLY=()
  [[ ${COMP_CWORD} -eq 1 ]] && _reply_matching < <(_gpg_key_emails --list-keys)

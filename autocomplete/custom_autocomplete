_ssh_config_hosts()
{
  local config="${HOME}/.ssh/config" pattern file
  {
    cat "${config}"
    while IFS= read -r pattern; do
      pattern="${pattern/#\~/${HOME}}"
      [[ "${pattern}" == /* ]] || pattern="${HOME}/.ssh/${pattern}"
      for file in ${pattern}; do
        cat "${file}"
      done
    done < <(awk 'tolower($1) == "include" { for (i = 2; i <= NF; i++) print $i }' "${config}")
  } 2>/dev/null | awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i }' | sort -u
}
_docker_script()
{
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" i server="" container=""
  COMPREPLY=()
  for (( i = 1; i < COMP_CWORD; i++ )); do
    case "${COMP_WORDS[i]}" in
      -s|--server) server="${COMP_WORDS[i+1]}"; i=$((i + 1)) ;;
      -c) container="${COMP_WORDS[i+1]}"; i=$((i + 1)) ;;
      -*) ;;
      *) container="${COMP_WORDS[i]}" ;;
    esac
  done
  case "${prev}" in
    -s|--server) _reply_matching < <(_ssh_config_hosts); return 0 ;;
    -c) [[ -z "${server}" ]] && _reply_matching < <(_dcp_running_containers | sort); return 0 ;;
  esac
  if [[ "${cur}" == -* ]]; then
    _complete_help
    return 0
  fi
  [[ -n "${server}" ]] && return 0
  [[ -n "${container}" && "${COMP_WORDS[0]##*/}" != docker-inspect ]] && return 0
  _reply_matching < <(_dcp_running_containers | sort)
}
_complete_help_subcommands()
{
  local cmd="${COMP_WORDS[0]}" subcommands
  COMPREPLY=()
  _help_table "${cmd}"
  subcommands=$(printf '%s\n' "${_HELP_TABLE}" | awk -F'\t' -v c="${cmd}" '$1 == c && $2 == "@" { print $3 }')
  if [[ ${COMP_CWORD} -eq 1 ]]; then
    _complete_help || _reply_lines < <(compgen -W "${subcommands}" -- "${COMP_WORDS[1]}")
  elif [[ " ${subcommands} " == *" ${COMP_WORDS[1]} "* ]]; then
    _complete_help "${cmd}" "${COMP_WORDS[1]}"
  fi
}
_complete_script_words()
{
  COMPREPLY=()
  if [[ "${COMP_WORDS[COMP_CWORD]}" == -* ]]; then
    _complete_help
    return 0
  fi
  _reply_matching < <("${COMP_WORDS[0]}" --complete "${COMP_WORDS[@]:1:$((COMP_CWORD - 1))}" 2>/dev/null)
}
_audiomerge()
{
  COMPREPLY=()
  case "${COMP_WORDS[COMP_CWORD-1]}" in
    -f|--format) _complete_help audiotox ;;
    *) _complete_help ;;
  esac
}
_host_resolver()
{
  COMPREPLY=()
  _complete_help && return 0
  case "${COMP_WORDS[COMP_CWORD-1]}" in
    -t|--timeout|-f|--fallback-ip|-d|--dns) return 0 ;;
  esac
  [[ -z "${_HOST_RESOLVER_HOSTS}" ]] && _HOST_RESOLVER_HOSTS=$(host-resolver --complete hosts 2>/dev/null)
  _reply_matching <<< "${_HOST_RESOLVER_HOSTS}"
}
